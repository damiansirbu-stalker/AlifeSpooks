; as_static_map.ltx - the per-LEVEL category eligibility (the MAP filter in as_effect SELECT).
; [default] = the universal cues on every level (runtime-gated by presence/anomaly: mutant needs a
; mutant present, gunfire a human, drone an anomaly). Each [level] adds its terrain flavor, its
; interior/facility kinds, and the dark_signal lore placement. The director UNIONS [default] with
; [level.name()], then filters by enclosure (outdoor/indoor/underground), presence, and base.
; Level names are the engine level.name() values (game_levels.ltx). Curated per the terrain template
; and the dark_signal lore list (signal source: tech/military/psy/reactor/underground; silent in wild
; wetland/forest: k00_marsh, l04_darkvalley, l10_red_forest, y04_pole).

[default]
categories = spook, scream, mutant, drone, gunfire

; --- swamp / wetland ---
[k00_marsh]
categories = mutant_ambient_swamp, wind, wildlife, bats, structural

