--- as_mcm: MCM config for AlifeSpooks. Three systems (Spooks, Visuals, Development), mirrors at_mcm.

as_mcm = as_mcm or {}

if not xmcm then
    as_mcm.get_config = function() return nil end
    return
end

local defaults = {
    vol_global   = 1.0,
    rarity       = 1.0,
    visuals      = true,
    hud_position = "off",
    log_level    = "WARN", log_flush = false,
    sound_player = false,
}

local _key_to_tab = {
    vol_global = "spooks", rarity = "spooks",
    visuals = "visuals",
    hud_position = "development", log_level = "development", log_flush = "development",
    sound_player = "development", btn_reset_all = "development",
}

local function _build_mcm_path(key)
    return "as/" .. (_key_to_tab[key] or "spooks") .. "/" .. key
end

cfg, get_config, load_config = xmcm.create_config("as", defaults, _build_mcm_path)
as_mcm.get_config = get_config

--- Write every default to storage, save, reload, notify consumers, close the menu
local function _apply_defaults(gui, msg)
    local config = axr_main.config
    for k, v in pairs(defaults) do
        config:w_value("mcm", _build_mcm_path(k), v)
    end
    config:save()
    load_config()
    SendScriptCallback("mcm_option_restore_default")
    if gui then
        if gui.owner and gui.owner.SetMsg then gui.owner:SetMsg(msg, 5) end
        if gui.On_Cancel then gui:On_Cancel() end
    end
    if db.actor then
        news_manager.send_tip(db.actor, msg, nil, nil, 5000)
    end
end

function btn_reset_all(gui)
    _apply_defaults(gui, game.translate_string("st_as_reset_all_done"))
end

local GREY = {255, 200, 200, 200}

local function _title()
    return { id = "title", type = "slide", link = "as_mcm_banner",
             text = "ui_mcm_as_title", size = {512, 50}, spacing = 20 }
end

--- Spooks: one master volume for our sounds, plus the rarity feel knob. No per-category volume - the
--- director mixes every category off the single master, and placement is each sound's own vanilla band
--- (no distance knob).
local function spooks_page()
    return {
        id = "spooks", sh = true,
        gr = {
            _title(),
            { id = "desc", type = "desc", text = "ui_mcm_as_spooks_desc" },
            { id = "vol_global", type = "track", val = 2, min = 0.0, max = 5.0, step = 0.05, def = 1.0, hint = "as_vol_global" },

            { id = "div_feel", type = "line" },
            { id = "hdr_feel", type = "desc", text = "ui_mcm_as_hdr_feel", clr = GREY },
            { id = "rarity",   type = "track", val = 2, min = 0.5, max = 3.0, step = 0.05, def = 1.0, hint = "as_rarity" },

            -- Platform footer (self-contained builder in _as_deps, not xlibs), the family-standard verdict row.
            { id = "div_footer", type = "line" },
            { id = "platform", type = "desc", text = "ui_mcm_xmcm_footer",
              ui_hook_functor = { _as_deps.platform_functor() }, clr = {255, 212, 201, 168} },
        },
    }
end

--- Visuals: the subtle screen distortion at peak dread
local function visuals_page()
    return {
        id = "visuals", sh = true,
        gr = {
            _title(),
            { id = "desc", type = "desc", text = "ui_mcm_as_visuals_page_desc" },
            { id = "visuals", type = "check", val = 1, def = true, hint = "as_visuals" },
        },
    }
end

--- Development: trace log level, flush, the debug HUD, reset-to-defaults
local function development_page()
    return {
        id = "development", sh = true,
        gr = {
            _title(),
            { id = "dev_desc", type = "desc", text = "ui_mcm_as_development_desc" },

            { id = "div_logging", type = "line" },
            { id = "hdr_logging", type = "desc", text = "ui_mcm_as_hdr_logging", clr = GREY },
            { id = "log_level", type = "list", val = 0, def = "WARN", hint = "as_log_level", content = {
                {"ERROR", "error"}, {"WARN", "warn"}, {"INFO", "info"}, {"DEBUG", "debug"},
              } },
            { id = "log_flush", type = "check", val = 1, def = false, hint = "as_log_flush" },

            { id = "div_hud", type = "line" },
            { id = "hdr_hud", type = "desc", text = "ui_mcm_as_hud_hdr", clr = GREY },
            { id = "hud_position", type = "list", val = 0, def = "off", content = {
                {"off", "off"}, {"top_left", "topleft"}, {"top_right", "topright"},
                {"center_left", "centerleft"}, {"center_right", "centerright"},
                {"bottom_left", "bottomleft"}, {"bottom_right", "bottomright"},
              } },
            { id = "sound_player", type = "check", val = 1, def = false, hint = "as_sound_player" },

            { id = "div_reset", type = "line" },
            { id = "warn_reset", type = "desc", text = "ui_mcm_as_development_reset_warning", clr = {255, 240, 200, 80} },
            { id = "btn_reset_all", type = "button", functor_ui = { btn_reset_all } },
        },
    }
end

function on_mcm_load()
    return {
        id = "as",
        gr = {
            spooks_page(),
            visuals_page(),
            development_page(),
        },
    }
end
