--- _as_deps: AlifeSpooks dependency gate. xlibs is REQUIRED. The mod ships its sounds in its own
--- directories and plays them itself through xsound - there are no engine ambient channels for our
--- content - so without xlibs nothing plays. Hard assert on xlibs and a compatible version.

local assert = assert

local MOD_NAME          = "AlifeSpooks"
local XLIBS_MIN_VERSION = "1.5.1"
local XLIBS_URL         = "https://www.moddb.com/mods/stalker-anomaly/addons/xlibs-1001"

--- @return string Version string
function get_version()
    return "next"
end

function on_game_start()
    assert(xlibs and xlibs.is_compatible and xlibs.is_compatible(XLIBS_MIN_VERSION),
        "\n\n! [" .. MOD_NAME .. "] requires xlibs " .. XLIBS_MIN_VERSION .. " or newer.\n"..
        "! AlifeSpooks plays its sounds through xlibs (xsound); without it nothing plays.\n"..
        "! Install / update: " .. XLIBS_URL .. "\n")
end
