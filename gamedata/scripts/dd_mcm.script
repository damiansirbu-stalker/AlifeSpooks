--- dd_mcm: MCM config for DiegeticDread. Three systems (Spooks, Visuals, Development), mirrors at_mcm.

dd_mcm = dd_mcm or {}

if not xmcm then
    dd_mcm.get_config = function() return nil end
    return
end

local defaults = {
    vol_global   = 1.0,
    rarity       = 1.0,
    visuals      = true,
    hud_position = "off",
    log_level    = "WARN", log_flush = false,
    sound_player = false,
}

local _key_to_tab = {
    vol_global = "spooks", rarity = "spooks",
    visuals = "visuals",
    hud_position = "development", log_level = "development", log_flush = "development",
    sound_player = "development", btn_reset_all = "development",
}

local GREY = {255, 200, 200, 200}

local function _build_mcm_path(key)
    return "dd/" .. (_key_to_tab[key] or "spooks") .. "/" .. key
end

cfg, get_config, load_config = xmcm.create_config("dd", defaults, _build_mcm_path)
dd_mcm.get_config = get_config

--- Write every default to storage, save, reload, notify consumers, close the menu.
local function _apply_defaults(gui, msg)
    local config = axr_main.config
    for k, v in pairs(defaults) do
        config:w_value("mcm", _build_mcm_path(k), v)
    end
    config:save()
    load_config()
    SendScriptCallback("mcm_option_restore_default")
    if gui then
        if gui.owner and gui.owner.SetMsg then gui.owner:SetMsg(msg, 5) end
        if gui.On_Cancel then gui:On_Cancel() end
    end
    if db.actor then
        news_manager.send_tip(db.actor, msg, nil, nil, 5000)
    end
end

local function _build_title()
    return { id = "title", type = "slide", link = "dd_mcm_banner",
             text = "ui_mcm_dd_title", size = {512, 50}, spacing = 20 }
end

--- Spooks: master volume for our sounds plus the rarity feel knob; the director mixes every category off the master.
local function _build_spooks_page()
    return {
        id = "spooks", sh = true,
        gr = {
            _build_title(),
            { id = "desc", type = "desc", text = "ui_mcm_dd_spooks_desc" },
            { id = "vol_global", type = "track", val = 2, min = 0.0, max = 5.0, step = 0.05, def = 1.0, hint = "dd_vol_global" },

            { id = "div_feel", type = "line" },
            { id = "hdr_feel", type = "desc", text = "ui_mcm_dd_hdr_feel", clr = GREY },
            { id = "rarity",   type = "track", val = 2, min = 0.5, max = 3.0, step = 0.05, def = 1.0, hint = "dd_rarity" },

            { id = "div_footer", type = "line" },
            { id = "platform", type = "desc", text = "ui_mcm_xmcm_footer",
              ui_hook_functor = { _dd_init.get_platform_functor() }, clr = {255, 212, 201, 168} },
        },
    }
end

--- Visuals: the subtle screen distortion at peak dread.
local function _build_visuals_page()
    return {
        id = "visuals", sh = true,
        gr = {
            _build_title(),
            { id = "desc", type = "desc", text = "ui_mcm_dd_visuals_page_desc" },
            { id = "visuals", type = "check", val = 1, def = true, hint = "dd_visuals" },
        },
    }
end

--- Development: trace log level, flush, the debug HUD, reset-to-defaults.
local function _build_development_page()
    return {
        id = "development", sh = true,
        gr = {
            _build_title(),
            { id = "dev_desc", type = "desc", text = "ui_mcm_dd_development_desc" },

            { id = "div_logging", type = "line" },
            { id = "hdr_logging", type = "desc", text = "ui_mcm_dd_hdr_logging", clr = GREY },
            { id = "log_level", type = "list", val = 0, def = "WARN", hint = "dd_log_level", content = {
                {"ERROR", "error"}, {"WARN", "warn"}, {"INFO", "info"}, {"DEBUG", "debug"},
              } },
            { id = "log_flush", type = "check", val = 1, def = false, hint = "dd_log_flush" },

            { id = "div_hud", type = "line" },
            { id = "hdr_hud", type = "desc", text = "ui_mcm_dd_hud_hdr", clr = GREY },
            { id = "hud_position", type = "list", val = 0, def = "off", content = {
                {"off", "off"}, {"top_left", "topleft"}, {"top_right", "topright"},
                {"center_left", "centerleft"}, {"center_right", "centerright"},
                {"bottom_left", "bottomleft"}, {"bottom_right", "bottomright"},
              } },
            { id = "sound_player", type = "check", val = 1, def = false, hint = "dd_sound_player" },

            { id = "div_reset", type = "line" },
            { id = "warn_reset", type = "desc", text = "ui_mcm_dd_development_reset_warning", clr = {255, 240, 200, 80} },
            { id = "btn_reset_all", type = "button", functor_ui = { btn_reset_all } },
        },
    }
end

function btn_reset_all(gui)
    _apply_defaults(gui, game.translate_string("st_dd_reset_all_done"))
end

function on_mcm_load()
    return {
        id = "dd",
        gr = {
            _build_spooks_page(),
            _build_visuals_page(),
            _build_development_page(),
        },
    }
end
