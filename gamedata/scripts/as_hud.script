--- as_hud: live debug HUD - the AlifeSpooks spook readout (grade/score, place, what's playing, each
--- term's contribution, gates) from as_director.get_hud_rows(), laid out on a fixed two-column grid
--- (label | value) so everything aligns by construction. Mirrors at_hud: a CUIScriptWnd built once
--- and shown via AddDialogToRender, a self-rearming, visibility-gated refresh, position from the MCM
--- hud_position preset. Off by default; players never see it. Inert without xmcm or as_director.

local RegisterScriptCallback, math_floor = RegisterScriptCallback, math.floor

local REFRESH_SEC = 0.5
local MARGIN   = 15
local PAD      = 6
-- ROW_H matches at_hud (letterica16); CHAR_W is that font's approximate pixel advance.
local ROW_H    = 13
local COL_GAP  = 8
local CHAR_W   = 6
local CELL_PAD = 2
local MAX_ROWS = 26

-- Fixed-char column widths: factor | state | spook. Three cells per row at fixed x, aligned by column.
local COL1_W = 12 * CHAR_W + CELL_PAD
local COL2_W = 16 * CHAR_W + CELL_PAD
local COL3_W = 8  * CHAR_W + CELL_PAD
local PANEL_W = COL1_W + COL_GAP + COL2_W + COL_GAP + COL3_W + PAD * 2
local PANEL_H = MAX_ROWS * ROW_H + PAD * 2

-- Row text colors, built lazily: GetARGB is not present at module-load under the static validator
-- (same as at_hud). Neutral off-white body, gold section headers, green/gray for the live/stopped sound
-- lines, and a green->red gradient tinting the DREAD summary row by its grade. Applied per row each
-- refresh so color tracks state, not grid position. Moderate saturation + high luminance to stay legible
-- over dark, busy scenes; the sound lines use luminance (bright vs dim), so play/stop reads colorblind-safe.
local _clr
local function _row_color(style)
    if not _clr then
        _clr = {
            hdr      = GetARGB(255, 235, 200, 120),   -- section header, warm gold
            norm     = GetARGB(235, 210, 205, 195),   -- body label/value, warm off-white
            play     = GetARGB(255, 130, 225, 150),   -- sound line, live (green)
            stop     = GetARGB(190, 135, 135, 135),   -- sound line, stopped (dim gray)
            g_none   = GetARGB(210, 150, 150, 150),   -- DREAD grade: none (gray)
            g_low    = GetARGB(255, 130, 220, 140),   --             low (green)
            g_med    = GetARGB(255, 230, 215, 120),   --             med (yellow)
            g_high   = GetARGB(255, 240, 165,  90),   --             high (orange)
            g_insane = GetARGB(255, 235, 105,  95),   --             insane (red)
        }
    end
    return _clr[style] or _clr.norm
end

local function _pos_key()
    return (as_mcm and as_mcm.get_config and as_mcm.get_config("hud_position")) or "off"
end

local function _calc_position(key)
    local right = 1024 - PANEL_W - MARGIN
    local bottom = 768 - PANEL_H - MARGIN
    local middle = math_floor((768 - PANEL_H) / 2)
    local presets = {
        top_left     = { MARGIN, MARGIN },
        top_right    = { right,  MARGIN },
        center_left  = { MARGIN, middle },
        center_right = { right,  middle },
        bottom_left  = { MARGIN, bottom },
        bottom_right = { right,  bottom },
    }
    return presets[key] or presets.top_left
end

-- =========================================================================
-- UISpookHUD: a three-column grid (factor | state | spook) built once; refresh only rewrites text.
-- =========================================================================

class "UISpookHUD" (CUIScriptWnd)

function UISpookHUD:_cell(xml, elem, cell_x, cell_y, cell_w)
    local static = xml:InitStatic(elem, self)
    static:SetWndPos(vector2():set(cell_x, cell_y))
    static:SetWndSize(vector2():set(cell_w, ROW_H))
    return static:TextControl()
end

function UISpookHUD:__init() super()
    self:SetAutoDelete(true)
    local pos = _calc_position(_pos_key())
    self:SetWndPos(vector2():set(pos[1], pos[2]))
    self:SetWndSize(vector2():set(PANEL_W, PANEL_H))
    local xml = CScriptXmlInit()
    xml:ParseFile("ui_as_stats.xml")
    self.c1, self.c2, self.c3 = {}, {}, {}
    local x1 = PAD
    local x2 = x1 + COL1_W + COL_GAP
    local x3 = x2 + COL2_W + COL_GAP
    for row = 1, MAX_ROWS do
        local row_y = PAD + (row - 1) * ROW_H
        self.c1[row] = self:_cell(xml, "line", x1, row_y, COL1_W)
        self.c2[row] = self:_cell(xml, "line", x2, row_y, COL2_W)
        self.c3[row] = self:_cell(xml, "line", x3, row_y, COL3_W)
    end
    self.used = 0
end

--- Rewrite each row's three cells (factor | state | spook); blank only what the previous refresh used.
function UISpookHUD:set_rows(rows)
    local count = #rows
    if count > MAX_ROWS then count = MAX_ROWS end
    for row = 1, count do
        local r = rows[row]
        local clr = _row_color(r[4])
        self.c1[row]:SetText(r[1] or ""); self.c1[row]:SetTextColor(clr)
        self.c2[row]:SetText(r[2] or ""); self.c2[row]:SetTextColor(clr)
        self.c3[row]:SetText(r[3] or ""); self.c3[row]:SetTextColor(clr)
    end
    for row = count + 1, self.used do
        self.c1[row]:SetText(""); self.c2[row]:SetText(""); self.c3[row]:SetText("")
    end
    self.used = count
end

function UISpookHUD:__finalize() end

-- =========================================================================
-- Lifecycle: visibility-gated refresh (REFRESH_SEC) via a self-rearming event
-- =========================================================================

local _hud, _shown, _active = nil, false, false

-- DIAGNOSTIC trace: logs to alifespooks.log via as_debug (tag [AS]) when tracing is on. Prefix [HUD].
local function _tr(fmt, ...)
    if as_debug and as_debug.on and as_debug.on() then as_debug.dbg("[HUD] " .. fmt, ...) end
end

local function _wanted()
    return _pos_key() ~= "off"
end

local function _hide()
    if _hud and _shown then get_hud():RemoveDialogToRender(_hud); _shown = false end
end

--- Drop the window entirely (position change, actor teardown); the next refresh rebuilds it.
local function _drop()
    _hide(); _hud = nil
end

local function _is_visible()
    if not main_hud_shown() then return false end
    local pda = ActorMenu and ActorMenu.get_pda_menu and ActorMenu.get_pda_menu()
    return not (pda and pda:IsShown())
end

local function _refresh()
    if not _wanted() then _tr("_refresh: not wanted, skip"); return end
    if not _hud then _hud = UISpookHUD(); _tr("_refresh: built UISpookHUD") end
    if not _shown then get_hud():AddDialogToRender(_hud); _shown = true; _tr("_refresh: AddDialogToRender, shown=true") end
    local rows = (as_director and as_director.get_hud_rows and as_director.get_hud_rows()) or {}
    _tr("_refresh: rows=%d hud=%s shown=%s", #rows, tostring(_hud ~= nil), tostring(_shown))
    _hud:set_rows(rows)
end

--- Re-arm FIRST: an expired event that errored would re-fire every frame and starve all time events.
local function _tick()
    if not _active then _tr("_tick: not active, hide"); _hide(); return true end
    ResetTimeEvent("as_hud", "tick", REFRESH_SEC)
    local vis = _is_visible()
    _tr("_tick: active=%s visible=%s main_hud=%s", tostring(_active), tostring(vis), tostring(main_hud_shown()))
    if vis then _refresh() else _hide() end
    return false
end

local function _start()
    if _active then _tr("_start: already active"); return end
    _active = true
    RemoveTimeEvent("as_hud", "tick")
    CreateTimeEvent("as_hud", "tick", REFRESH_SEC, _tick)
    _tr("_start: armed tick")
end

local function _stop()
    _active = false
    RemoveTimeEvent("as_hud", "tick")
    _drop()
    _tr("_stop")
end

--- Position preset changed or actor (re)spawned: rebuild and (dis)arm to match the current setting.
local function _apply()
    _tr("_apply: wanted=%s pos=%s", tostring(_wanted()), tostring(_pos_key()))
    _drop()
    if _wanted() then _start() else _stop() end
end

function on_game_start()
    _tr("on_game_start: registering callbacks")
    RegisterScriptCallback("actor_on_first_update",      _apply)
    RegisterScriptCallback("actor_on_net_destroy",       _stop)
    RegisterScriptCallback("on_option_change",           _apply)
    RegisterScriptCallback("mcm_option_restore_default", _apply)
end
