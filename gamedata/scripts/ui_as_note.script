--- ui_as_note: the dev NOTE TAKER. A standalone keyboard-owning popup (CUIScriptWnd) opened by INSERT when
--- the MCM note_taker toggle is on. Typing works because the window owns the keyboard AND the edit box
--- CaptureFocus(true)s it - a PDA subdialog cannot capture keyboard, its keys fall through to game binds. On
--- save it logs the note + level + coordinate through as_test.snapshot (probe log), ready to paste into a
--- per-map override. Reuses the vanilla backpack dialog layout (ui_items_backpack.xml) and the proven
--- note-box pattern (restored from git 99b93d32). Decoupled from the PDA sound player.

local INSERT_KEY = 210
local _box = nil

class "as_note_wnd" (CUIScriptWnd)

function as_note_wnd:__init() super()
    self:SetWndRect(Frect():set(0, 0, 1024, 768))
    self:SetAutoDelete(true)
    local xml = CScriptXmlInit()
    xml:ParseFile("ui_items_backpack.xml")
    self.dialog = xml:InitStatic("backpack", self)
    xml:InitStatic("backpack:background", self.dialog)
    self.input = xml:InitEditBox("backpack:input", self.dialog)
    self:Register(self.input, "fld_input")
    local ok = xml:Init3tButton("backpack:btn_ok", self.dialog)
    self:Register(ok, "btn_ok")
    local cancel = xml:Init3tButton("backpack:btn_cancel", self.dialog)
    self:Register(cancel, "btn_cancel")
    self:AddCallback("btn_ok", ui_events.BUTTON_CLICKED, self.OnAccept, self)
    self:AddCallback("btn_cancel", ui_events.BUTTON_CLICKED, self.OnClose, self)
    self.input:SetText("")
    self.input:CaptureFocus(true)
end

function as_note_wnd:__finalize() end

function as_note_wnd:OnAccept()
    if self._done then return end
    self._done = true
    local txt = self.input:GetText()
    self:OnClose()
    local note = (txt and txt ~= "") and txt or "no-note"
    if as_test and as_test.snapshot then as_test.snapshot(note) end
end

function as_note_wnd:OnClose()
    self:HideDialog()
    Unregister_UI("as_note_wnd")
end

function as_note_wnd:OnKeyboard(dik, action)
    local res = CUIScriptWnd.OnKeyboard(self, dik, action)
    if action ~= ui_events.WINDOW_KEY_PRESSED then return res end
    if dik == DIK_keys.DIK_ESCAPE then self:OnClose() end
    if dik == DIK_keys.DIK_RETURN then self:OnAccept() end
    return res
end

--- Open the note popup, gated on the MCM note_taker toggle. Opened directly on the key (the proven path);
--- a standalone dialog does not hit the PDA-slot re-entry hazard that forced the old PDA open to defer.
local function _open_note_box()
    if _box and _box:IsShown() then return end
    if not (db.actor and as_mcm and as_mcm.get_config and as_mcm.get_config("note_taker")) then return end
    _box = as_note_wnd()
    _box:ShowDialog(true)
    Register_UI("as_note_wnd", "ui_as_note", _box)
end

local function _on_key(key)
    if key == INSERT_KEY then _open_note_box() end
end

function on_game_start()
    RegisterScriptCallback("on_key_press", _on_key)
end
