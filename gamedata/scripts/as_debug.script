--- as_debug: trace primitives for AlifeSpooks. One logger, one gate, refreshed from MCM.

as_debug = as_debug or {}

if not xlog then
    function as_debug.refresh() end
    function as_debug.on() return false end
    function as_debug.dbg() end
    function as_debug.info() end
    function as_debug.warn() end
    function as_debug.flush() end
    function as_debug.show(v) return v ~= nil and tostring(v) or "?" end
    return
end

local tostring, RegisterScriptCallback = tostring, RegisterScriptCallback
local log = xlog.get_logger("AS", { outfile = "alifespooks.log" })
local DEBUG_LEVEL = 5
local _lvl = 0
local _levels = xlog.get_levels()

--- Re-read the log level and flush setting from MCM
function as_debug.refresh()
    log.set_level(as_mcm.get_config("log_level") or "WARN")
    _lvl = log.get_level() or 0
    log._logger.flush_on_level = as_mcm.get_config("log_flush") and _levels.TRACE or _levels.ERROR
end

--- True when DEBUG tracing is live
function as_debug.on()
    return _lvl >= DEBUG_LEVEL
end

--- Log a DEBUG line; noop below DEBUG
function as_debug.dbg(template, ...)
    if _lvl >= DEBUG_LEVEL then log.debug(template, ...) end
end

function as_debug.info(template, ...)
    log.info(template, ...)
end

function as_debug.warn(template, ...)
    log.warn(template, ...)
end

function as_debug.flush()
    log.flush()
end

--- A value, or "?" when nil
function as_debug.show(v)
    return v ~= nil and tostring(v) or "?"
end

function on_game_start()
    RegisterScriptCallback("actor_on_first_update",      as_debug.refresh)
    RegisterScriptCallback("on_option_change",           as_debug.refresh)
    RegisterScriptCallback("mcm_option_restore_default", as_debug.refresh)
end
