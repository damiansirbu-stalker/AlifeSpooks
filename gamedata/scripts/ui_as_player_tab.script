--- ui_as_player_tab: AlifeSpooks dev PDA tab (Player). Browses zs/<category>/ off disk (lazy-cached per
--- category), plays each sound through the director's own emit at at-ear / a literal distance / the exact
--- director curve, and flags suspects to alifespooks_probe.log. Returned by pda.set_active_subdialog.

local table_sort = table.sort
local string_format, bit_or = string.format, bit_or
local RegisterScriptCallback = RegisterScriptCallback

local SND_ROOT    = "zs"
-- position modes cycled by the distance steppers: false = 2D at-ear (raw quality check), "auto" = the
-- director's exact emit (min/max from as_manifest), a number = a literal 3D distance in metres.
local DIST_STEPS  = { false, "auto", 5, 10, 25, 50, 100 }

local _cats    = nil
local _files   = {}
local _cat_i   = 1
local _at_root = true
local _dist_i  = 1
local _flags   = 0
local _cur     = nil
local _built   = false   -- has THIS window's list been filled once? RemoveAll on the empty, not-yet-attached
                         -- list (the first fill, before the PDA renders) CTDs in CUIScrollView::Clear.

local function _cur_cat()   return _cats and _cats[_cat_i] end
local function _cur_dist()  return DIST_STEPS[_dist_i] end

-- ---- disk enumeration (lazy per category) ---------------------------------

local function _scan_categories()
    _cats = {}
    local fl = getFS():file_list_open("$game_sounds$", SND_ROOT .. "\\", bit_or(FS.FS_ListFolders, FS.FS_RootOnly))
    for i = 1, (fl and fl:Size() or 0) do
        local name = fl:GetAt(i - 1):gsub("[\\/]", "")
        if name ~= "" and name ~= "." and name ~= ".." then _cats[#_cats + 1] = name end
    end
    table_sort(_cats)
end

local function _scan_files(cat)
    if _files[cat] then return _files[cat] end
    local out = {}
    local fl = getFS():file_list_open("$game_sounds$", SND_ROOT .. "\\" .. cat .. "\\", bit_or(FS.FS_ListFiles, FS.FS_RootOnly))
    for i = 1, (fl and fl:Size() or 0) do
        local fname = fl:GetAt(i - 1)
        if fname:sub(-4) == ".ogg" then out[#out + 1] = fname:sub(1, -5) end
    end
    table_sort(out)
    _files[cat] = out
    return out
end

-- ---- the tab --------------------------------------------------------------

local SINGLETON = nil

--- Return the tab and schedule its list build through a game TimeEvent that WAITS until the PDA is actually
--- shown before filling. get_ui runs during SetActiveSubdialog, when the list box is not on screen yet, and
--- with the 3D PDA the open plays a draw animation lasting several frames; filling the list before it is on
--- screen hits a detached list and CTDs in CUIScrollView::Clear. Returning false keeps the TimeEvent alive
--- so it retries each tick until IsShown(), then fills once. This is the working dynamic-tab pattern - PDA
--- Taskboard's reset_taskboard defers its render through a TimeEvent the same way.
function get_ui()
    SINGLETON = SINGLETON or as_player_tab()
    CreateTimeEvent("as_player_reload", "as_player_reload", 0, function()
        if not SINGLETON then return true end
        local menu = ActorMenu.get_pda_menu()
        if not (menu and menu:IsShown()) then return false end   -- PDA not on screen yet: wait, do not fill
        SINGLETON:Reload()
        return true
    end)
    return SINGLETON
end

class "as_player_tab" (CUIScriptWnd)

function as_player_tab:__init() super()
    -- NO SetAutoDelete: get_ui caches this window in SINGLETON, so it must OUTLIVE a tab switch / PDA close.
    -- With SetAutoDelete(true) the engine freed it on removal while SINGLETON kept the dangling pointer, and
    -- the next open handed that freed window back to the PDA -> hard CTD in CUIStatic::Update (UIStatic.cpp:166,
    -- updating a child of a freed window). The radio/taskboard tabs cache their window the same way, un-deleted.
    self:InitControls()
    self:InitCallbacks()
    _built = false                    -- fresh window: its list is empty, so skip the first RemoveAll
end

--- Rebuild the list + readout. Scheduled from get_ui through a TimeEvent that waits for the PDA to be shown,
--- so the list box is on screen when FillList touches it; running it before that hit a detached list and
--- CTD'd in CUIScrollView::Clear. Navigation rebuilds (button clicks) are already safe - the tab is shown then.
function as_player_tab:Reload()
    if not _cats then _scan_categories() end
    self:FillList()
    self:Refresh()
end

function as_player_tab:__finalize()
    SINGLETON = nil
end

function as_player_tab:InitControls()
    self:SetWndRect(Frect():set(0, 0, 1024, 768))
    local xml = CScriptXmlInit()
    xml:ParseFile("ui_as_player.xml")
    xml:InitStatic("background", self)
    xml:InitStatic("hdr_player", self)
    xml:InitStatic("line_player", self)
    xml:InitStatic("cap_mute", self)
    xml:InitStatic("screen", self)
    xml:InitStatic("hdr_insp", self)
    xml:InitStatic("line_insp", self)
    xml:InitFrame("insp_frame", self)
    xml:InitFrame("list_frame", self)
    self.list = xml:InitListBox("list", self)
    self.list:ShowSelectedItem(true)
    self:Register(self.list, "list")
    self.lbl_path  = xml:InitStatic("lbl_path", self):TextControl()
    self.lbl_now   = xml:InitStatic("lbl_now", self):TextControl()
    self.lbl_pos   = xml:InitStatic("lbl_pos", self):TextControl()
    self.status    = xml:InitStatic("status", self):TextControl()
    self.insp_read = xml:InitStatic("insp_read", self):TextControl()
    self.insp_note = xml:InitEditBox("insp_note", self)
    self.chk_mute  = xml:InitCheck("chk_mute", self); self:Register(self.chk_mute, "chk_mute")
    local function reg(name) local btn = xml:Init3tButton(name, self); self:Register(btn, name) end
    reg("btn_pos_down"); reg("btn_pos_up"); reg("btn_prior"); reg("btn_play"); reg("btn_next")
    reg("btn_flag"); reg("btn_rescan"); reg("btn_beacon"); reg("btn_snapshot")
end

function as_player_tab:InitCallbacks()
    self:AddCallback("list",         ui_events.LIST_ITEM_CLICKED,  self.OnPlay,     self)
    self:AddCallback("chk_mute",     ui_events.BUTTON_CLICKED,     self.OnMute,     self)
    self:AddCallback("btn_pos_down", ui_events.BUTTON_CLICKED,     self.OnPosNear,  self)
    self:AddCallback("btn_pos_up",   ui_events.BUTTON_CLICKED,     self.OnPosFar,   self)
    self:AddCallback("btn_prior",    ui_events.BUTTON_CLICKED,     self.OnPriorSound, self)
    self:AddCallback("btn_play",     ui_events.BUTTON_CLICKED,     self.OnReplay,   self)
    self:AddCallback("btn_next",     ui_events.BUTTON_CLICKED,     self.OnNextSound, self)
    self:AddCallback("btn_flag",     ui_events.BUTTON_CLICKED,     self.OnFlag,     self)
    self:AddCallback("btn_rescan",   ui_events.BUTTON_CLICKED,     self.OnRescan,   self)
    self:AddCallback("btn_beacon",   ui_events.BUTTON_CLICKED,     self.OnBeacon,   self)
    self:AddCallback("btn_snapshot", ui_events.BUTTON_CLICKED,     self.OnSnapshot, self)
end

function as_player_tab:FillList()
    if xslice then xslice.cancel("as_player_fill") end
    if _built then self.list:RemoveAll() end   -- only clear a list that was already filled (attached); the
    _built = true                              -- empty first fill must NOT RemoveAll (detached -> CTD)
    if _at_root then
        for i = 1, #(_cats or {}) do self.list:AddTextItem(_cats[i] .. "/") end
    else
        self:_fill_category(_cur_cat())
    end
end

--- Fill the list with one category's sounds: a ".." row (list index 0) then each sound with its duration.
--- Frame-spread the duration read - xsound.length builds a sound_object per file, too heavy at once - so
--- files[i] lands at list index i and selection maps directly.
function as_player_tab:_fill_category(cat)
    if not cat then return end
    self.list:AddTextItem("..")
    local files = _scan_files(cat)
    local list, root = self.list, SND_ROOT .. "\\" .. cat .. "\\"
    if not xslice then
        for i = 1, #files do list:AddTextItem(files[i]) end
        return
    end
    xslice.start("as_player_fill", files, { step = 15, func = function(name)
        local ms = (xsound and xsound.length and xsound.length(root .. name)) or 0
        list:AddTextItem(string_format("%s    %.1fs", name, ms / 1000))
        return true
    end })
end

function as_player_tab:Refresh()
    self:_refresh_browser()
    self:_refresh_state()
    self:_refresh_params()
    if self.insp_read then self.insp_read:SetText(self:_read_spot()) end
end

--- Left pane: the breadcrumb (path with the files) and the context hint in the status bar.
function as_player_tab:_refresh_browser()
    local cat = _cur_cat()
    if _at_root then
        self.lbl_path:SetText(string_format("sounds/    (%d categories)", _cats and #_cats or 0))
        self.status:SetText(string_format("flagged: %d    |    click a category to browse it", _flags))
    else
        self.lbl_path:SetText(string_format("sounds/%s/    (%d)", cat or "?", cat and #_scan_files(cat) or 0))
        self.status:SetText(string_format("flagged: %d    |    click a sound to play    -    '..' goes up", _flags))
    end
end

--- The player screen: the loaded sound line, plus the checkbox synced to the director's live mute state.
function as_player_tab:_refresh_state()
    self.lbl_now:SetText(_cur and ("loaded:  " .. _cur.cat .. "/" .. _cur.name) or "loaded:  (none - click a sound)")
    local muted = as_director and as_director.is_muted and as_director.is_muted()
    self.chk_mute:SetCheck(muted and true or false)
end

--- The player screen's position line: the current play mode (value only; the screen names it).
function as_player_tab:_refresh_params()
    local dist = _cur_dist()
    local dtext = (dist == false) and "at-ear (2D)" or (dist == "auto") and "director-exact" or (dist .. "m")
    self.lbl_pos:SetText("position:  " .. dtext)
end

function as_player_tab:_play_current()
    if not (_cur and xsound) then return end
    local dist = _cur_dist()
    if dist == false then
        xsound.play(_cur.path, { volume = 1.0 })
    elseif dist == "auto" then
        -- n124 names are <name>_<hash>, not a numeric index, so find the manifest row by its path.
        local list = as_manifest and as_manifest.categories and as_manifest.categories[_cur.cat]
        local entry
        if list then
            for k = 1, #list do if list[k][1] == _cur.path then entry = list[k]; break end end
        end
        as_director.emit(_cur.path, { min = entry and entry[2] or 2, max = entry and entry[3] or 100,
            height = entry and entry[4] or 0 })
    else
        as_director.emit(_cur.path, { dist = dist })
    end
end

function as_player_tab:OnPlay()
    local idx = self.list:GetSelectedIndex()
    if not idx or idx < 0 then return end
    if _at_root then
        if not (_cats and _cats[idx + 1]) then return end
        _cat_i, _at_root = idx + 1, false
        self:FillList(); self:Refresh()
        return
    end
    if idx == 0 then
        _at_root = true
        self:FillList(); self:Refresh()
        return
    end
    local cat = _cur_cat()
    if not cat then return end
    local name = _scan_files(cat)[idx]
    if not name then return end
    _cur = { cat = cat, name = name, path = SND_ROOT .. "\\" .. cat .. "\\" .. name }
    self:_play_current()
    self:_refresh_state()
    self.status:SetText(string_format("playing:  %s\\%s", cat, name))
end

function as_player_tab:OnReplay()
    self:_play_current()
end

--- Master silence checkbox: mute the running director (its one-shots + the base-ambient replay) so a
--- clicked sound auditions alone. The tab's own play path is unaffected - only automatic emission is cut.
function as_player_tab:OnMute()
    if as_director and as_director.set_muted then
        as_director.set_muted(self.chk_mute:GetCheck())
    end
end

--- Position steppers: nearer walks toward at-ear, farther toward 100 m (both wrap), then re-auditions.
function as_player_tab:OnPosNear()
    _dist_i = _dist_i - 1
    if _dist_i < 1 then _dist_i = #DIST_STEPS end
    self:Refresh(); self:_play_current()
end

function as_player_tab:OnPosFar()
    _dist_i = _dist_i % #DIST_STEPS + 1
    self:Refresh(); self:_play_current()
end

--- Transport prev/next: step to the neighbouring sound in the current category and audition it.
function as_player_tab:_step_sound(delta)
    if _at_root then return end
    local cat = _cur_cat()
    local files = cat and _scan_files(cat)
    if not (files and #files > 0) then return end
    local i = 1
    if _cur and _cur.cat == cat then
        for k = 1, #files do if files[k] == _cur.name then i = k; break end end
    end
    i = (i - 1 + delta) % #files + 1
    local name = files[i]
    _cur = { cat = cat, name = name, path = SND_ROOT .. "\\" .. cat .. "\\" .. name }
    self.list:SetSelectedIndex(i)
    self:_play_current()
    self:_refresh_state()
    self.status:SetText(string_format("playing:  %s\\%s", cat, name))
end

function as_player_tab:OnPriorSound() self:_step_sound(-1) end
function as_player_tab:OnNextSound() self:_step_sound(1) end

function as_player_tab:OnFlag()
    if not _cur then return end
    if xlog then
        local log = xlog.get_logger("AS_PROBE", { outfile = "alifespooks_probe.log", buffer_size = 1 })
        log.info("SUSPECT\t%s\t%s", _cur.cat, _cur.path)
        log.flush()
    end
    _flags = _flags + 1
    self.status:SetText(string_format("FLAGGED  %s\\%s  (total %d)", _cur.cat, _cur.name, _flags))
end

function as_player_tab:OnRescan()
    _cats, _files = nil, {}
    _scan_categories()
    if _cat_i > #_cats then _cat_i = 1 end
    self:FillList(); self:Refresh()
end

-- ---- inspector (spot readout + n114 beacon) -------------------------------

function as_player_tab:_read_spot()
    local actor = db.actor
    if not actor then return "no actor" end
    local pos = actor:position()
    local board = as_director and as_director.get_board and as_director.get_board()
    local dread = board and board.dread or 0
    local env = board and board.environment or "?"
    return string_format("%s    dread %.2f    env %s    pos %.0f %.0f %.0f",
        level.name(), dread, env, pos.x, pos.y, pos.z)
end

function as_player_tab:OnBeacon()
    local actor = db.actor
    if not actor then return end
    local pos = actor:position()
    local note = self.insp_note and self.insp_note:GetText()
    note = (note and note ~= "") and note or "no-note"
    local board = as_director and as_director.get_board and as_director.get_board()
    if xlog then
        local log = xlog.get_logger("AS_PROBE", { outfile = "alifespooks_probe.log", buffer_size = 1 })
        log.info("BEACON\tname=%s\tlevel=%s\tpos=%.1f,%.1f,%.1f\tradius=60\tdread=%.2f",
            note, level.name(), pos.x, pos.y, pos.z, board and board.dread or 0.5)
        log.flush()
    end
    self.status:SetText(string_format("BEACON  %s  @ %s", note, level.name()))
end

function as_player_tab:OnSnapshot()
    if as_test and as_test.snapshot then as_test.snapshot(self.insp_note and self.insp_note:GetText()) end
    self.status:SetText("full snapshot -> alifespooks_probe.log")
end

-- The list build is scheduled in get_ui through a TimeEvent that waits for the PDA to be shown (above). No
-- global actor_on_update and no Update() hook: those ran the build while the 3D PDA was still drawing, before
-- the list was on screen, and CTD'd in CUIScrollView::Clear.
