--- as_effect: additive spook director. Reads a place-driven spook score from cheap engine-native
--- signals, sorts it into a five-step ladder, and fires curated spook one-shots through xsound.play
--- only when a place is genuinely unsettling -- denser, closer, louder as the score climbs. Purely
--- additive over the base soundscape: owns no channels, never touches update_ambient, plays no
--- weather/nature. Place is the base; safety (allied base, allied company, sunny) carves it back.

local math_random, math_rad = math.random, math.rad
local math_cos, math_sin = math.cos, math.sin
local math_max, math_min, math_floor = math.max, math.min, math.floor
local ini_file, parse_list = ini_file, parse_list
local time_global, vector = time_global, vector
local table_remove, string_format, RegisterScriptCallback = table.remove, string.format, RegisterScriptCallback
local pairs, tostring, next, ipairs = pairs, tostring, next, ipairs

local LORE_FILE       = "scripts\\as_smart_lore.ltx"
local CHANNELS_FILE   = "environment\\sound_channels.ltx"
local SEC_SMART_CLASS = "smart_class"
local SEC_LEVEL       = "level_default"
local NO_SOUND        = "ambient\\no_sound"

-- =========================================================================
-- Categories: the fixed palette. Deployed channel names (DLTX-merged sound_channels.ltx),
-- a firing gate, spook(rises with score) vs texture(rises with calm), a base weight, and a
-- per-category minimum interval so screams stay rare against drone density. Whisper content
-- rides out_spooks (pipeline routing). Per-channel distance/height come from the LTX at init.
-- gates: always | mutants (real mutant on level/online) | enclosed (is_indoor)
-- =========================================================================
local CATEGORIES = {
    { name = "drone",       gate = "always",   spook = false, weight = 1.0, floor = 12000,
      channels = { "as_dark_signal", "as_out_dark_amb", "as_out_night_amb" } },
    { name = "spook",       gate = "always",   spook = true,  weight = 1.0, floor = 8000,
      channels = { "as_out_spooks", "as_out_day_spoops", "as_out_night_spoops",
                   "as_urban_spoops_night", "as_crows_spook", "as_foliage_spook" } },
    { name = "scream",      gate = "always",   spook = true,  weight = 0.5, floor = 90000,
      channels = { "as_out_screams" } },
    { name = "growl",       gate = "mutants",  spook = true,  weight = 1.0, floor = 60000,
      channels = { "as_out_mutants" } },
    { name = "machine",     gate = "enclosed", spook = true,  weight = 0.8, floor = 20000,
      channels = { "as_day_drones", "as_drones", "as_urban_drones", "as_urban_debris" } },
    { name = "gunfire",     gate = "always",   spook = true,  weight = 0.3, floor = 45000,
      channels = { "as_out_gunfire" } },
    { name = "underground", gate = "enclosed", spook = true,  weight = 1.0, floor = 15000,
      channels = { "as_ugrnd_banging", "as_ugrnd_drip", "as_ugrnd_drone", "as_ugrnd_lab",
                   "as_ugrnd_metal", "as_ugrnd_noise", "as_ugrnd_rats", "as_ugrnd_ambient_new" } },
    { name = "wind_creep",  gate = "always",   spook = false, weight = 0.8, floor = 20000,
      channels = { "as_wind_creep", "as_wind_creep_urban" } },
    { name = "animals",     gate = "always",   spook = false, weight = 0.7, floor = 25000, night = true,
      channels = { "as_crows", "as_crows_retune", "as_crows_forest", "as_dogs", "as_owls" } },
}

-- REAL_MUTANT: species that count for the growl-plausibility exclusion; trash tier excluded.
local REAL_MUTANT = { bloodsucker = true, psysucker = true, controller = true, burer = true,
                      poltergeist = true, psy_dog = true, chimera = true, snork = true,
                      gigant = true, pseudogiant = true, zombie = true, fracture = true }

-- Place spook by lore class (as_smart_lore.ltx). safe = 0 (allied base carves to nothing).
local CLASS_SPOOK = { safe = 0.00, mundane = 0.10, eerie = 0.35, ruin = 0.35,
                      anomaly = 0.45, den = 0.55, lab = 0.55, psy = 0.60 }

-- Signal constants, all tunable from the trace.
-- PLACE_RADIUS: a smart farther than this doesn't set place. INDOOR_ADD: building/underground raises
-- spook when alone. NIGHT_MILD: night nudge, deliberately small. HEALTH_AMP: low health amplifies.
-- ALLIED_EASE: per-friendly comfort. ALLIED_FLOOR: comfort cap. SUNNY_MULT: suppressor. CTX_PERIOD:
-- score-refresh interval (ms). CELL_M: is_indoor cache cell size.
local PLACE_RADIUS = 150
local MUT_SPOOK    = 0.30
local MUT_CAP      = 2
local INDOOR_ADD   = 0.20
local NIGHT_MILD   = 0.10
local LONELY_ADD   = 0.12
local HEALTH_AMP   = 0.30
local ALLIED_EASE  = 0.20
local ALLIED_FLOOR = 0.30
local SUNNY_MULT   = 0.40
local CTX_PERIOD   = 3000
local CELL_M       = 4

-- Ladder. GRADE names; grade boundaries on the final score; SPOOK_ON/OFF is the gate hysteresis
-- (SPOOK_ON is also the none->LOW edge).
local GRADE = { NONE = 0, LOW = 1, MED = 2, HIGH = 3, INSANE = 4 }
local GRADE_NAME = { [0] = "none", [1] = "LOW", [2] = "MED", [3] = "HIGH", [4] = "INSANE" }
local G_MED, G_HIGH, G_INSANE = 0.40, 0.62, 0.82
local SPOOK_ON, SPOOK_OFF = 0.20, 0.14

-- Director pacing. SPARSE_MS/DENSE_MS: play spacing lerped by score. VOL_MIN/MAX: volume lerped by
-- score. NO_REPEAT: per-channel no-repeat ring depth. RECENT_MAX: recent-category ring. SPOOK_FLOOR:
-- keeps a category from fully vanishing at its off end. COMBAT_MUTE: mute during an active firefight.
local TICK_S      = 1
local SPARSE_MS   = 40000
local DENSE_MS    = 6000
local VOL_MIN     = 0.70
local VOL_MAX     = 1.00
local NO_REPEAT   = 8
local RECENT_MAX  = 3
local SPOOK_FLOOR = 0.05
local COMBAT_MUTE = true

-- Visual layer: at INSANE only, a subtle 2-3s distortion pulse (never persistent). Dwell-gated so a
-- momentary spike never flashes, >=50% random so it isn't mechanical, cooldown so pulses stay
-- occasional, muted during combat. Effectors from the auditioned non-colored set, factor kept subtle.
-- Via xlibs xpp (engine-smoothed, cleared on load).
local VIS_PPE         = { "blur.ppe", "total_recall.ppe", "steam_mine.ppe" }
local VIS_FACTOR      = 0.25
local VIS_DWELL_MS    = 4000
local VIS_COOLDOWN_MS = 30000
local VIS_HOLD_S      = 1.2
local VIS_SMOOTH      = 1.5
local VIS_CHANCE      = 0.5

-- MCM knobs (1.0 neutral).
local sensitivity        = 1
local rarity             = 1
local distance           = 1
local base_volume        = 1
local opt_ambient_volume = 1

-- Runtime state.
local _channels = {}
local _cats     = {}
local ctx       = { score = 0, grade = 0, mutants_ok = false, enclosed = false }
local _ctx_next = 0
local _next_play = 0
local _gate_open = false
local _loaded   = false
local _recent, _recent_set = {}, {}
-- is_indoor cache (level + position cell)
local _enc = { level = nil, cx = nil, cz = nil, val = false }
-- visual-pulse state
local _vis = { insane_since = nil, next_ok = 0, handle = nil }
local visuals_on = true
-- last spook one-shot fired (category + channel), for the HUD
local _last_play = "-"
-- structured {label, value} readout rows for the HUD
local _rows = {}

local function _lerp(from, to, frac)
    return from + (to - from) * frac
end

-- ---- sound bank load ----------------------------------------------------

--- Strip the muted placeholder stem so a play is never spent on silence
local function _audible(list)
    local out = {}
    for _, name in ipairs(list) do
        if name ~= NO_SOUND then out[#out + 1] = name end
    end
    return out
end

--- Build one channel's record (sounds + distance/height) from the LTX, cached; nil if empty/absent
local function _build_channel(ini, channel)
    if _channels[channel] then return _channels[channel] end
    if not ini:section_exist(channel) then return nil end
    local raw = parse_list(ini, channel, "sounds")
    local sounds = raw and #raw > 0 and _audible(raw) or nil
    if not (sounds and #sounds > 0) then return nil end
    _channels[channel] = {
        sounds   = sounds,
        max_dist = ini:r_float_ex(channel, "max_distance") or 80,
        min_dist = ini:r_float_ex(channel, "min_distance") or 45,
        height   = ini:r_float_ex(channel, "height") or 0,
    }
    return _channels[channel]
end

--- The channels of one category that actually built (have audible sounds)
local function _build_category(ini, def)
    local built = {}
    for _, channel in ipairs(def.channels) do
        if _build_channel(ini, channel) then built[#built + 1] = channel end
    end
    return built
end

--- Load every category's channels from the DLTX-merged sound_channels.ltx, once.
local function _load_channels()
    if _loaded then return end
    _loaded = true
    local ini = ini_file(CHANNELS_FILE)
    if not ini then as_debug.warn("as_effect: sound_channels.ltx missing - director inert"); return end
    for _, def in ipairs(CATEGORIES) do
        local built = _build_category(ini, def)
        _cats[def.name] = { def = def, chans = built, next_ok = 0 }
        as_debug.dbg("as_effect: category %s built %d/%d channels", def.name, #built, #def.channels)
    end
end

-- ---- signals (cheap, engine-native) -------------------------------------

--- True if an online object is a real-threat mutant (excludes the trash tier)
local function _real_mutant(obj)
    if not xcreature.is_mutant(obj) then return false end
    local species = xcreature.get_mutant_species(obj)
    return species and REAL_MUTANT[species] or false
end

--- Tally one online object into counts: an allied or enemy stalker, or a real mutant.
local function _classify(obj, counts)
    if xcreature.is_stalker(obj) then
        if xcreature.is_enemy_to_actor(obj) then counts.enemy = counts.enemy + 1
        else counts.allied = counts.allied + 1 end
    elseif _real_mutant(obj) then
        counts.mutants = counts.mutants + 1
    end
end

--- Allied / enemy humans and real mutants near the actor. Only allied (comfort) and mutants (source
--- + growl gate) drive the score; enemy is for the debug readout.
--- @return allied_count, enemy_count, mutant_count
local function _presence(actor)
    if not xcreature then return 0, 0, 0 end
    local apos, actor_id = actor:position(), actor:id()
    local radius_sqr = PLACE_RADIUS * PLACE_RADIUS
    local counts = { allied = 0, enemy = 0, mutants = 0 }
    for object_id, storage in pairs(db.storage) do
        local obj = (object_id ~= actor_id) and storage and storage.object
        if obj and apos:distance_to_sqr(obj:position()) <= radius_sqr then
            _classify(obj, counts)
        end
    end
    return counts.allied, counts.enemy, counts.mutants
end

--- Place spook from the governing smart terrain. The curated "safe" class (real allied bases) carves
--- to zero; den/psy/lab/eerie/ruin/anomaly set the base; a smart out of range or unlisted falls to the
--- level default. is_base alone is NOT safe (a mutant-infested or enemy base carries the engine base
--- prop too) - only the curated safe class is. Reads as_smart_lore.ltx (no is_lair, no name tricks).
--- @return spook_base, place_desc, is_safe, smart (or nil), class, dist
local _lore, _lore_loaded = nil, false
local function _place()
    if not _lore_loaded then _lore_loaded = true; _lore = ini_file(LORE_FILE) end
    local ini = _lore
    local level_name = level.name()
    local smart = xsmart and xsmart.get_actor_smart and xsmart.get_actor_smart()
    local data = smart_terrain and smart_terrain.nearest_to_actor_smart
    local dist = data and data.dist or -1
    if smart and data and data.dist and data.dist <= PLACE_RADIUS then
        local smart_name = smart:name()
        local class = ini and (ini:r_string_ex(SEC_SMART_CLASS, smart_name)
                      or ini:r_string_ex(SEC_LEVEL, level_name)) or "mundane"
        local is_safe = class == "safe"
        local base = is_safe and 0 or (CLASS_SPOOK[class] or CLASS_SPOOK.mundane)
        return base, smart_name .. ":" .. class, is_safe, smart, class, dist
    end
    local class = ini and ini:r_string_ex(SEC_LEVEL, level_name) or "mundane"
    return CLASS_SPOOK[class] or CLASS_SPOOK.mundane, level_name .. ":" .. class .. "(lvl)", false, nil, class, -1
end

--- Enclosure via xcombat.is_indoor, cached by (level, position cell) so the raycast fires only on a
--- cell change, never per tick. Instant-true on underground levels, roof+wall raycast on surface.
local function _enclosed(actor)
    if not xcombat or not xcombat.is_indoor then return false end
    local pos = actor:position()
    local level_name = level.name()
    local cell_x, cell_z = math_floor(pos.x / CELL_M), math_floor(pos.z / CELL_M)
    if _enc.level ~= level_name or _enc.cx ~= cell_x or _enc.cz ~= cell_z then
        _enc.level, _enc.cx, _enc.cz = level_name, cell_x, cell_z
        _enc.val = xcombat.is_indoor(pos)
    end
    return _enc.val
end

--- True if hour reads night/dusk (kept mild, and a soft lean for the animals category)
local function _is_night(hour)
    return not hour or hour < 7 or hour >= 20
end

--- Nice sunny daylight: a suppressor only (never adds spook). Day, no rain, clear weather.
local function _sunny(hour)
    if not (hour and hour >= 7 and hour < 19) then return false end
    if (level.rain_factor() or 0) >= 0.1 then return false end
    local weather = level.get_weather()
    if not weather then return true end
    weather = weather:lower()
    return not (weather:find("storm") or weather:find("rain") or weather:find("fog")
             or weather:find("tuman") or weather:find("cloud") or weather:find("dark")
             or weather:find("partly"))
end

--- "Y" / "-" for a boolean, for the debug readout
local function _yn(value)
    return value and "Y" or "-"
end

--- Map the final score to a grade
local function _grade(score)
    if score < SPOOK_ON  then return GRADE.NONE end
    if score < G_MED     then return GRADE.LOW end
    if score < G_HIGH    then return GRADE.MED end
    if score < G_INSANE  then return GRADE.HIGH end
    return GRADE.INSANE
end

--- Recompute the cached spook score: place is the base, safety subtracts, enclosure/night/health
--- adjust. A safe place (allied base) skips the enclosure/night adds, so an empty base building never
--- creeps above the gate. Mutant presence is not a source -- it only gates the growl palette. Builds
--- the HUD rows (structured label/value) and, under DEBUG, the log breakdown.
local function _score(actor, hour)
    local allied, enemy, mutants = _presence(actor)
    local base, place, is_safe, smart, class, dist = _place()
    local enclosed = _enclosed(actor)
    local health = actor.health or 1

    local score = base
    local mut_add = math_min(mutants, MUT_CAP) * MUT_SPOOK
    score = score + mut_add
    local indoor_on = (not is_safe) and enclosed and allied == 0
    if indoor_on then score = score + INDOOR_ADD end
    local night_on = (not is_safe) and _is_night(hour)
    if night_on then score = score + NIGHT_MILD end
    local lonely_on = (not is_safe) and allied == 0 and enemy == 0
    if lonely_on then score = score + LONELY_ADD end
    local health_mult = 1 + (1 - health) * HEALTH_AMP
    score = score * health_mult
    local allied_mult = (allied > 0) and math_max(ALLIED_FLOOR, 1 - allied * ALLIED_EASE) or 1
    score = score * allied_mult
    local sunny_on = _sunny(hour)
    if sunny_on then score = score * SUNNY_MULT end
    score = score * sensitivity
    if score < 0 then score = 0 elseif score > 1 then score = 1 end

    ctx.score = score
    ctx.grade = _grade(score)
    ctx.mutants_ok = mutants > 0
    ctx.enclosed = enclosed

    local props = (smart and xsmart) and string_format("base:%s lair:%s terr:%s anom:%s shelter:%s",
        _yn(xsmart.is_base(smart)), _yn(xsmart.is_lair(smart)), _yn(xsmart.is_territory(smart)),
        _yn(xsmart.has_anomaly(smart)), _yn(xsmart.has_surge_shelter(smart))) or "-"
    local surge_on = surge_manager and surge_manager.is_started()
    local psi_on = psi_storm_manager and psi_storm_manager.is_started()
    _rows = {
        { "SPOOK",     string_format("%-6s %.2f", GRADE_NAME[ctx.grade], score) },
        { "playing",   _last_play },
        { "smart",     string_format("%s  %.0fm", (smart and smart:name()) or "-", dist) },
        { "class",     class or "-" },
        { "props",     props },
        { "allies",    tostring(allied) },
        { "enemies",   tostring(enemy) },
        { "mutants",   string_format("%d   growl:%s", mutants, _yn(mutants > 0)) },
        { "night",     _yn(_is_night(hour)) },
        { "weather",   string_format("%s  rain %.2f", tostring(level.get_weather()), level.rain_factor() or 0) },
        { "underground", _yn(GetEvent("underground")) },
        { "indoor",    _yn(enclosed) },
        { "surge/psi", string_format("%s / %s", _yn(surge_on), _yn(psi_on)) },
        { "health",    string_format("%d%%", math_floor(health * 100)) },
        { "-- math",   "" },
        { "base",      string_format("%.2f", base) },
        { "+mutant",   mut_add > 0 and string_format("+%.2f", mut_add) or "-" },
        { "+indoor",   indoor_on and string_format("+%.2f", INDOOR_ADD) or "-" },
        { "+night",    night_on and string_format("+%.2f", NIGHT_MILD) or "-" },
        { "+lonely",   lonely_on and string_format("+%.2f", LONELY_ADD) or "-" },
        { "xhealth",   string_format("x%.2f", health_mult) },
        { "xallies",   string_format("x%.2f", allied_mult) },
        { "xsunny",    sunny_on and string_format("x%.2f", SUNNY_MULT) or "-" },
        { "= score",   string_format("%.2f", score) },
    }
    if as_debug.on() then
        as_debug.dbg("spook %s %.2f | %s base=%.2f mut=%d ind=%s nt=%s sun=%s allies=%d enemy=%d hp=%.2f",
            GRADE_NAME[ctx.grade], score, place, base, mutants, tostring(indoor_on), tostring(night_on),
            tostring(sunny_on), allied, enemy, health)
    end
end

-- ---- gates --------------------------------------------------------------

--- True during an active firefight (a loud signal; subtle spooks are lost under it)
local function _in_combat()
    return xr_combat_ignore and next(xr_combat_ignore.fighting_with_actor_npcs) ~= nil
end

--- True if a category's gate passes now
local function _gate_ok(def)
    if def.gate == "mutants"  then return ctx.mutants_ok end
    if def.gate == "enclosed" then return ctx.enclosed end
    return true
end

-- ---- selection ----------------------------------------------------------

local function _in_recent(name)
    for i = 1, #_recent do
        if _recent[i] == name then return true end
    end
    return false
end

local function _note_recent(name)
    _recent[#_recent + 1] = name
    _recent_set[name] = true
    if #_recent > RECENT_MAX then
        local dropped = table_remove(_recent, 1)
        if not _in_recent(dropped) then _recent_set[dropped] = nil end
    end
end

--- Weight one category: 0 if gated out or on its rarity floor, else spook-vs-texture tilt by score,
--- times its base weight, boosted at night for animals, penalised if recently played.
local function _category_weight(cat, score, hour, tg)
    local def = cat.def
    if #cat.chans == 0 or tg < cat.next_ok or not _gate_ok(def) then return 0 end
    local tilt = def.spook and (SPOOK_FLOOR + score * score) or (SPOOK_FLOOR + (1 - score) * (1 - score))
    local weight = def.weight * tilt
    if def.night and _is_night(hour) then weight = weight * 1.5 end
    if _recent_set[def.name] then weight = weight * 0.3 end
    return weight
end

--- Weighted-random category among those eligible now
local function _pick_category(score, hour, tg)
    local total = 0
    for _, cat in pairs(_cats) do
        cat._w = _category_weight(cat, score, hour, tg)
        total = total + cat._w
    end
    if total <= 0 then return nil end
    local roll = math_random() * total
    for _, cat in pairs(_cats) do
        roll = roll - cat._w
        if cat._w > 0 and roll <= 0 then return cat end
    end
    return nil
end

local function _pick_channel(cat)
    local count = #cat.chans
    return count > 0 and cat.chans[math_random(count)] or nil
end

--- No-repeat sound pick within a channel
local function _pick_sound(channel)
    local ch = _channels[channel]
    local count = #ch.sounds
    if count <= 1 then return ch.sounds[1] end
    local avoid = (NO_REPEAT < count) and NO_REPEAT or (count - 1)
    local seen, ring = ch.seen, ch.ring
    if not seen then seen = {}; ring = {}; ch.seen = seen; ch.ring = ring end
    local idx
    repeat idx = math_random(count) until not seen[idx]
    seen[idx] = true
    ring[#ring + 1] = idx
    if #ring > avoid then seen[table_remove(ring, 1)] = nil end
    return ch.sounds[idx]
end

--- Place and fire one sound: closer as the score rises (within the channel's authored range, scaled
--- by the distance knob), louder as the score rises. Fire-and-forget via xsound.play.
local function _play(channel, file, score)
    local actor = db.actor
    if not actor then return end
    local ch = _channels[channel]
    local pos = actor:position()
    local dist = (ch.min_dist + (ch.max_dist - ch.min_dist) * (1 - score)) * distance
    local angle = math_rad(math_random(0, 359))
    local vec = vector():set(pos.x + math_cos(angle) * dist, pos.y + ch.height, pos.z + math_sin(angle) * dist)
    local vol = _lerp(VOL_MIN, VOL_MAX, score) * base_volume * opt_ambient_volume
    xsound.play(file, { position = vec, volume = vol })
    if as_debug.on() then
        as_debug.dbg("play ch=%s file=%s dist=%.1f vol=%.2f score=%.2f", channel, file, dist, vol, score)
    end
end

-- ---- visual layer -------------------------------------------------------

--- Fire one subtle distortion pulse: acquire a cyclic effector, drive its factor to VIS_FACTOR
--- (engine-smoothed fade-in), then release after a short hold (fade-out) -> ~2-3s total, self-ending.
local function _vis_pulse()
    if not xpp then return end
    local ppe = VIS_PPE[math_random(#VIS_PPE)]
    if _vis.handle and xpp.is_active(_vis.handle) then xpp.release(_vis.handle) end
    local handle = xpp.acquire(ppe, { cyclic = true, smoothing = VIS_SMOOTH })
    _vis.handle = handle
    if handle then
        xpp.set_target(handle, VIS_FACTOR, VIS_SMOOTH)
        CreateTimeEvent("as_effect", "vis_release", VIS_HOLD_S, function()
            if xpp.is_active(handle) then xpp.release(handle) end
            if _vis.handle == handle then _vis.handle = nil end
            return true
        end)
    end
    if as_debug.on() then as_debug.dbg("visual pulse %s factor=%.2f", ppe, VIS_FACTOR) end
end

--- INSANE-only visual gate: require sustained INSANE (dwell), then once per cooldown roll >=50% to
--- pulse. Leaving INSANE (or combat) resets the dwell so it must be re-earned.
local function _visual_tick(tg)
    if not (visuals_on and xpp) or ctx.grade < GRADE.INSANE then
        _vis.insane_since = nil
        return
    end
    if not _vis.insane_since then _vis.insane_since = tg; return end
    if tg < _vis.next_ok or tg - _vis.insane_since < VIS_DWELL_MS then return end
    _vis.next_ok = tg + VIS_COOLDOWN_MS
    if math_random() < VIS_CHANCE then _vis_pulse() end
end

-- ---- tick ---------------------------------------------------------------

--- The director tick: refresh the cached score on a slow interval, gate on combat + hysteresis, then
--- one throttled context-weighted one-shot. Spacing lerps SPARSE->DENSE with the score.
local function spook_tick()
    ResetTimeEvent("as_effect", "spook_tick", TICK_S)
    if not level.present() then return false end
    local actor = db.actor
    if not actor then return false end
    local tg = time_global()
    local hour = level.get_time_hours()

    if tg >= _ctx_next then _score(actor, hour); _ctx_next = tg + CTX_PERIOD end

    if COMBAT_MUTE and _in_combat() then
        _gate_open = false; _vis.insane_since = nil
        return false
    end

    _visual_tick(tg)

    local score = ctx.score
    if _gate_open then
        if score < SPOOK_OFF then _gate_open = false; return false end
    else
        if score < SPOOK_ON then return false end
        _gate_open = true
    end

    if tg < _next_play then return false end
    local cat = _pick_category(score, hour, tg)
    if not cat then return false end
    local channel = _pick_channel(cat)
    local file = channel and _pick_sound(channel)
    if file then
        _play(channel, file, score)
        cat.next_ok = tg + cat.def.floor
        _note_recent(cat.def.name)
        _last_play = string_format("%s  %s", cat.def.name, channel)
    end
    _next_play = tg + math_floor(_lerp(SPARSE_MS, DENSE_MS, score) * rarity)
    return false
end

-- ---- lifecycle ----------------------------------------------------------

local function refresh()
    sensitivity        = as_mcm.get_config("sensitivity") or 1
    rarity             = as_mcm.get_config("rarity") or 1
    distance           = as_mcm.get_config("distance") or 1
    base_volume        = as_mcm.get_config("vol_global") or 1
    opt_ambient_volume = (ui_options and ui_options.get("sound/environment/ambient_volume")) or 1
    local wanted = as_mcm.get_config("visuals")
    visuals_on = (wanted == nil) or wanted
end

--- Load banks and arm the tick. Runs on every actor_on_first_update, so a save load re-arms the
--- (load-cleared) time event. Inert without xlibs (xsound), the play primitive.
local function _on_first_update()
    refresh()
    if not xsound then as_debug.warn("as_effect: xlibs (xsound) absent - spook director inert"); return end
    _load_channels()
    _next_play, _ctx_next, _gate_open = 0, 0, false
    if _vis.handle and level then level.remove_pp_effector(_vis.handle) end
    _vis.insane_since, _vis.next_ok, _vis.handle = nil, 0, nil
    RemoveTimeEvent("as_effect", "spook_tick")
    CreateTimeEvent("as_effect", "spook_tick", TICK_S, spook_tick)
    as_debug.info("as_effect: spook director armed")
end

--- The spook readout rows ({label, value}: grade/score, place, playing, each term, gates) for the HUD.
function get_hud_rows()
    return _rows
end

function on_game_start()
    RegisterScriptCallback("actor_on_first_update",      _on_first_update)
    RegisterScriptCallback("on_option_change",           refresh)
    RegisterScriptCallback("mcm_option_restore_default", refresh)
end
