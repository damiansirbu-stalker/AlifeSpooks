--- as_effect: additive dread director. Reads a place-driven dread score (curated per-level base +
--- dynamic base ownership + one presence term + enclosure + time, all ADDITIVE, no multipliers, no
--- cutout), sorts it into a five-step ladder, and fires curated one-shots through xsound.play when a
--- place is unsettling -- closer and louder as the score climbs, but at a CONSTANT jittered ~10s rate
--- (dread drives SELECTION, not density). The director runs on its own dread_director slot. A separate
--- observer owns the vanilla update_ambient slot only to replay and LOG the base ambient; the base's
--- copies of our sounds are removed statically by the DLTX overlay (mod_sound_channels_alifespooks.ltx).

local math_random, math_rad = math.random, math.rad
local math_cos, math_sin = math.cos, math.sin
local math_max, math_min, math_floor = math.max, math.min, math.floor
local ini_file, parse_list = ini_file, parse_list
local time_global, vector = time_global, vector
local table_remove, string_format, RegisterScriptCallback = table.remove, string.format, RegisterScriptCallback
local pairs, tostring, next, ipairs = pairs, tostring, next, ipairs

local LORE_FILE       = "scripts\\as_smart_lore.ltx"
local CHANNELS_FILE   = "environment\\sound_channels.ltx"
local SEC_LEVEL       = "level_default"

-- =========================================================================
-- Categories: the fixed palette. A firing gate, a base weight, and a per-category minimum interval
-- so screams stay rare against drone density. Everything is a one-shot now (weight rises with
-- the score, no texture/loop split). The SOUNDS of each category come from the generated as_manifest
-- (the shipped directory zs\<category>), not from engine channels.
-- gates: always | mutants (real mutant online) | underground (GetEvent, actual underground level)
--        | exterior_humans (not underground AND a human near - someone to fire the shot)
--        | exterior (not enclosed - outdoor-only, nature never plays indoors)
--        | ominous (non-mundane lore class OR near an anomaly - places that carry dread, e.g. drones)
-- =========================================================================
local CATEGORIES = {
    { name = "drone",       gate = "ominous",         weight = 1.0, floor = 12000 },
    { name = "spook",       gate = "always",          weight = 1.0, floor = 8000 },
    { name = "scream",      gate = "always",          weight = 0.5, floor = 90000 },
    { name = "growl",       gate = "mutants",         weight = 1.0, floor = 60000 },
    { name = "machine",     gate = "underground",     weight = 0.8, floor = 20000 },
    { name = "gunfire",     gate = "exterior_humans", weight = 0.3, floor = 45000 },
    { name = "underground", gate = "underground",     weight = 1.0, floor = 15000 },
    { name = "creak",       gate = "always",          weight = 0.8, floor = 20000 },
    { name = "wind_creep",  gate = "exterior",        weight = 0.8, floor = 20000 },
    { name = "animals",     gate = "exterior",        weight = 0.7, floor = 25000, night = true },
}

-- REAL_MUTANT: species that count for the growl-plausibility exclusion; trash tier excluded.
local REAL_MUTANT = { bloodsucker = true, psysucker = true, controller = true, burer = true,
                      poltergeist = true, psy_dog = true, chimera = true, snork = true,
                      gigant = true, zombie = true, fracture = true, karlik = true, lurker = true }

-- Lore: the place's own dread by class (as_smart_lore.ltx). The primary driver. No safe class -
-- safety is the runtime allied-base cutout.
local CLASS_DREAD = { mundane = 0.10, eerie = 0.25, ruin = 0.25,
                      den = 0.40, lab = 0.40, psy = 0.50 }

-- who's-around: ONE categorical state, its flat dread value. Being among allies (and no threat) is the
-- only calming state; alone / enemy / mutant all sit above zero, so a baseline emerges from presence with
-- NO separate floor constant. The enemy state also covers enemy-held ground (an empty enemy base still
-- reads hostile). Count and proximity do NOT scale it - this is atmosphere, not a threat alarm.
local WHO_DREAD = { allied = -0.15, alone = 0.10, enemy = 0.18, mutant = 0.22, mixed = 0.25 }

-- Other signals. PLACE_RADIUS: presence scan radius + the range a smart must be within to set the place.
-- INDOOR_ADD: enclosed (roof+walls raycast OR surge shelter). Time rides a few stages (_time_dread).
-- CELL_M: is_indoor cache cell size.
local PLACE_RADIUS   = 150
local INDOOR_ADD     = 0.15
local CELL_M         = 4

-- Ladder. GRADE names; grade boundaries on the final score; DREAD_ON is the emission floor (below it
-- nothing plays) and also the none->LOW grade edge.
local GRADE = { NONE = 0, LOW = 1, MED = 2, HIGH = 3, INSANE = 4 }
local GRADE_NAME = { [0] = "none", [1] = "LOW", [2] = "MED", [3] = "HIGH", [4] = "INSANE" }
local G_MED, G_HIGH, G_INSANE = 0.40, 0.60, 0.80
local DREAD_ON = 0.20

-- Director pacing. Emission is a jittered self-reschedule (ap_ext_news pattern): each fire plays one
-- sound and the next play is armed at math.random(SPACE_MIN_MS, SPACE_MAX_MS) -> mean ~10s, bounded,
-- non-monotonic. Density is CONSTANT and dread-INDEPENDENT (dread drives selection, never the rate).
-- BASE_TICK_S: the owned loop's own re-arm (base round-robin resolution). VOL_MIN/MAX: volume lerped by
-- score. RECENT_MAX: recent-category ring. WEIGHT_FLOOR: keeps a category from vanishing.
local BASE_TICK_S  = 1
local CTX_PERIOD   = 3000
local SPACE_MIN_MS = 5000
local SPACE_MAX_MS = 15000
local VOL_MIN     = 0.70
local VOL_MAX     = 1.00
-- HORROR_PULL: at peak dread the sound spawns this fraction closer than vanilla's own distance.
local HORROR_PULL = 0.25
-- PLAY_WINDOW_MS: how long after a fire the HUD reports the sound as still PLAYING. One-shots are fire-
-- and-forget (engine-owned, no handle to query), so this is an estimate of a typical one-shot length.
local PLAY_WINDOW_MS = 6000
-- TYPE_WRAP: chars per HUD row for the wrapped AVAILABLE comma list (fits the as_hud panel width).
local TYPE_WRAP = 34
local RECENT_MAX  = 3
local WEIGHT_FLOOR = 0.05

-- Visual layer: at INSANE only, a subtle 2-3s distortion pulse (never persistent). Dwell-gated so a
-- momentary spike never flashes, >=50% random so it isn't mechanical, cooldown so pulses stay
-- occasional. Effectors from the auditioned non-colored set, factor kept subtle.
-- Via xlibs xpp (engine-smoothed, cleared on load).
local VIS_PPE         = { "blur.ppe", "total_recall.ppe", "steam_mine.ppe" }
local VIS_FACTOR      = 0.25
local VIS_DWELL_MS    = 4000
local VIS_COOLDOWN_MS = 30000
local VIS_HOLD_S      = 1.2
local VIS_SMOOTH      = 1.5
local VIS_CHANCE      = 0.5

-- MCM knobs (1.0 neutral).
local rarity             = 1
local distance           = 1
local base_volume        = 1
local opt_ambient_volume = 1
local _cat_vol           = {}

-- Runtime state.
local _cats     = {}
local ctx       = { score = 0, grade = 0, mutants_ok = false, enclosed = false, underground = false, has_humans = false }
local _next_play = 0
local _play_at   = 0   -- time_global of the last fire, for the HUD PLAYING/stopped readout
local _loaded   = false
local _recent, _recent_set = {}, {}
-- is_indoor cache (level + position cell)
local _enc = { level = nil, cx = nil, cz = nil, val = false }
-- visual-pulse state
local _vis = { insane_since = nil, next_ok = 0, handle = nil }
local visuals_on = true
-- last one-shot the director fired (category + channel), for the HUD
local _last_play = "-"
-- last base one-shot the ambient hook replayed (channel + file) + its time, for the HUD BASE section
local _base_last = "-"
local _base_at   = 0
-- structured {label, value} readout rows for the HUD
local _rows = {}

local function _lerp(from, to, frac)
    return from + (to - from) * frac
end

--- Comma-join short strings into lines each <= width chars (the wrapped HUD AVAILABLE list). Builds
--- each line in a buffer joined with table.concat, never a growing-string accumulator.
local table_concat = table.concat
local function _wrap_csv(items, width)
    local lines, buf, len = {}, {}, 0
    for i = 1, #items do
        local sep = (i < #items) and ", " or ""
        local plen = #items[i] + #sep
        if len > 0 and len + plen > width then lines[#lines + 1] = table_concat(buf); buf, len = {}, 0 end
        buf[#buf + 1] = items[i]
        buf[#buf + 1] = sep
        len = len + plen
    end
    if len > 0 then lines[#lines + 1] = table_concat(buf) end
    return lines
end

-- ---- sound bank (from the generated manifest) ---------------------------
-- as_manifest.categories[<cat>] = { { path, min_dist, max_dist, height }, ... }, plus cadence_ms,
-- both written by tools/merge.py at deploy. The director reads this, never sound_channels.ltx: our
-- content ships in our own directories (zs\<category>), not as engine channels. Anomaly Lua cannot
-- enumerate a directory at runtime, so the sound list is shipped as data.

--- Load each category's sound list from as_manifest, once. Each sound is { path, min, max, height }.
local function _load_channels()
    if _loaded then return end
    _loaded = true
    local cats = as_manifest and as_manifest.categories or {}
    for _, def in ipairs(CATEGORIES) do
        local sounds = cats[def.name] or {}
        _cats[def.name] = { def = def, sounds = sounds, next_ok = 0 }
        as_debug.dbg("as_effect: category %s = %d sounds", def.name, #sounds)
    end
end

-- ---- signals (cheap, engine-native) -------------------------------------

--- True if an online object is a real-threat mutant (excludes the trash tier)
local function _real_mutant(obj)
    if not xcreature.is_mutant(obj) then return false end
    local species = xcreature.get_mutant_species(obj)
    return species and REAL_MUTANT[species] or false
end

--- Tally one online object into counts: an allied or enemy stalker, or a real mutant.
local function _classify(obj, counts)
    if xcreature.is_stalker(obj) then
        if xcreature.is_enemy_to_actor(obj) then counts.enemy = counts.enemy + 1
        else counts.allied = counts.allied + 1 end
    elseif _real_mutant(obj) then
        counts.mutants = counts.mutants + 1
    end
end

--- Allied / enemy humans and real mutants near the actor. Only allied (comfort) and mutants (source
--- + growl gate) drive the score; enemy is for the debug readout.
--- @return allied_count, enemy_count, mutant_count
local function _presence(actor)
    if not xcreature then return 0, 0, 0 end
    local apos, actor_id = actor:position(), actor:id()
    local radius_sqr = PLACE_RADIUS * PLACE_RADIUS
    local counts = { allied = 0, enemy = 0, mutants = 0 }
    for object_id, storage in pairs(db.storage) do
        local obj = (object_id ~= actor_id) and storage and storage.object
        if obj and apos:distance_to_sqr(obj:position()) <= radius_sqr then
            _classify(obj, counts)
        end
    end
    return counts.allied, counts.enemy, counts.mutants
end

--- Enemy-held ground: true if any squad CURRENTLY stationed at the smart (SIMBOARD occupancy, not
--- static props) belongs to a faction hostile to the actor. An empty enemy base still reads hostile.
--- Folds into the who's-around "enemy" state, so it is a single boolean, not a weighted term.
local function _ownership(smart, comm)
    if not (smart and comm and xsmart and xsmart.iter_stationed_squads and game_relations) then
        return false
    end
    for se in xsmart.iter_stationed_squads(smart.id) do
        if se.player_id and game_relations.is_factions_enemies(comm, se.player_id) then
            return true
        end
    end
    return false
end

--- Place dread from the CURATED PER-LEVEL default only (as_smart_lore.ltx [level_default]). Per-smart
--- type is deferred (n100); the prop-flags is_base/is_lair are rejected. Returns the nearest smart
--- (only when within PLACE_RADIUS) so _ownership can read its stationed squads.
--- @return dread_base, place_desc, smart (or nil), class, dist
local _lore, _lore_loaded = nil, false
local function _place()
    if not _lore_loaded then _lore_loaded = true; _lore = ini_file(LORE_FILE) end
    local ini = _lore
    local level_name = level.name()
    local smart = xsmart and xsmart.get_actor_smart and xsmart.get_actor_smart()
    local data = smart_terrain and smart_terrain.nearest_to_actor_smart
    local dist = data and data.dist or -1
    local in_range = smart ~= nil and data ~= nil and data.dist ~= nil and data.dist <= PLACE_RADIUS
    local class = ini and ini:r_string_ex(SEC_LEVEL, level_name) or "mundane"
    local base = CLASS_DREAD[class] or CLASS_DREAD.mundane
    if not in_range then smart, dist = nil, -1 end
    return base, level_name .. ":" .. class, smart, class, dist
end

--- Enclosure via xcombat.is_indoor, cached by (level, position cell) so the raycast fires only on a
--- cell change, never per tick. Instant-true on underground levels, roof+wall raycast on surface.
local function _enclosed(actor)
    if not xcombat or not xcombat.is_indoor then return false end
    local pos = actor:position()
    local level_name = level.name()
    local cell_x, cell_z = math_floor(pos.x / CELL_M), math_floor(pos.z / CELL_M)
    if _enc.level ~= level_name or _enc.cx ~= cell_x or _enc.cz ~= cell_z then
        _enc.level, _enc.cx, _enc.cz = level_name, cell_x, cell_z
        _enc.val = xcombat.is_indoor(pos)
    end
    return _enc.val
end

--- True if hour reads night/dusk (kept mild, and a soft lean for the animals category)
local function _is_night(hour)
    return not hour or hour < 7 or hour >= 20
end

--- Time rides a few discrete stages (not a fine curve): day calm, dusk/dawn a nudge, night up, deep night most.
local function _time_dread(hour)
    if not hour then return 0 end
    if hour >= 7 and hour < 19 then return 0.00 end   -- day
    if hour >= 19 and hour < 21 then return 0.06 end  -- dusk
    if hour >= 5 and hour < 7  then return 0.04 end   -- dawn
    if hour >= 0 and hour < 4  then return 0.12 end   -- deep night
    return 0.10                                       -- night
end

--- Short label for the current time stage (for the HUD).
local function _time_name(hour)
    if not hour then return "-" end
    if hour >= 7 and hour < 19 then return "day" end
    if hour >= 19 and hour < 21 then return "dusk" end
    if hour >= 5 and hour < 7  then return "dawn" end
    if hour >= 0 and hour < 4  then return "deep night" end
    return "night"
end

--- who's-around: one categorical state. Enemy folds in enemy-held ground; allied only when NO enemy or
--- mutant near. Priority mixed(enemy+mutant) > mutant > enemy > allied > alone. No count/proximity scaling.
local function _who_state(allied, enemy, mutants, enemy_held)
    local en = enemy > 0 or enemy_held
    local mu = mutants > 0
    if en and mu then return "mixed" end
    if mu then return "mutant" end
    if en then return "enemy" end
    if allied > 0 then return "allied" end
    return "alone"
end

--- "Y" / "-" for a boolean, for the debug readout
local function _yn(value)
    return value and "Y" or "-"
end

--- Map the final score to a grade
local function _grade(score)
    if score < DREAD_ON  then return GRADE.NONE end
    if score < G_MED     then return GRADE.LOW end
    if score < G_HIGH    then return GRADE.MED end
    if score < G_INSANE  then return GRADE.HIGH end
    return GRADE.INSANE
end

-- ---- gates --------------------------------------------------------------

--- True if a category's gate passes now. Reads ctx (populated by _score before any gate is checked).
--- always: any place. mutants: a real mutant online. underground: an actual underground level.
--- exterior_humans: outdoors with a human near (gunfire). exterior: outdoors - nature never plays indoors.
--- ominous: the place carries dread - a non-mundane lore class OR near an anomaly (drones).
local function _gate_ok(def)
    local g = def.gate
    if g == "mutants"         then return ctx.mutants_ok end
    if g == "underground"     then return ctx.underground end
    if g == "exterior_humans" then return (not ctx.underground) and ctx.has_humans end
    if g == "exterior"        then return not ctx.enclosed end
    if g == "ominous"         then return (ctx.class ~= nil and ctx.class ~= "mundane") or ctx.anomaly end
    return true
end

--- Recompute the cached dread score. PURELY ADDITIVE - no multipliers, no cutout, no floor constant:
---   dread = lore(place class) + who's-around(one categorical state) + indoor + time
--- Enemy-held ground folds into the "enemy" state; mutants add via the "mutant" state AND gate the
--- growl palette (ctx.mutants_ok). Enclosed = roof+wall raycast OR the smart's surge shelter. Being
--- among allies is the only NEGATIVE term (WHO_DREAD.allied), so a calm place among allies falls below
--- the DREAD_ON floor on its own, while a genuinely scary place still carries through. Builds the HUD rows.
local function _score(actor, hour)
    local allied, enemy, mutants = _presence(actor)
    local base, place, smart, class, dist = _place()
    local comm = xcreature and xcreature.community and xcreature.community(actor)
    local enemy_held = _ownership(smart, comm)
    local enclosed = _enclosed(actor)
        or (smart and xsmart and xsmart.has_surge_shelter and xsmart.has_surge_shelter(smart)) or false
    local who = _who_state(allied, enemy, mutants, enemy_held)
    local who_pts = WHO_DREAD[who] or 0
    local time_pts = _time_dread(hour)

    -- Pure sum, no cutout, no floor: allied is the only negative term, so a calm place among allies
    -- falls below DREAD_ON on its own; a scary place (lore) still carries through.
    local score = base + who_pts + time_pts
    if enclosed then score = score + INDOOR_ADD end
    if score < 0 then score = 0 elseif score > 1 then score = 1 end

    ctx.dread = score
    ctx.grade = _grade(score)
    ctx.mutants_ok = mutants > 0
    ctx.enclosed = enclosed
    ctx.underground = GetEvent("underground") or false
    ctx.has_humans = (allied + enemy) > 0
    ctx.class = class
    ctx.anomaly = (smart and xsmart and xsmart.has_anomaly and xsmart.has_anomaly(smart)) or false

    -- a factor's contribution, or "-" when the factor is off
    local function _pv(on, v) return on and string_format("%+.2f", v) or "-" end
    local playing = _play_at > 0 and (time_global() - _play_at) < PLAY_WINDOW_MS
    local base_playing = _base_at > 0 and (time_global() - _base_at) < PLAY_WINDOW_MS
    -- which categories may fire right now (context gates) - one source of truth via _gate_ok
    local avail = {}
    for _, def in ipairs(CATEGORIES) do
        if _gate_ok(def) then avail[#avail + 1] = def.name end
    end
    -- Two sound sections, symmetrical: SPOOK (our director's current one-shot) then BASE (the base
    -- ambient the hook replays), each a header + the sound on its OWN row (paths are long), bright while
    -- sounding (style "play") and grayed once past PLAY_WINDOW_MS ("stop"). Muting is the static DLTX
    -- overlay, not this hook, so there is no runtime tally - BASE just shows what the base is playing.
    local grade_name = GRADE_NAME[ctx.grade]
    _rows = {
        { "SPOOK",         "", "", "hdr" },
        { _last_play,      "", "", playing and "play" or "stop" },
        { "", "", "" },
        { "BASE",          "", "", "hdr" },
        { _base_last,      "", "", base_playing and "play" or "stop" },
        { "", "", "" },
        { "AVAILABLE",     "", "", "hdr" },
    }
    -- AVAILABLE: a wrapped comma list (denser and more legible than a fixed 3-column grid)
    for _, wrapped in ipairs(_wrap_csv(avail, TYPE_WRAP)) do
        _rows[#_rows + 1] = { wrapped, "", "" }
    end
    _rows[#_rows + 1] = { "", "", "" }
    -- SENSORS: one harmonized block - the dread terms (value + contribution) then the gate reads
    _rows[#_rows + 1] = { "SENSORS",     "",                   "" }
    _rows[#_rows + 1] = { "lore",        class or "-",         string_format("%.2f", base) }
    _rows[#_rows + 1] = { "near",        who,                  string_format("%+.2f", who_pts) }
    _rows[#_rows + 1] = { "indoor",      _yn(enclosed),        _pv(enclosed, INDOOR_ADD) }
    _rows[#_rows + 1] = { "time",        _time_name(hour),     _pv(time_pts > 0, time_pts) }
    _rows[#_rows + 1] = { "underground", _yn(ctx.underground), "" }
    _rows[#_rows + 1] = { "person near", _yn(ctx.has_humans),  "" }
    _rows[#_rows + 1] = { "", "", "" }
    -- DREAD: the summed score + grade, the whole row tinted by grade severity (green -> red)
    _rows[#_rows + 1] = { "DREAD", string_format("%.2f", score), grade_name, "g_" .. grade_name:lower() }
    _rows[#_rows + 1] = { "", "", "" }
    _rows[#_rows + 1] = { "zone",   (smart and smart:name()) or "-", string_format("%.0fm", dist) }
    if as_debug.on() then
        as_debug.dbg("dread %s %.2f | %s lore=%.2f who=%s(%+.2f) ind=%s time=%s(%.2f) a=%d e=%d m=%d held=%s",
            GRADE_NAME[ctx.grade], score, place, base, who, who_pts, tostring(enclosed),
            _time_name(hour), time_pts, allied, enemy, mutants, tostring(enemy_held))
    end
end

-- ---- selection ----------------------------------------------------------

local function _in_recent(name)
    for i = 1, #_recent do
        if _recent[i] == name then return true end
    end
    return false
end

local function _note_recent(name)
    _recent[#_recent + 1] = name
    _recent_set[name] = true
    if #_recent > RECENT_MAX then
        local dropped = table_remove(_recent, 1)
        if not _in_recent(dropped) then _recent_set[dropped] = nil end
    end
end

--- Weight one category: 0 if gated out or on its rarity floor, else its base weight times a
--- rises-with-dread tilt (all one-shots), boosted at night for animals, penalised if recent.
local function _category_weight(cat, score, hour, tg)
    local def = cat.def
    if #cat.sounds == 0 or tg < cat.next_ok or not _gate_ok(def) then return 0 end
    local weight = def.weight * (WEIGHT_FLOOR + score * score)
    if def.night and _is_night(hour) then weight = weight * 1.5 end
    if _recent_set[def.name] then weight = weight * 0.3 end
    return weight
end

--- Weighted-random category among those eligible now
local function _pick_category(score, hour, tg)
    local total = 0
    for _, cat in pairs(_cats) do
        cat._w = _category_weight(cat, score, hour, tg)
        total = total + cat._w
    end
    if total <= 0 then return nil end
    local roll = math_random() * total
    for _, cat in pairs(_cats) do
        roll = roll - cat._w
        if cat._w > 0 and roll <= 0 then return cat end
    end
    return nil
end

--- Shuffle-bag pick within a category: every sound plays once (random order) before any repeat; the
--- bag refills when empty. cat.bag holds the remaining indices. Returns the sound entry or nil.
local function _pick_sound(cat)
    local count = #cat.sounds
    if count == 0 then return nil end
    if count == 1 then return cat.sounds[1] end
    local bag = cat.bag
    if not bag or #bag == 0 then
        bag = {}
        for i = 1, count do bag[i] = i end
        cat.bag = bag
    end
    local pick = math_random(#bag)
    local idx = bag[pick]
    bag[pick] = bag[#bag]
    bag[#bag] = nil
    return cat.sounds[idx]
end

--- Place and fire one sound entry { path, min, max, height }. Spawn geometry is Anomaly's own
--- (sound_ambient.script:127-141): a random point in the source's min..max band, halved. The ONLY
--- change is HORROR_PULL - at peak dread it lands up to 25% closer. The sound's baked attenuation
--- (the source min/max) does the fade, so it stays audible; we never use max as the spawn position.
--- Louder as the score rises. Fire-and-forget.
local function _play(snd, score, cvol)
    local actor = db.actor
    if not actor then return end
    local mn, mx, h = snd[2], snd[3], snd[4]
    local pos = actor:position()
    local under = GetEvent("underground")
    local lo = under and mn or ((mx + mn) / 2)          -- vanilla near bound
    local dist = math_random(lo, mx) / 2                 -- vanilla spawn distance
    dist = dist * (1 - HORROR_PULL * score) * distance   -- horror bump + MCM knob
    local angle = math_rad(math_random(0, 359))
    local vec = vector():set(pos.x + math_cos(angle) * dist, pos.y + h, pos.z + math_sin(angle) * dist)
    local vol = _lerp(VOL_MIN, VOL_MAX, score) * base_volume * (cvol or 1) * opt_ambient_volume
    xsound.play(snd[1], { position = vec, volume = vol })
    as_debug.dbg("[PLAY] %s dist=%.1f (min=%.0f max=%.0f knob=%.2f) h=%.0f vol=%.2f score=%.2f",
        snd[1], dist, mn, mx, distance, h, vol, score)
end

-- ---- visual layer -------------------------------------------------------

--- Fire one subtle distortion pulse: acquire a cyclic effector, drive its factor to VIS_FACTOR
--- (engine-smoothed fade-in), then release after a short hold (fade-out) -> ~2-3s total, self-ending.
local function _vis_pulse()
    if not xpp then return end
    local ppe = VIS_PPE[math_random(#VIS_PPE)]
    if _vis.handle and xpp.is_active(_vis.handle) then xpp.release(_vis.handle) end
    local handle = xpp.acquire(ppe, { cyclic = true, smoothing = VIS_SMOOTH })
    _vis.handle = handle
    if handle then
        xpp.set_target(handle, VIS_FACTOR, VIS_SMOOTH)
        CreateTimeEvent("as_effect", "vis_release", VIS_HOLD_S, function()
            if xpp.is_active(handle) then xpp.release(handle) end
            if _vis.handle == handle then _vis.handle = nil end
            return true
        end)
    end
    if as_debug.on() then as_debug.dbg("visual pulse %s factor=%.2f", ppe, VIS_FACTOR) end
end

--- INSANE-only visual gate: require sustained INSANE (dwell), then once per cooldown roll >=50% to
--- pulse. Leaving INSANE resets the dwell so it must be re-earned.
local function _visual_tick(tg)
    if not (visuals_on and xpp) or ctx.grade < GRADE.INSANE then
        _vis.insane_since = nil
        return
    end
    if not _vis.insane_since then _vis.insane_since = tg; return end
    if tg < _vis.next_ok or tg - _vis.insane_since < VIS_DWELL_MS then return end
    _vis.next_ok = tg + VIS_COOLDOWN_MS
    if math_random() < VIS_CHANCE then _vis_pulse() end
end

-- ---- emission (jittered self-schedule, driven by the director timer) --------------------

--- Emit one one-shot if the jittered spacing has elapsed. Density is CONSTANT and dread-
--- INDEPENDENT: the next play is armed at math.random(SPACE_MIN_MS, SPACE_MAX_MS) (scaled by the MCM
--- rarity knob), never by the score. Dread drives only SELECTION - below DREAD_ON nothing plays.
--- Reads the cached ctx.dread (refreshed by the director tick); does not score here. Returns nothing.
local function _emit_tick(tg, hour)
    as_debug.dbg("[EMIT] enter tg=%d next_play=%d score=%.2f", tg, _next_play, ctx.dread)
    _visual_tick(tg)
    if tg < _next_play then return end
    _next_play = tg + math_floor(math_random(SPACE_MIN_MS, SPACE_MAX_MS) * math_max(rarity, 0.1))
    as_debug.dbg("[EMIT] spacing elapsed, score=%.2f gate=%.2f", ctx.dread, DREAD_ON)
    if ctx.dread < DREAD_ON then return end
    local cat = _pick_category(ctx.dread, hour, tg)
    if not cat then return end
    local snd = _pick_sound(cat)
    if snd then
        _play(snd, ctx.dread, _cat_vol[cat.def.name])
        cat.next_ok = tg + cat.def.floor
        _note_recent(cat.def.name)
        _last_play = snd[1]
        _play_at = tg
    end
end

-- ---- base ambient hook (own update_ambient; a LOGGING observer, not the veto) --------
-- The muting is STATIC: the DLTX overlay mod_sound_channels_alifespooks.ltx (tools/merge.py deploy)
-- removes our own sounds from the base ambient channels at config load, so the base never doubles the
-- director's copy - deterministic, and it holds even if this hook loses the slot. This hook stays only
-- as an OBSERVER: it owns the vanilla dynamic-ambient slot and runs a faithful clone of
-- sound_ambient.update_ambient (sound_ambient.script:86) that replays the base ambient (the composed
-- config already has our sounds removed) and LOGS each play at DEBUG, so the soundscape stays traceable.
-- No filtering here - the DLTX overlay already did it.
local _base = { chan = {}, idx = 0, tot = 0, hour = nil }

--- Load one base channel's sounds + settings. The composed config already has our own sounds removed by
--- the DLTX overlay, so there is no filtering here - we replay what the base would play. nil if empty.
local function _base_channel(ch, ini_snd)
    local raw = parse_list(ini_snd, ch, "sounds")
    if not raw or #raw == 0 then return nil end
    return { name = ch, sounds = raw,
        max_dist = ini_snd:r_float_ex(ch, "max_distance") or 100,
        min_dist = ini_snd:r_float_ex(ch, "min_distance") or 1,
        height   = ini_snd:r_float_ex(ch, "height") or 0,
        indoor   = ini_snd:r_bool_ex(ch, "indoor") or false,
        periods  = { ini_snd:r_float_ex(ch, "period0") or 10, ini_snd:r_float_ex(ch, "period1") or 15,
                     ini_snd:r_float_ex(ch, "period2") or 20, ini_snd:r_float_ex(ch, "period3") or 25 } }
end

--- Clone of sound_ambient.reset_settings: load the base channels for (level, ambient). The composed
--- config already has our sounds removed by the DLTX overlay, so this is a faithful replay of the rest.
local function _base_reset(level_name, ambient)
    _base.chan, _base.idx, _base.tot = {}, 0, 0
    if not (level_name and ambient and ambient ~= "") then return end
    local ini_lvl = ini_file("environment\\ambients\\" .. level_name .. ".ltx")
    if not ini_lvl then return end
    local channels = parse_list(ini_lvl, ambient, "sound_channels_dynamic")
    if #channels == 0 then return end
    local cached, ini_snd = {}, ini_file(CHANNELS_FILE)
    for i = 1, #channels do
        local ch = channels[i]
        local entry = (not cached[ch]) and ini_snd:section_exist(ch) and _base_channel(ch, ini_snd)
        cached[ch] = true
        if entry then
            _base.tot = _base.tot + 1
            _base.chan[_base.tot] = entry
        end
    end
end

--- Play one base channel's sound through xsound.play (the wrapped, engine-owned one-shot: no raw
--- sound_object here), using the vanilla position and indoor/underground volume rule. Logs at DEBUG
--- (the TestZone baseline log, absorbed here now that we own the slot); no-op when off.
local function _base_fire(ch, tg)
    local actor = db.actor
    if not actor then return end
    local period = ch.periods[math_random(4)]
    ch.next = tg + period
    local file = ch.sounds[math_random(#ch.sounds)]
    _base_last, _base_at = tostring(file), tg
    local inside, underground = GetEvent("current_safe_cover"), GetEvent("underground")
    local pos = actor:position()
    local max_dist = ch.max_dist
    local min_dist = underground and ch.min_dist or ((max_dist + ch.min_dist) / 2)
    if min_dist > max_dist then min_dist = max_dist end
    local dist = math_random(min_dist, max_dist) / 2
    local angle = math_rad(math_random(0, 359))
    local vol
    if underground or inside then vol = ch.indoor and 1 or 0.3
    else vol = ch.indoor and 0 or 1 end
    vol = vol * opt_ambient_volume
    local vec = vector():set(pos.x + math_cos(angle) * dist, pos.y + ch.height, pos.z + math_sin(angle) * dist)
    xsound.play(file, { position = vec, volume = vol })
    as_debug.dbg("[BASE] lvl=%s ch=%s file=%s dist=%.1f max=%.0f per=%.0f vol=%.2f ug=%s inside=%s pos=%.0f,%.0f,%.0f",
        level.name(), ch.name, tostring(file), dist, max_dist, period, vol,
        tostring(not not underground), tostring(not not inside), pos.x, pos.y, pos.z)
end

--- The base-ambient OBSERVER on the vanilla update_ambient slot: a faithful clone that advances the
--- base round-robin and replays it (the composed config already has our sounds removed by the DLTX
--- overlay), logging each play at DEBUG. No director, no injection, no muting - the overlay does that.
local function update_ambient_owned()
    ResetTimeEvent("sound_channels", "update_ambient", BASE_TICK_S)
    if not (level.present() and db.actor) then return false end
    local tg = time_global()
    local hour = level.get_time_hours()
    as_debug.dbg("[LOOP] base tick tg=%d base_tot=%d base_hour=%s", tg, _base.tot, tostring(_base.hour))
    -- base ambient round-robin (faithful replay): reset on hour change, else advance one channel
    if hour ~= _base.hour then
        _base.hour, _base.idx = hour, 0
        local wm = level_weathers and level_weathers.get_weather_manager()
        _base_reset(level.name(), wm and wm:get_curr_ambient())
    elseif _base.tot > 0 then
        _base.idx = _base.idx + 1
        if _base.idx > _base.tot then _base.idx = 1 end
        local ch = _base.chan[_base.idx]
        if not ch.next then ch.next = tg + math_random(1, ch.periods[math_random(4)] + 1)
        elseif ch.next <= tg then _base_fire(ch, tg) end
    end
    return false
end

--- Own the update_ambient slot with our base-ambient observer. Install is Remove-then-Create (the base
--- slot dispatches by stored value, so a bare re-add no-ops; Remove clears whatever vanilla put there,
--- Create installs ours - robust to registration order). If another script wins the slot back, the
--- muting still holds (it is the static DLTX overlay); only the base-ambient trace is lost.
local function _apply_owned()
    _base.hour, _base.idx = nil, 0
    RemoveTimeEvent("sound_channels", "update_ambient")
    CreateTimeEvent("sound_channels", "update_ambient", 1, update_ambient_owned)
    as_debug.dbg("[BASE] installed base-ambient observer on the update_ambient slot")
end

-- ---- director timer (OUR OWN slot; never the base update_ambient slot) --------------------
-- The director runs on its own private time-event, so it can never lose a slot race to the base
-- sound_ambient. Each tick refreshes the dread score (every CTX_PERIOD, feeding the HUD rows) and
-- runs the jittered 5-15s emission of our own sounds.
local _ctx_next = 0
local function _director_tick()
    ResetTimeEvent("as_effect", "dread_director", BASE_TICK_S)
    if not (level.present() and db.actor) then return false end
    local tg = time_global()
    local hour = level.get_time_hours()
    as_debug.dbg("[DIR] tick tg=%d ctx_next=%d", tg, _ctx_next)
    if tg >= _ctx_next then _score(db.actor, hour); _ctx_next = tg + CTX_PERIOD end
    _emit_tick(tg, hour)
    return false
end

-- ---- lifecycle ----------------------------------------------------------

local function refresh()
    rarity             = as_mcm.get_config("rarity") or 1
    distance           = as_mcm.get_config("distance") or 1
    base_volume        = as_mcm.get_config("vol_global") or 1
    opt_ambient_volume = (ui_options and ui_options.get("sound/environment/ambient_volume")) or 1
    for _, def in ipairs(CATEGORIES) do
        _cat_vol[def.name] = as_mcm.get_config("vol_" .. def.name) or 1
    end
    local wanted = as_mcm.get_config("visuals")
    visuals_on = (wanted == nil) or wanted
end

--- Load banks and arm the tick. Runs on every actor_on_first_update, so a save load re-arms the
--- (load-cleared) time event. Inert without xlibs (xsound), the play primitive.
local function _on_first_update()
    refresh()
    if not xsound then as_debug.warn("as_effect: xlibs (xsound) absent - dread director inert"); return end
    _load_channels()
    _next_play = 0
    _ctx_next = 0
    if _vis.handle and level then level.remove_pp_effector(_vis.handle) end
    _vis.insane_since, _vis.next_ok, _vis.handle = nil, 0, nil
    _apply_owned()
    RemoveTimeEvent("as_effect", "dread_director")
    CreateTimeEvent("as_effect", "dread_director", BASE_TICK_S, _director_tick)
    as_debug.info("as_effect: armed. base-ambient observer on update_ambient; director on dread_director slot")
end

--- The dread readout rows ({label, value}: grade/score, place, playing, each term, gates) for the HUD.
--- The score block is rebuilt by _score every CTX_PERIOD (~3s). The two sound lines (SPOOK row 2, BASE
--- row 5) are refreshed HERE on every HUD read, so "what's playing" tracks the audio with no lag and no
--- score recompute - O(1), no engine reads. _last_play/_play_at are set by the director at fire time.
function get_hud_rows()
    if _rows[2] and _rows[5] then
        local tg = time_global()
        local playing = _play_at > 0 and (tg - _play_at) < PLAY_WINDOW_MS
        local base_playing = _base_at > 0 and (tg - _base_at) < PLAY_WINDOW_MS
        _rows[2] = { _last_play, "", "", playing and "play" or "stop" }
        _rows[5] = { _base_last, "", "", base_playing and "play" or "stop" }
    end
    return _rows
end

function on_game_start()
    RegisterScriptCallback("actor_on_first_update",      _on_first_update)
    RegisterScriptCallback("on_option_change",           refresh)
    RegisterScriptCallback("mcm_option_restore_default", refresh)
end
