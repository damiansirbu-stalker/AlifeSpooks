--- as_test: AlifeSpooks dev harness. Console helpers plus the atmosphere probe collector.
--- Console helpers are inert until called (run_string as_test.dev_setup()). as_test.snapshot() is
--- the coordinate/atmosphere probe, invoked from the PDA tab inspector (ui_as_player_tab's Snapshot
--- button); it never fires for players. INSERT opens that PDA tab (pda_dynamic_tabs.open_tab).

as_test = as_test or {}

local pairs, tostring, ipairs, pcall, tonumber = pairs, tostring, ipairs, pcall, tonumber
local table_concat, table_sort, string_format = table.concat, table.sort, string.format
local RegisterScriptCallback, GetEvent, alife_object = RegisterScriptCallback, GetEvent, alife_object
local news_manager, ui_options, game_fast_travel = news_manager, ui_options, game_fast_travel

local function _tip(msg)
    local actor = db.actor
    if actor then news_manager.send_tip(actor, msg, nil, nil, 4000) end
end

-- ---- dev helpers ----------------------------------------------------------

--- Unlock all fast-travel waypoints
function as_test.unlock_travel()
    ui_options.set("gameplay/fast_travel/state", 2)
    game_fast_travel.update_settings()
    _tip("fast travel: all waypoints unlocked")
end

--- Give money (default 100000)
function as_test.give_money(amount)
    local actor = db.actor
    if not actor then return end
    actor:give_money(amount or 100000)
    _tip("money given")
end

--- Disable the northern psy fields so Radar / Red Forest are walkable
function as_test.open_north()
    local actor = db.actor
    if not actor then return end
    actor:give_info_portion("bar_deactivate_radar_done")
    actor:give_info_portion("yan_labx16_switcher_primary_off")
    _tip("north opened: psy fields off (reload the level to apply)")
end

--- One-shot dev setup: travel, money, north
function as_test.dev_setup()
    as_test.unlock_travel()
    as_test.give_money(100000)
    as_test.open_north()
end

-- ---- sound playback probe (empirical: which call actually makes sound?) ----
-- A confirmed MONO sound. Run each from the console and report what you HEAR:
--   run_string as_test.snd(1)       -- play_no_feedback 2D, full volume: does the FILE play at all?
--   run_string as_test.snd(2)       -- play_no_feedback 3D at 5m: the director's CURRENT path
--   run_string as_test.snd(3)       -- play_at_pos 3D at 5m: vanilla's method, no kept reference
--   run_string as_test.snd(4)       -- play_at_pos 3D at 5m + kept reference: vanilla exact
--   run_string as_test.snd(3, 50)   -- any method at a chosen distance (attenuation check)
-- SND_OURS: one of our shipped sounds; SND_VANILLA: a known-good loud vanilla sound for the A/B check.
local SND_OURS    = "zs\\spook\\1"
local SND_VANILLA = "anomaly\\emi_blowout"
-- Fire the play 3s AFTER the call, so it happens during live gameplay, not while the console is open
-- (an open console pauses the game and paused sounds never sound). Close the console after running it.
function as_test.snd(method, dist)
    dist = dist or 5
    local path = (method == 5) and SND_VANILLA or SND_OURS
    RemoveTimeEvent("as_snd", "play")
    CreateTimeEvent("as_snd", "play", 3, function()
        local actor = db.actor
        if not actor then return true end
        local pos = actor:position()
        local vec = vector():set(pos.x + dist, pos.y, pos.z)
        local snd = sound_object(path)
        if not snd then _tip("snd: sound_object NIL for " .. path); return true end
        if method == 1 then
            snd:play_no_feedback(actor, sound_object.s2d, 0, vector():set(0, 0, 0), 1.0, 1.0)
        elseif method == 2 then
            snd:play_no_feedback(actor, sound_object.s3d, 0, vec, 1.0, 1.0)
        else
            snd:play_at_pos(actor, vec); snd.volume = 1.0
            if method ~= 3 then as_test._kept = snd end
        end
        _tip("PLAYED m" .. tostring(method) .. "  " .. path)
        return true
    end)
    _tip("m" .. tostring(method) .. " fires in 3s - CLOSE the console now")
end

-- ---- corpus smoke test (audition every shipped sound, spaced by its own length) ----
-- Plays every sound in as_manifest one after another at-ear (2D, full volume), each spaced by its
-- measured duration + a gap so a long drone never overlaps the next. Play and length both go through
-- xsound (wrapped), never a raw sound_object. Run/stop from the console (close it after):
--   run_string as_test.smoke()            -- the whole corpus, category order
--   run_string as_test.smoke("drone")     -- one category only
--   run_string as_test.smoke_stop()
local SMOKE_GAP_MS = 700
local _smoke = { list = nil, i = 0, last = nil, paused = false, dist = nil }

--- Flatten as_manifest to a { cat, path } list in sorted-category order (optionally one category).
local function _smoke_flat(only_cat)
    local out, cats = {}, (as_manifest and as_manifest.categories) or {}
    local names = {}
    for cat in pairs(cats) do
        if not only_cat or cat == only_cat then names[#names + 1] = cat end
    end
    table_sort(names)
    for _, cat in ipairs(names) do
        local sounds = cats[cat]
        for i = 1, #sounds do out[#out + 1] = { cat = cat, path = sounds[i][1] } end
    end
    return out
end

--- Play one item. _smoke.dist set -> spawn it that many metres from the actor as a 3D one-shot, so a
--- MONO sound attenuates with distance but a STEREO one does not (OpenAL only spatialises mono) - the
--- stereo audit by ear. No dist -> 2D at-ear, full volume, the quality audition.
local function _smoke_play(item)
    if not (item and db.actor and xsound) then return end
    local opts = { volume = 1.0 }
    if _smoke.dist then
        local pos = db.actor:position()
        opts.position = vector():set(pos.x + _smoke.dist, pos.y, pos.z)
    end
    xsound.play(item.path, opts)
end

--- Play list index i (clamped 1..n), make it current, tip its identity. The one place a sound plays.
local function _smoke_at(i)
    local total = _smoke.list and #_smoke.list or 0
    if total == 0 then _tip("audit: no sounds"); return end
    if i < 1 then i = 1 elseif i > total then i = total end
    _smoke.i = i
    local item = _smoke.list[i]
    _smoke_play(item)
    local dur = (xsound.length and xsound.length(item.path)) or 0
    _smoke.last = { i = i, total = total, cat = item.cat, path = item.path }
    _tip(string_format("audit %d/%d  %s  (%s %dms)%s", i, total, item.path, item.cat, dur,
        _smoke.dist and ("  @" .. _smoke.dist .. "m") or ""))
end

--- Auto-advance step: play next, re-arm for its duration + a gap. Paused -> hold. Deregisters at end.
local function _smoke_step()
    if _smoke.paused then ResetTimeEvent("as_smoke", "step", 0.3); return false end
    local nexti = (_smoke.i or 0) + 1
    if not (_smoke.list and _smoke.list[nexti] and db.actor and xsound) then _tip("smoke: done"); return true end
    _smoke_at(nexti)
    local dur = (xsound.length and xsound.length(_smoke.list[nexti].path)) or 2000
    ResetTimeEvent("as_smoke", "step", (dur + SMOKE_GAP_MS) / 1000)
    return false
end

--- MANUAL audition (the controls). Step with PgDn=next / PgUp=prev; DELETE marks the current one suspect.
--- dist -> positioned stereo audit (mono fades, stereo stays loud); omit -> at-ear quality pass.
---   run_string as_test.audit()           -- whole corpus, start at 1
---   run_string as_test.audit("mutant")   -- one category
---   run_string as_test.audit(nil, 40)    -- positioned 40m
function as_test.audit(only_cat, dist)
    _smoke.list, _smoke.i, _smoke.last, _smoke.paused = _smoke_flat(only_cat), 0, nil, false
    _smoke.dist = tonumber(dist)
    RemoveTimeEvent("as_smoke", "step")
    if #_smoke.list == 0 then _tip("audit: no sounds"); return end
    _tip(string_format("audit: %d sounds%s  PgDn=next PgUp=prev DEL=mark", #_smoke.list,
        _smoke.dist and (" @" .. _smoke.dist .. "m") or ""))
    _smoke_at(1)
end

--- Step the manual audition (keys PgDn/PgUp map here; also callable from console). Each kills any auto timer.
function as_test.next() RemoveTimeEvent("as_smoke", "step"); _smoke_at((_smoke.i or 0) + 1) end
function as_test.prev() RemoveTimeEvent("as_smoke", "step"); _smoke_at((_smoke.i or 2) - 1) end
function as_test.replay() if _smoke.last then _smoke_play(_smoke.list[_smoke.last.i]) end end

--- AUTO audition: play every sound one after another, spaced by its own length. DELETE marks; PgDn/PgUp
--- take over manually. run_string as_test.smoke() / as_test.smoke("drone") / as_test.smoke(nil, 40)
function as_test.smoke(only_cat, dist)
    _smoke.list, _smoke.i, _smoke.paused, _smoke.dist = _smoke_flat(only_cat), 0, false, tonumber(dist)
    if #_smoke.list == 0 then _tip("smoke: no sounds"); return end
    _tip(string_format("smoke: %d sounds%s - close the console; DELETE=mark", #_smoke.list,
        _smoke.dist and (" @" .. _smoke.dist .. "m") or ""))
    RemoveTimeEvent("as_smoke", "step")
    CreateTimeEvent("as_smoke", "step", 1, _smoke_step)
end

function as_test.smoke_stop()
    _smoke.list = nil
    RemoveTimeEvent("as_smoke", "step")
    _tip("audit: stopped")
end

--- Pause / resume the auto audition.
function as_test.smoke_pause()  _smoke.paused = true;  _tip("audit: paused")  end
function as_test.smoke_resume() _smoke.paused = false; _tip("audit: resumed") end

--- MARK the current sound SUSPECT -> alifespooks_probe.log (the reject list). Tap DELETE, or call with a
--- note. Cross-reference the marked cat/index against provenance.tsv after.
function as_test.mark(note)
    local cur = _smoke.last
    if not cur then _tip("audit: nothing to mark"); return end
    if xlog then
        local log = xlog.get_logger("AS_PROBE", { outfile = "alifespooks_probe.log", buffer_size = 1 })
        log.info("SUSPECT %d/%d\t%s\t%s\t%s", cur.i, cur.total, cur.cat, cur.path, tostring(note or ""))
        log.flush()
    end
    _tip(string_format("SUSPECT %d  %s", cur.i, cur.path))
end

-- ---- atmosphere probe collector -------------------------------------------

local _log = nil
local function _logger()
    if not _log and xlog then
        _log = xlog.get_logger("AS_PROBE", { outfile = "alifespooks_probe.log", buffer_size = 1 })
    end
    return _log
end

local function _count(tbl)
    local total = 0
    for _ in pairs(tbl or {}) do total = total + 1 end
    return total
end

local function _format_pairs(tbl)
    local parts = {}
    for k, v in pairs(tbl) do parts[#parts + 1] = k .. ":" .. v end
    table_sort(parts)
    return table_concat(parts, ", ")
end

local function _add_online(obj, species)
    if xcreature.is_mutant(obj) then
        local sp = xcreature.get_mutant_species(obj) or "unknown"
        species[sp] = (species[sp] or 0) + 1
        return 0
    end
    return xcreature.is_stalker(obj) and 1 or 0
end

local function _snap_combat(log)
    local fw = xr_combat_ignore and xr_combat_ignore.fighting_with_actor_npcs
    log.info("COMBAT fighting_with_actor_npcs=%d", fw and _count(fw) or -1)
end

local function _snap_online(log, actor_id)
    local species, humans = {}, 0
    for id, st in pairs(db.storage) do
        local obj = (id ~= actor_id) and st and st.object
        if obj then humans = humans + _add_online(obj, species) end
    end
    log.info("ONLINE-NEAR humans=%d mutants={%s}", humans, _format_pairs(species))
end

local function _is_bright_day(hour, weather, rain)
    local wl = weather:lower()
    local overcast = wl:find("storm") or wl:find("rain") or wl:find("fog") or wl:find("cloud") or wl:find("dark") or wl:find("partly")
    return (hour >= 7 and hour < 19) and (rain < 0.1) and not overcast and true or false
end

local function _snap_place(log, apos)
    local enclosed = xcombat.is_indoor(apos)
    local static_ug = (xcombat.INDOOR_LEVELS and xcombat.INDOOR_LEVELS[level.name()]) and true or false
    log.info("PLACE enclosed=%s static_underground=%s pos=%.0f,%.0f,%.0f",
        tostring(enclosed), tostring(static_ug), apos.x, apos.y, apos.z)
    if not level.present() then return end
    local hour = level.get_time_hours()
    local weather = tostring(level.get_weather())
    local rain = level.rain_factor()
    local sun = (not enclosed) and _is_bright_day(hour, weather, rain) and true or false
    log.info("ATMO hour=%d weather=%s rain=%.2f sun_visible=%s safe_cover=%s underground_event=%s",
        hour, weather, rain, tostring(sun),
        tostring(GetEvent("current_safe_cover") and true or false),
        tostring(GetEvent("underground") and true or false))
end

local function _add_smart_species(smart, level_id, species)
    if xlevel.get_level_id(smart) ~= level_id then return end
    local squads = xsmart.get_smart_squads(smart.id)
    if not squads then return end
    for sqid in pairs(squads) do
        local sp = xcreature.get_mutant_species(sqid)
        if sp then species[sp] = (species[sp] or 0) + 1 end
    end
end

local function _snap_level_species(log, level_id)
    local species = {}
    for smart in xsmart.smart_iter() do _add_smart_species(smart, level_id, species) end
    log.info("LEVEL-SPECIES {%s}", _fmt(species))
end

-- ---- crystallization probes (raw numbers to fit the director thresholds) ----

-- Raw roof/wall hit-distances from xcombat.get_enclosure PLUS the is_indoor decision breakdown, so a
-- snapshot in a real room names WHICH check fails: roof ray missing (roof=-1) or too high (>4m), or the
-- wall rays not striking within 3m. roof=-1 -> roof up-ray never hit the ceiling mesh; walls all -1 ->
-- the four side-rays never hit a wall (interior walls not in the baked static mesh, or probe height off).
local function _snap_enclosure(log, apos)
    local enc = xcombat.get_enclosure(apos)
    if not enc then log.info("ENCLOSURE-RAW none | is_indoor=%s", tostring(xcombat.is_indoor(apos))); return end
    local walls = enc.walls
    local roof_ok = enc.roof ~= nil and enc.roof <= 4
    local near = 0
    for i = 1, 4 do if walls[i] and walls[i] <= 3 then near = near + 1 end end
    log.info("ENCLOSURE-RAW roof=%.1f walls=%.1f,%.1f,%.1f,%.1f nearest=%.1f count=%d | roof_ok(<=4m)=%s walls_within_3m=%d indoor=%s",
        enc.roof or -1, walls[1] or -1, walls[2] or -1, walls[3] or -1, walls[4] or -1,
        enc.nearest_wall or -1, enc.wall_count,
        tostring(roof_ok), near, tostring(xcombat.is_indoor(apos)))
end

-- Nearest smart id/name/distance + props, to fit the place-identity distance gate.
local function _snap_smart(log, apos)
    local ns = smart_terrain and smart_terrain.nearest_to_actor_smart
    if ns and ns.id then
        local smart = alife_object(ns.id)
        if smart then
            log.info("SMART id=%s name=%s dist=%.1f lair=%s base=%s",
                tostring(ns.id), smart:name(), ns.dist or -1,
                tostring(xsmart.is_lair(smart)), tostring(xsmart.is_base(smart)))
        else
            log.info("SMART id=%s dist=%.1f unresolved", tostring(ns.id), ns.dist or -1)
        end
    else
        log.info("SMART none")
    end
    -- base detection: distance to the nearest SELLER NPC (not the smart center), within 80m
    local owner, sd = xsmart.base_owner_near(apos, 80)
    log.info("BASE seller_near owner=%s dist=%s (nearest trader/medic/mechanic NPC <=80m)",
        tostring(owner or "-"), owner and string_format("%.0f", sd) or "-")
end

-- Bump a { b25, b50, all } triple by one for a distance.
local function _bump(triple, dist)
    triple.all = triple.all + 1
    if dist < 50 then triple.b50 = triple.b50 + 1 end
    if dist < 25 then triple.b25 = triple.b25 + 1 end
end

-- Classify one online object into the human or mutant band triple.
local function _band_one(obj, apos, humans, mutants)
    local dist = apos:distance_to(obj:position())
    if xcreature.is_stalker(obj) then _bump(humans, dist)
    elseif xcreature.is_mutant(obj) then _bump(mutants, dist) end
end

-- Online creature counts in distance bands, to fit the local-presence radius.
local function _snap_bands(log, actor, apos)
    local actor_id = actor:id()
    local humans = { b25 = 0, b50 = 0, all = 0 }
    local mutants = { b25 = 0, b50 = 0, all = 0 }
    for id, st in pairs(db.storage) do
        local obj = (id ~= actor_id) and st and st.object
        if obj then _band_one(obj, apos, humans, mutants) end
    end
    log.info("PRESENCE-BANDS humans<25=%d <50=%d all=%d | mutants<25=%d <50=%d all=%d",
        humans.b25, humans.b50, humans.all, mutants.b25, mutants.b50, mutants.all)
end

-- Actor height above the AI-mesh ground, to explore basement/floor feasibility.
local function _snap_vertical(log, actor, apos)
    local lvid = actor:level_vertex_id()
    local gy = -1
    if lvid and level.vertex_position then
        local gp = level.vertex_position(lvid)
        if gp then gy = gp.y end
    end
    log.info("VERTICAL actor_y=%.1f ai_ground_y=%.1f y_above_ground=%.1f", apos.y, gy, apos.y - gy)
end

-- Run one check under the modded-exe microsecond timer, logging its duration inline through `sink`.
-- Noop timing when profile_timer is absent. Lets the snapshot show each check's real cost in-game.
-- @cost O(1) wrapper | 1 profile_timer ctor + start/stop/time around the wrapped check
local function _timed(sink, label, fn)
    local timer = profile_timer and profile_timer()
    if timer then timer:start() end
    fn()
    if timer then timer:stop(); sink.info("  [%7.0f us] %s", timer:time(), label) end
end

--- Log one atmosphere snapshot with a note. Cheap; run on demand only, never per frame.
--- @safety pcall: the per-check sink wraps string.format on diagnostic args, see doc/library/modding/pcall-safety.md
function as_test.snapshot(note)
    local log = _logger()
    local actor = db.actor
    if not (log and xcreature and xsmart and xlevel and xcombat and actor and level.present()) then return end
    -- sink: full diagnostic detail goes to the LOG only; the on-screen tip is a compact, aligned
    -- override-record block (note + level + coordinate), ready to paste into the per-map override LTX.
    local sink = { info = function(fmt, ...)
        local ok, msg = pcall(string_format, fmt, ...)
        log.info("%s", ok and msg or tostring(fmt))
    end }
    sink.info("=== SNAPSHOT note=[%s] level=%s ===", tostring(note or "?"), tostring(level.name()))
    local apos = actor:position()
    _timed(sink, "combat",         function() _snap_combat(sink) end)
    _timed(sink, "online-near",    function() _snap_online(sink, actor:id()) end)
    _timed(sink, "place",          function() _snap_place(sink, apos) end)
    _timed(sink, "level-species",  function() _snap_level_species(sink, xlevel.get_actor_level_id()) end)
    _timed(sink, "enclosure",      function() _snap_enclosure(sink, apos) end)
    _timed(sink, "smart+base_near",function() _snap_smart(sink, apos) end)
    _timed(sink, "presence-bands", function() _snap_bands(sink, actor, apos) end)
    _timed(sink, "vertical",       function() _snap_vertical(sink, actor, apos) end)
    log.flush()
    news_manager.send_tip(actor, string_format(
        "SPOT  [%s]\nlevel   %s\npos     %.1f  %.1f  %.1f\nradius  ?\n(detail -> alifespooks_probe.log)",
        tostring(note or "?"), tostring(level.name()), apos.x, apos.y, apos.z), nil, nil, 20000)
end

-- ---- probe stepper keys (smoke audit; debug-gated) ------------------------

local PGUP_KEY, PGDN_KEY, DELETE_KEY = 201, 209, 211
local function _on_key(key)
    if _smoke.list then                              -- INSERT is now the AlifeSpooks PDA-tab shortcut
        if key == PGDN_KEY then as_test.next()
        elseif key == PGUP_KEY then as_test.prev()
        elseif key == DELETE_KEY then as_test.mark() end
    end
end

-- ---- monster rank probe (does se:rank() tier cleanly at runtime?) ----------
-- Spawn one of each variant at the actor and log its server rank. sim:create on a MISSING section
-- CTDs in C++ (pcall cannot catch that), so section_exist GUARDS every create - guard-first, no pcall.
-- Run in god mode:  run_string as_test.probe_zoo()  -> alifespooks_probe.log
local ZOO = {
    "tushkano_normal", "rat_normal", "dog_normal", "boar_normal", "flesh_normal",
    "snork_normal", "bloodsucker_normal", "pseudodog_normal", "psy_dog_normal", "fracture_normal",
    "zombie_normal", "psysucker_normal",
    "gigant_normal", "m_controller_normal", "burer_normal", "chimera_normal", "bibliotekar_normal",
}

-- Spawn one existing variant and log its runtime server rank + species (guard-clause on missing section)
local function _probe_spawn(sec, sim, pos, lvid, gvid, log)
    if not ini_sys:section_exist(sec) then log.info("sec=%s MISSING-skip", sec); return end
    local se = sim:create(sec, pos, lvid, gvid)
    log.info("sec=%s species=%s rank=%s", sec,
        tostring(se and xcreature.get_mutant_species(se.id) or "-"),
        tostring(se and se:rank() or "nil"))
end

--- Spawn each ZOO variant that exists and log its runtime server rank + species
function as_test.probe_zoo()
    local log = _logger()
    local actor = db.actor
    local sim = alife()
    if not (log and actor and sim and xcreature and ini_sys) then return end
    local pos, lvid, gvid = actor:position(), actor:level_vertex_id(), actor:game_vertex_id()
    log.info("=== ZOO RANK PROBE ===")
    for i = 1, #ZOO do _probe_spawn(ZOO[i], sim, pos, lvid, gvid, log) end
    log.flush()
    _tip("zoo rank probe -> alifespooks_probe.log")
end

function on_game_start()
    RegisterScriptCallback("on_key_press", _on_key)
end
