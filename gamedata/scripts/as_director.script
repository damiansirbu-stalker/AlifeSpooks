--- as_director: dread director v2. One 100ms tick round-robins a sensor board (environment, stalkers,
--- monsters, anomalies, time), SELECT gates categories by map + environment + presence, a two-level
--- shuffle-bag picks, and grounded additive dread drives spawn distance and emission frequency, never
--- volume. Man and monster collapse to one low/med/high power (se:rank), so threat reads both with one
--- rule. A separate observer owns the vanilla update_ambient slot only to replay+LOG the base ambient;
--- the base's copies of our sounds are removed statically by the DLTX overlay.

local math_random, math_rad = math.random, math.rad
local math_cos, math_sin = math.cos, math.sin
local math_max, math_floor = math.max, math.floor
local ini_file, parse_list = ini_file, parse_list
local time_global, vector, GetEvent = time_global, vector, GetEvent
local string_format, RegisterScriptCallback = string.format, RegisterScriptCallback
local table_remove, table_concat = table.remove, table.concat
local pairs, ipairs, tostring = pairs, ipairs, tostring

local MAP_FILE      = "scripts\\as_static_map.ltx"
local CHANNELS_FILE = "environment\\sound_channels.ltx"
local SEC_DEFAULT   = "default"

-- Category runtime attributes: env (enclosure states it may play in) + need (a live gate). The MAP list
-- (as_static_map.ltx) decides per-level eligibility; THIS decides enclosure + need, keyed by name.
-- env flags out/ind/ug = outdoor/indoor/underground; labs satisfies ug. need "mutant"|"human"|"anomaly"|nil.
local CAT = {
    mutant                = { out = true, ind = true, ug = true, need = "mutant" },
    mutant_ambient_forest = { out = true },
    mutant_ambient_swamp  = { out = true },
    mutant_ambient_urban  = { out = true },
    mutant_ambient_field  = { out = true },
    spook       = { out = true, ind = true, ug = true },
    scream      = { out = true, ind = true, ug = true },
    drone       = { out = true, ind = true, ug = true, need = "anomaly" },
    dark_signal = { out = true, ind = true, ug = true },
    industrial  = { out = true, ind = true, ug = true },
    structural  = { ind = true, ug = true },
    labs        = { ind = true, ug = true },
    drip        = { ug = true },
    wind        = { out = true },
    foliage     = { out = true },
    wildlife    = { out = true },
    urban       = { out = true },
    gunfire     = { out = true, need = "human" },
    rats        = { ind = true, ug = true },
    bats        = { out = true, ug = true },
}

-- Shared power scale; man (character_rank) and monster (se:rank) both map to one of these tokens.
local POWER = { none = 0, low = 1, med = 2, high = 3 }
-- Rank cut points (see doc/library/modding/npc-strength-evaluation.md; probe-verified cross-install).
local STALKER_MED, STALKER_HIGH = 9000, 14500
local MONSTER_MED, MONSTER_HIGH = 6, 17

-- The sci-fi lab levels, split off from generic underground (tunnels/mines/bunker) for the labs environment.
local LAB_LEVELS = {
    labx8 = true, l04u_labx18 = true, l08u_brainlab = true,
    l13u_warlab = true, l12u_sarcofag = true, l12u_control_monolith = true,
}

-- Per-LEVEL lore dread (the place's own baseline; coordinate overrides supersede this later, n114).
local LORE_DEFAULT = 0.15
local LORE_LEVEL = {
    l12u_control_monolith = 0.50, l10_radar = 0.45, l08u_brainlab = 0.45, l10u_bunker = 0.45,
    l08_yantar = 0.40, l10_red_forest = 0.40, l12u_sarcofag = 0.40, l12_stancia_2 = 0.40,
    l04u_labx18 = 0.35, l03u_agr_underground = 0.35, l13u_warlab = 0.35, labx8 = 0.35,
    l12_stancia = 0.35, l11_hospital = 0.35,
    jupiter_underground = 0.30, l13_generators = 0.30, l09_deadcity = 0.30, l10_limansk = 0.30,
    l11_pripyat = 0.30, pripyat = 0.30,
    k00_marsh = 0.20, zaton = 0.20, l04_darkvalley = 0.20,
}

-- Dread value tables (additive, no baseline, clamped 0..1). Tuned for good dread + variation (n119).
local ENV_ADD      = { outdoor = 0.00, indoor = 0.08, underground = 0.15, labs = 0.25 }
local TIME_ADD     = { day = 0.00, dawn = 0.04, dusk = 0.05, night = 0.12, deep_night = 0.18 }
local THREAT_ADD   = { [1] = 0.08, [2] = 0.15, [3] = 0.30 }
local LONELINESS   = 0.06
local ALLY_CALM    = { none = 0, low = -0.05, med = -0.10, high = -0.15 }
local ANOMALY_ADD  = 0.05
local SERVICE_HOSTILE = 0.30

-- One vicinity radius for every proximity sensor (creature-near, service/base, anomaly): 60m = "in my area".
local NEAR_R  = 60
local NEAR_R2 = NEAR_R * NEAR_R

-- Emission + pacing. One sound at most every SPACE_MIN..MAX (dread shortens it); below DREAD_ON nothing
-- emits. HORROR_PULL: up to this fraction closer at peak dread. Volume is dread-FREE.
local DREAD_ON     = 0.10
local SPACE_MIN_MS = 5000
local SPACE_MAX_MS = 15000
local HORROR_PULL  = 0.25
local TICK_S       = 0.1
local BASE_TICK_S  = 1
local INSANE_DREAD = 0.80
local PLAY_WINDOW_MS = 6000
local TYPE_WRAP      = 34

-- Visual layer: at peak dread only, a subtle distortion pulse (dwell-gated, cooldown, >=50% roll).
local VIS_PPE         = { "blur.ppe", "total_recall.ppe", "steam_mine.ppe" }
local VIS_FACTOR      = 0.25
local VIS_DWELL_MS    = 4000
local VIS_COOLDOWN_MS = 30000
local VIS_HOLD_S      = 1.2
local VIS_SMOOTH      = 1.5
local VIS_CHANCE      = 0.5

-- MCM knobs (1.0 neutral). One master volume for our sounds; no per-category volume.
local rarity             = 1
local distance           = 1
local vol_global         = 1
local opt_ambient_volume = 1
local visuals_on         = true

-- The sensor board: single source of truth, filled by the producers, read by SELECT/APPLY/GUI.
local board = {
    environment = "outdoor",
    time        = "day",
    stalkers = { online = false, enemy_near = "none", ally_near = "none", service_near = "none" },
    monsters = { online = false, enemy_near = "none" },
    anomalies = { near = false },
    dread    = 0,
    terms    = {},
    eligible = {},
    elig_set = {},
}

-- Runtime state. _cats: category -> sound list from as_manifest. _map/_map_set: the level's category set.
-- _cat_bag/_snd_bag: the two shuffle-bags. _enc: the environment raycast cache (by cell). _vis: visual state.
local _cats      = {}
local _loaded    = false
local _map       = nil
local _map_level = nil
local _map_set   = {}
local _cat_bag   = {}
local _snd_bag   = {}
local _next_play = 0
local _play_at   = 0
local _last_play = "-"
local _base_last = "-"
local _base_at   = 0
-- dev tab master silence: cuts the director's own emission + the base-ambient replay
local _muted     = false
local _rows      = {}
local _enc = { level = nil, cx = nil, cz = nil, val = "outdoor" }
local _vis = { insane_since = nil, next_ok = 0, handle = nil }

-- Forward declarations for helpers referenced before their definition line (kept local, never global).
local _build_hud, _vis_pulse, _visual_tick

--- Comma-join short strings into lines each <= width chars (the wrapped HUD available list).
local function _wrap_csv(items, width)
    local lines, buf, len = {}, {}, 0
    for i = 1, #items do
        local sep = (i < #items) and ", " or ""
        local plen = #items[i] + #sep
        if len > 0 and len + plen > width then lines[#lines + 1] = table_concat(buf); buf, len = {}, 0 end
        buf[#buf + 1] = items[i]
        buf[#buf + 1] = sep
        len = len + plen
    end
    if len > 0 then lines[#lines + 1] = table_concat(buf) end
    return lines
end

--- A raw rank -> "none"|"low"|"med"|"high" power token against a scale's med/high cut points.
local function _tier(rank, med, high)
    if not rank or rank <= 0 then return "low" end
    if rank >= high then return "high" end
    if rank >= med then return "med" end
    return "low"
end

--- True if an online NPC fills a base-marking service role (trader/medic/mechanic).
local function _is_service(npc)
    if not (xsmart and xsmart.get_npc_roles) then return false end
    local roles = xsmart.get_npc_roles(npc)
    return (roles.trader or roles.medic or roles.mechanic) and true or false
end

-- ---- LOAD -----------------------------------------------------------------

--- Load each category's sound list from as_manifest, once. Each sound is { path, min, max, height }.
local function _load_channels()
    if _loaded then return end
    _loaded = true
    local cats = as_manifest and as_manifest.categories or {}
    for name in pairs(CAT) do
        _cats[name] = cats[name] or {}
        as_debug.dbg("as_director: category %s = %d sounds", name, #_cats[name])
    end
end

--- Build the per-level eligible-category set from as_static_map.ltx ([default] + [level]), once per level.
local function _load_map(level_name)
    if _map_level == level_name then return end
    _map_level = level_name
    if not _map then _map = ini_file(MAP_FILE) end
    _map_set = {}
    local function add(section)
        if not (_map and _map:section_exist(section)) then return end
        for _, name in ipairs(parse_list(_map, section, "categories")) do
            if CAT[name] and #(_cats[name] or {}) > 0 then _map_set[name] = true end
        end
    end
    add(SEC_DEFAULT)
    add(level_name)
    _cat_bag = {}
end

-- ---- SCANS (producers -> the board) ---------------------------------------

--- Environment token at the actor: labs / underground (engine underground flag, split by LAB_LEVELS),
--- else indoor (is_indoor raycast, cached by cell) else outdoor.
local function _read_environment(actor)
    local pos = actor:position()
    local level_name = level.name()
    if GetEvent("underground") then return LAB_LEVELS[level_name] and "labs" or "underground" end
    local cx, cz = math_floor(pos.x / 4), math_floor(pos.z / 4)
    if _enc.level ~= level_name or _enc.cx ~= cx or _enc.cz ~= cz then
        _enc.level, _enc.cx, _enc.cz = level_name, cx, cz
        _enc.val = (xcombat and xcombat.is_indoor and xcombat.is_indoor(pos)) and "indoor" or "outdoor"
    end
    return _enc.val
end

--- Fold one online stalker id into the stalkers sensor (guard-clause; near-only past the distance test).
local function _fold_stalker(id, actor_id, apos, out)
    if id == actor_id then return end
    local st = db.storage[id]
    local npc = st and st.object
    if not npc then return end
    out.online = true
    local dist_sqr = apos:distance_to_sqr(npc:position())
    if dist_sqr > NEAR_R2 then return end
    local rel  = xcreature.relation(npc, db.actor)
    local tier = _tier(npc:character_rank(), STALKER_MED, STALKER_HIGH)
    if rel == "enemy" then
        if POWER[tier] > POWER[out.enemy_near] then out.enemy_near = tier end
    else
        if POWER[tier] > POWER[out.ally_near] then out.ally_near = tier end
    end
    if _is_service(npc) then
        out.service_near = (rel == "enemy") and "hostile" or "allied"
    end
end

--- Scan the dedicated online-stalker array (db.OnlineStalkers) in one pass.
local function _scan_stalkers(actor)
    local out = { online = false, enemy_near = "none", ally_near = "none", service_near = "none" }
    local online = db.OnlineStalkers
    if not online then return out end
    local actor_id, apos = actor:id(), actor:position()
    for i = 1, #online do _fold_stalker(online[i], actor_id, apos, out) end
    return out
end

--- Fold one online monster into the monsters sensor (the iterator yields monsters; near-only tiering).
local function _fold_monster(id, obj, apos, out)
    if not obj then return end
    out.online = true
    if apos:distance_to_sqr(obj:position()) > NEAR_R2 then return end
    local se = xobject.se(id)
    if not se then return end
    local tier = _tier(se:rank(), MONSTER_MED, MONSTER_HIGH)
    if POWER[tier] > POWER[out.enemy_near] then out.enemy_near = tier end
end

--- Scan online monsters via the xlibs monster iterator (db.OnlineMonsters when present, else a capped
--- best-effort is_mutant walk - the demonized registry PR is the parity fix, n119).
local function _scan_monsters(actor)
    local out = { online = false, enemy_near = "none" }
    if not (xcreature and xcreature.online_monster_iter) then return out end
    local apos = actor:position()
    for id, obj in xcreature.online_monster_iter() do _fold_monster(id, obj, apos, out) end
    return out
end

--- Anomaly within range of the actor (proven scan over db.anomaly_by_name).
local function _read_anomalies(actor)
    return (xsmart and xsmart.anomaly_near and xsmart.anomaly_near(actor:position(), NEAR_R)) or false
end

--- Time band for the current hour.
local function _time_band(hour)
    if not hour then return "day" end
    if hour >= 7 and hour < 19 then return "day" end
    if hour >= 19 and hour < 21 then return "dusk" end
    if hour >= 5 and hour < 7  then return "dawn" end
    if hour >= 0 and hour < 4  then return "deep_night" end
    return "night"
end

-- ---- SELECT (eligibility + two-level shuffle-bag) --------------------------

--- True if a category is eligible now: the level's map list names it, its env allows the environment,
--- and its live need (level-wide presence / anomaly-near) is met. Reads the board.
local function _eligible(name)
    if not _map_set[name] then return false end
    local def = CAT[name]
    local env = board.environment
    if env == "outdoor" and not def.out then return false end
    if env == "indoor" and not def.ind then return false end
    if (env == "underground" or env == "labs") and not def.ug then return false end
    local need = def.need
    if need == "mutant" then return board.monsters.online end
    if need == "human" then return board.stalkers.online end
    if need == "anomaly" then return board.anomalies.near end
    return true
end

--- Category shuffle-bag: cycle every eligible category once before any repeat. Stale names (no longer
--- eligible after the set changed) are dropped; the bag refills from the current eligible list when empty.
local function _pick_category()
    local live = {}
    for i = 1, #_cat_bag do
        if board.elig_set[_cat_bag[i]] then live[#live + 1] = _cat_bag[i] end
    end
    if #live == 0 then
        for i = 1, #board.eligible do live[i] = board.eligible[i] end
    end
    if #live == 0 then _cat_bag = {}; return nil end
    local pick = math_random(#live)
    local name = live[pick]
    table_remove(live, pick)
    _cat_bag = live
    return name
end

--- Sound shuffle-bag within a category: every sound plays once before any repeat.
local function _pick_sound(name)
    local sounds = _cats[name]
    if not sounds or #sounds == 0 then return nil end
    if #sounds == 1 then return sounds[1] end
    local bag = _snd_bag[name]
    if not bag or #bag == 0 then
        bag = {}
        for i = 1, #sounds do bag[i] = i end
        _snd_bag[name] = bag
    end
    local pick = math_random(#bag)
    local idx = bag[pick]
    bag[pick] = bag[#bag]
    bag[#bag] = nil
    return sounds[idx]
end

-- ---- APPLY (dread + positioned play) --------------------------------------

--- The threat dread term: the scariest near thing (man or monster, one power), or loneliness if none near.
local function _threat_add(s, m)
    local worst = math_max(POWER[s.enemy_near], POWER[m.enemy_near])
    if worst > 0 then return THREAT_ADD[worst] end
    if s.ally_near == "none" then return LONELINESS end
    return 0
end

local function _clamp01(v)
    if v < 0 then return 0 end
    if v > 1 then return 1 end
    return v
end

--- Grounded additive dread from the board, clamped 0..1. An allied service near (a safe hub) forces 0;
--- a hostile service adds. Writes board.dread + board.terms (the HUD breakdown, one persistent table).
local function _dread()
    local s, m = board.stalkers, board.monsters
    local terms = board.terms
    terms.lore    = LORE_LEVEL[level.name()] or LORE_DEFAULT
    terms.env     = ENV_ADD[board.environment] or 0
    terms.time    = TIME_ADD[board.time] or 0
    terms.threat  = _threat_add(s, m)
    terms.company = ALLY_CALM[s.ally_near] or 0
    terms.anomaly = board.anomalies.near and ANOMALY_ADD or 0
    terms.service = (s.service_near == "hostile") and SERVICE_HOSTILE or 0
    if s.service_near == "allied" then board.dread = 0; return end
    board.dread = _clamp01(terms.lore + terms.env + terms.time + terms.threat + terms.company + terms.anomaly + terms.service)
end

--- Fire one positioned one-shot at `path`. `dist` is the HORIZONTAL distance; opts.dist = an explicit metre
--- distance used as-is (the audition player); else the director curve from opts.min/max/deep (random point in
--- the band, halved), pulled closer by HORROR_PULL x opts.dread and the MCM distance knob. opts.height offsets
--- the placement VERTICALLY (`pos.y + height`) - the sound's ORIGINAL source-channel elevation, carried per
--- sound in the manifest (snd[4]) and recovered by merge.py `_source_height_map`, so an overhead sound (bird,
--- vent, thunder) stays overhead instead of at ear level. Height is pulled DOWN by dread by the same factor as
--- distance, so an overhead cue descends toward ear level as the place turns. Volume is dread-free. Returns the distance.
function emit(path, opts)
    local actor = db.actor
    if not (actor and path and xsound) then return end
    local height = opts.height or 0
    local dist = opts.dist
    if not dist then
        local min_dist, max_dist = opts.min or 1, opts.max or 300
        if min_dist > max_dist then min_dist = max_dist end
        local near_bound = opts.deep and min_dist or ((max_dist + min_dist) / 2)
        dist = math_random(near_bound, max_dist) / 2
        local pull = 1 - HORROR_PULL * (opts.dread or 0)
        dist = dist * pull * distance
        height = height * pull                  -- dread also pulls the sound DOWN toward you: an overhead
    end                                         -- cue descends to ear level as the place turns, mirroring distance
    local pos = actor:position()
    local angle = math_rad(math_random(0, 359))
    local vec = vector():set(pos.x + math_cos(angle) * dist, pos.y + height, pos.z + math_sin(angle) * dist)
    local vol = opts.vol or (vol_global * opt_ambient_volume)
    xsound.play(path, { position = vec, volume = vol })
    as_debug.dbg("[PLAY] %s dist=%.1f h=%.0f vol=%.2f dread=%.2f", path, dist, height, vol, opts.dread or 0)
    return dist
end

-- ---- derive (board -> eligible set, built on demand) -----------------------

--- Rebuild the eligible category list + fast lookup from the current board. Called at emission and by the
--- HUD only, never on the tick - the set is consumed only there, so a per-tick rebuild was pure garbage.
local function _rebuild_eligible()
    local elig = {}
    for name in pairs(CAT) do
        if _eligible(name) then elig[#elig + 1] = name end
    end
    board.eligible = elig
    board.elig_set = {}
    for i = 1, #elig do board.elig_set[elig[i]] = true end
end

--- Build the debug HUD rows (PLAYING / SELECT / SENSORS) from the board.
function _build_hud()
    _rebuild_eligible()
    local playing = _play_at > 0 and (time_global() - _play_at) < PLAY_WINDOW_MS
    local base_playing = _base_at > 0 and (time_global() - _base_at) < PLAY_WINDOW_MS
    local dread = board.dread
    local grade = (dread >= INSANE_DREAD) and "g_insane" or (dread >= DREAD_ON) and "g_med" or "g_none"
    local s, m = board.stalkers, board.monsters
    _rows = {
        { "PLAYING", "", "", "hdr" },
        { "spook", _last_play, "", playing and "play" or "stop" },
        { "base", _base_last, "", base_playing and "play" or "stop" },
        { "", "", "" },
        { "SELECT", "", "", "hdr" },
    }
    local avail = _wrap_csv(board.eligible, TYPE_WRAP)
    if #avail == 0 then avail = { "-" } end
    for i = 1, #avail do _rows[#_rows + 1] = { i == 1 and "available" or "", avail[i], "" } end
    _rows[#_rows + 1] = { "dread", string_format("%.2f", dread), "", grade }
    _rows[#_rows + 1] = { "", "", "" }
    _rows[#_rows + 1] = { "APPLY", "", "", "hdr" }
    local terms = board.terms
    _rows[#_rows + 1] = { "lore",        string_format("%+.2f", terms.lore or 0), "" }
    _rows[#_rows + 1] = { "environment", string_format("%+.2f", terms.env or 0), "" }
    _rows[#_rows + 1] = { "time",        string_format("%+.2f", terms.time or 0), "" }
    _rows[#_rows + 1] = { "threat",      string_format("%+.2f", terms.threat or 0), "" }
    _rows[#_rows + 1] = { "company",     string_format("%+.2f", terms.company or 0), "" }
    _rows[#_rows + 1] = { "anomaly",     string_format("%+.2f", terms.anomaly or 0), "" }
    _rows[#_rows + 1] = { "service",     string_format("%+.2f", terms.service or 0), "" }
    _rows[#_rows + 1] = { "", "", "" }
    _rows[#_rows + 1] = { "SENSORS", "", "", "hdr" }
    _rows[#_rows + 1] = { "environment", board.environment, "" }
    _rows[#_rows + 1] = { "time", board.time, "" }
    _rows[#_rows + 1] = { "stalkers.online", s.online and "yes" or "no", "" }
    _rows[#_rows + 1] = { "stalkers.enemy_near", s.enemy_near, "" }
    _rows[#_rows + 1] = { "stalkers.ally_near", s.ally_near, "" }
    _rows[#_rows + 1] = { "stalkers.service_near", s.service_near, "" }
    _rows[#_rows + 1] = { "monsters.online", m.online and "yes" or "no", "" }
    _rows[#_rows + 1] = { "monsters.enemy_near", m.enemy_near, "" }
    _rows[#_rows + 1] = { "anomalies.near", board.anomalies.near and "yes" or "no", "" }
end

-- ---- visual layer ---------------------------------------------------------

--- Fire one subtle distortion pulse: acquire a cyclic effector, drive its factor up, release after a hold.
function _vis_pulse()
    if not xpp then return end
    local ppe = VIS_PPE[math_random(#VIS_PPE)]
    if _vis.handle and xpp.is_active(_vis.handle) then xpp.release(_vis.handle) end
    local handle = xpp.acquire(ppe, { cyclic = true, smoothing = VIS_SMOOTH })
    _vis.handle = handle
    if handle then
        xpp.set_target(handle, VIS_FACTOR, VIS_SMOOTH)
        CreateTimeEvent("as_director", "vis_release", VIS_HOLD_S, function()
            if xpp.is_active(handle) then xpp.release(handle) end
            if _vis.handle == handle then _vis.handle = nil end
            return true
        end)
    end
end

--- Peak-dread visual gate: require sustained peak (dwell), then once per cooldown roll to pulse.
function _visual_tick(tg)
    if not (visuals_on and xpp) or board.dread < INSANE_DREAD then
        _vis.insane_since = nil
        return
    end
    if not _vis.insane_since then _vis.insane_since = tg; return end
    if tg < _vis.next_ok or tg - _vis.insane_since < VIS_DWELL_MS then return end
    _vis.next_ok = tg + VIS_COOLDOWN_MS
    if math_random() < VIS_CHANCE then _vis_pulse() end
end

-- ---- emission (jittered self-schedule) ------------------------------------

--- Emit one one-shot if the jittered spacing has elapsed. Dread shortens the gap; below DREAD_ON nothing
--- fires but the pacing keeps advancing so a rising dread resumes at once. Reads the board.
local function _emit_tick(tg)
    _visual_tick(tg)
    if _muted then return end
    if tg < _next_play then return end
    local dread = board.dread
    local span = SPACE_MIN_MS + (SPACE_MAX_MS - SPACE_MIN_MS) * (1 - dread)
    _next_play = tg + math_floor(math_random(SPACE_MIN_MS, span) * math_max(rarity, 0.1))
    if dread < DREAD_ON then return end
    _rebuild_eligible()
    local name = _pick_category()
    if not name then return end
    local snd = _pick_sound(name)
    if snd then
        emit(snd[1], { min = snd[2], max = snd[3], height = snd[4], dread = dread,
                       deep = board.environment == "underground" or board.environment == "labs" })
        _last_play = snd[1]
        _play_at = tg
        as_debug.dbg("[PICK] cat=%s snd=%s dread=%.2f", name, snd[1], dread)
    end
end

-- ---- base ambient observer (own update_ambient; a LOGGING clone, not the veto) --------
-- The muting is STATIC (the DLTX overlay). This hook only replays+LOGS the base ambient so it stays
-- traceable at DEBUG. A faithful clone of sound_ambient.update_ambient; no filtering, no injection.
local _base = { chan = {}, idx = 0, tot = 0, hour = nil }

local function _base_channel(ch, ini_snd)
    local raw = parse_list(ini_snd, ch, "sounds")
    if not raw or #raw == 0 then return nil end
    return { name = ch, sounds = raw,
        max_dist = ini_snd:r_float_ex(ch, "max_distance") or 100,
        min_dist = ini_snd:r_float_ex(ch, "min_distance") or 1,
        height   = ini_snd:r_float_ex(ch, "height") or 0,
        indoor   = ini_snd:r_bool_ex(ch, "indoor") or false,
        periods  = { ini_snd:r_float_ex(ch, "period0") or 10, ini_snd:r_float_ex(ch, "period1") or 15,
                     ini_snd:r_float_ex(ch, "period2") or 20, ini_snd:r_float_ex(ch, "period3") or 25 } }
end

local function _base_reset(level_name, ambient)
    _base.chan, _base.idx, _base.tot = {}, 0, 0
    if not (level_name and ambient and ambient ~= "") then return end
    local ini_lvl = ini_file("environment\\ambients\\" .. level_name .. ".ltx")
    if not ini_lvl then return end
    local channels = parse_list(ini_lvl, ambient, "sound_channels_dynamic")
    if #channels == 0 then return end
    local cached, ini_snd = {}, ini_file(CHANNELS_FILE)
    for i = 1, #channels do
        local ch = channels[i]
        local entry = (not cached[ch]) and ini_snd:section_exist(ch) and _base_channel(ch, ini_snd)
        cached[ch] = true
        if entry then
            _base.tot = _base.tot + 1
            _base.chan[_base.tot] = entry
        end
    end
end

local function _base_fire(ch, tg)
    local actor = db.actor
    if not actor then return end
    local period = ch.periods[math_random(4)]
    ch.next = tg + period
    -- muted (dev tab): the schedule above already advanced, so simply play nothing this fire
    if _muted then return end
    local file = ch.sounds[math_random(#ch.sounds)]
    _base_last, _base_at = tostring(file), tg
    local inside, underground = GetEvent("current_safe_cover"), GetEvent("underground")
    local pos = actor:position()
    local max_dist = ch.max_dist
    local min_dist = underground and ch.min_dist or ((max_dist + ch.min_dist) / 2)
    if min_dist > max_dist then min_dist = max_dist end
    local dist = math_random(min_dist, max_dist) / 2
    local angle = math_rad(math_random(0, 359))
    local vol
    if underground or inside then vol = ch.indoor and 1 or 0.3
    else vol = ch.indoor and 0 or 1 end
    vol = vol * opt_ambient_volume
    local vec = vector():set(pos.x + math_cos(angle) * dist, pos.y + ch.height, pos.z + math_sin(angle) * dist)
    xsound.play(file, { position = vec, volume = vol })
    if as_debug.on() then
        as_debug.dbg("[BASE] lvl=%s ch=%s file=%s dist=%.1f vol=%.2f", level.name(), ch.name, tostring(file), dist, vol)
    end
end

local function update_ambient_owned()
    ResetTimeEvent("sound_channels", "update_ambient", BASE_TICK_S)
    if not (level.present() and db.actor) then return false end
    local tg = time_global()
    local hour = level.get_time_hours()
    if hour ~= _base.hour then
        _base.hour, _base.idx = hour, 0
        local wm = level_weathers and level_weathers.get_weather_manager()
        _base_reset(level.name(), wm and wm:get_curr_ambient())
    elseif _base.tot > 0 then
        _base.idx = _base.idx + 1
        if _base.idx > _base.tot then _base.idx = 1 end
        local ch = _base.chan[_base.idx]
        if not ch.next then ch.next = tg + math_random(1, ch.periods[math_random(4)] + 1)
        elseif ch.next <= tg then _base_fire(ch, tg) end
    end
    return false
end

local function _apply_owned()
    _base.hour, _base.idx = nil, 0
    RemoveTimeEvent("sound_channels", "update_ambient")
    CreateTimeEvent("sound_channels", "update_ambient", 1, update_ambient_owned)
end

-- ---- director loop (one tick, round-robin one producer per tick) -----------

-- Each producer writes one sensor into the board. The tick runs ONE per tick, so the per-tick cost is
-- the single heaviest scan, never the sum; the full board refreshes over #producers ticks (~0.6s).
local _prod = {
    { "stalkers",    function(actor) board.stalkers = _scan_stalkers(actor) end },
    { "monsters",    function(actor) board.monsters = _scan_monsters(actor) end },
    { "environment", function(actor) board.environment = _read_environment(actor) end },
    { "anomalies",   function(actor) board.anomalies.near = _read_anomalies(actor) end },
    { "time",        function()      if level.present() then board.time = _time_band(level.get_time_hours()) end end },
}
local _cursor = 1

local function _tick()
    ResetTimeEvent("as_director", "tick", TICK_S)
    if not (level.present() and db.actor) then return false end
    local tg = time_global()
    local dbg = as_debug.on()
    local entry = _prod[_cursor]
    local tmr = xprofiler.new_if(dbg):start()
    entry[2](db.actor)
    tmr:stop()
    _cursor = _cursor % #_prod + 1
    _dread()
    if dbg then _rebuild_eligible(); as_debug.dbg("[SCAN %s %.2fms] dread=%.2f elig=%d", entry[1], tmr:get_ms(), board.dread, #board.eligible) end
    _emit_tick(tg)
    return false
end

-- ---- lifecycle ------------------------------------------------------------

local function refresh()
    rarity             = as_mcm.get_config("rarity") or 1
    distance           = as_mcm.get_config("distance") or 1
    vol_global         = as_mcm.get_config("vol_global") or 1
    opt_ambient_volume = (ui_options and ui_options.get("sound/environment/ambient_volume")) or 1
    local wanted = as_mcm.get_config("visuals")
    visuals_on = (wanted == nil) or wanted
end

--- Load banks, arm the ticks. Runs on every actor_on_first_update, so a save load re-arms the timers.
--- Inert without xlibs (xsound). The veto still holds - it is the static DLTX overlay.
local function _on_first_update()
    refresh()
    if not xsound then as_debug.warn("as_director: xlibs (xsound) absent - director inert"); return end
    _load_channels()
    _load_map(level.name())
    _next_play, _cursor = 0, 1
    _map_level, _cat_bag, _snd_bag = nil, {}, {}
    _vis.insane_since, _vis.next_ok, _vis.handle = nil, 0, nil
    _apply_owned()
    RemoveTimeEvent("as_director", "tick")
    CreateTimeEvent("as_director", "tick", TICK_S, _tick)
    as_debug.info("as_director: armed - sensor-board director on tick; base observer on update_ambient")
end

--- The debug HUD rows, built fresh from the board on demand (as_hud reads this only while visible, so
--- the rows are never built on the tick - no per-frame garbage when the HUD is off).
function get_hud_rows()
    _build_hud()
    return _rows
end

--- The live sensor board (read-only): the Player tab's Inspector reads dread + environment for a spot readout.
function get_board()
    return board
end

--- Dev tab master silence. When on, the director emits no one-shots and the base-ambient observer replays
--- nothing (both schedules keep advancing, so unmute resumes cleanly). The tab's own emit/play is unaffected.
function set_muted(v) _muted = v and true or false end
function is_muted()   return _muted end

function on_game_start()
    RegisterScriptCallback("actor_on_first_update",      _on_first_update)
    RegisterScriptCallback("on_option_change",           refresh)
    RegisterScriptCallback("mcm_option_restore_default", refresh)
end
