--- as_director: dread director; a 100ms tick fills a sensor board, additive dread paces emission and selection, and a base observer replays the base ambient.

local math_random, math_rad = math.random, math.rad
local math_cos, math_sin = math.cos, math.sin
local math_max, math_floor = math.max, math.floor
local math_sqrt = math.sqrt
local time_global, vector, GetEvent = time_global, vector, GetEvent
local string_format, RegisterScriptCallback = string.format, RegisterScriptCallback
local table_remove, table_concat = table.remove, table.concat
local pairs, ipairs, tostring = pairs, ipairs, tostring
local tonumber, next = tonumber, next

local MAP_FILE      = "scripts\\as_static_map.ltx"
local POSITION_FILE = "scripts\\as_static_position.ltx"
local DREAD_FILE    = "scripts\\as_static_dread.ltx"
local SEC_DREAD     = "dread"
local CHANNELS_FILE = "environment\\sound_channels.ltx"
local SEC_DEFAULT   = "default"
local SEC_POSITIONS = "positions"

-- Domain tokens compared against board fields (no magic strings at the comparison sites).
local ENV     = { OUTDOOR = "outdoor", INDOOR = "indoor", UNDERGROUND = "underground", LABS = "labs" }
local NEED    = { MUTANT = "mutant", HUMAN = "human", ANOMALY = "anomaly" }
local BUCKET  = { LOW = "low", MED = "med", HIGH = "high" }
local SERVICE = { HOSTILE = "hostile", ALLIED = "allied" }
local TIER_NONE   = "none"
local SELECT_ONLY = "only"

-- Per-category play rules: env enclosure flags (out/ind/ug) and an optional live need gate; per-level eligibility lives in as_static_map.ltx.
local CATEGORY = {
    mutant                = { out = true, ind = true, ug = true, need = NEED.MUTANT },
    mutant_ambient_forest = { out = true },
    mutant_ambient_swamp  = { out = true },
    mutant_ambient_urban  = { out = true },
    mutant_ambient_field  = { out = true },
    spook       = { out = true, ind = true, ug = true },
    scream      = { out = true, ind = true, ug = true },
    drone       = { out = true, ind = true, ug = true, need = NEED.ANOMALY },
    dark_signal = { out = true, ind = true, ug = true },
    industrial  = { out = true, ind = true, ug = true },
    structural  = { ind = true, ug = true },
    labs        = { ind = true, ug = true },
    drip        = { ug = true },
    wind        = { out = true },
    foliage     = { out = true },
    wildlife    = { out = true },
    urban       = { out = true },
    gunfire     = { out = true, need = NEED.HUMAN },
    rats        = { ind = true, ug = true },
    bats        = { out = true, ug = true },
}

-- Shared power scale; man (character_rank) and monster (se:rank) both map to one of these tokens.
local POWER = { none = 0, low = 1, med = 2, high = 3 }

-- Day runs from first light to dusk; everything outside is night.
local DAY_START_HOUR = 7
local DAY_END_HOUR = 19
local DUSK_END_HOUR = 21
local DAWN_START_HOUR = 5
local DEEP_NIGHT_END_HOUR = 4
-- Rank cut points (see doc/library/modding/npc-strength-evaluation.md; probe-verified cross-install).
local STALKER_MED, STALKER_HIGH = 9000, 14500
local MONSTER_MED, MONSTER_HIGH = 6, 17

-- The sci-fi lab levels, split off from generic underground (tunnels/mines/bunker) for the labs environment.
local LAB_LEVELS = {
    labx8 = true, l04u_labx18 = true, l08u_brainlab = true,
    l13u_warlab = true, l12u_sarcofag = true, l12u_control_monolith = true,
}

-- Per-LEVEL lore dread (the place's own baseline; coordinate overrides supersede this later, n114).
local LORE_DEFAULT = 0.15
local LORE_LEVEL = {
    l12u_control_monolith = 0.50, l10_radar = 0.45, l08u_brainlab = 0.45, l10u_bunker = 0.45,
    l08_yantar = 0.40, l10_red_forest = 0.40, l12u_sarcofag = 0.40, l12_stancia_2 = 0.40,
    l04u_labx18 = 0.35, l03u_agr_underground = 0.35, l13u_warlab = 0.35, labx8 = 0.35,
    l12_stancia = 0.35, l11_hospital = 0.35,
    jupiter_underground = 0.30, l13_generators = 0.30, l09_deadcity = 0.30, l10_limansk = 0.30,
    l11_pripyat = 0.30, pripyat = 0.30,
    k00_marsh = 0.20, zaton = 0.20, l04_darkvalley = 0.20,
}

-- Dread value tables (additive, no baseline, clamped 0..1). Tuned for good dread + variation (n119).
local ENV_ADD      = { outdoor = 0.00, indoor = 0.08, underground = 0.15, labs = 0.25 }
local TIME_ADD     = { day = 0.00, dawn = 0.04, dusk = 0.05, night = 0.12, deep_night = 0.18 }
local THREAT_ADD   = { [1] = 0.08, [2] = 0.15, [3] = 0.30 }
local LONELINESS   = 0.06
local ALLY_CALM    = { none = 0, low = -0.05, med = -0.10, high = -0.15 }
local ANOMALY_ADD  = 0.05
local SERVICE_HOSTILE = 0.30

-- One vicinity radius for every proximity sensor (creature-near, service/base, anomaly): 60m = "in my area".
local NEAR_R  = 60
local NEAR_R2 = NEAR_R * NEAR_R

-- Emission pacing: the gap between plays scales with current dread each tick, power-eased off calm and jittered; dread 0 is silent, any dread above 0 plays.
local DREAD_ON      = 0.10
local SPACE_CALM_MS = 40000
local SPACE_PEAK_MS = 8125
local SPACE_JITTER  = 0.15
local SPACE_EASE    = 0.5
-- Dread pulls placement up to DREAD_PULL closer (0.8..1.0 factor, applied in play_sound), never the volume table.
local DREAD_PULL    = 0.20
-- Placement is the base-game roll (sound_ambient.script:127-165): the source-channel spawn band, a random bearing and distance, then the base volume table.
local TICK_S       = 0.1
local BASE_TICK_S  = 1
local INSANE_DREAD = 0.80
local PLAY_WINDOW_MS = 6000
local TYPE_WRAP      = 34

-- Dread bucket cut points: board.dread maps to the low/med/high scene bucket the sound-bag draws from.
local DREAD_LIMIT_LOW = 0.40
local DREAD_LIMIT_MED = 0.70

-- Visual layer: at peak dread only, a subtle distortion pulse (dwell-gated, cooldown, >=50% roll).
local VIS_PPE         = { "blur.ppe", "total_recall.ppe", "steam_mine.ppe" }
local VIS_FACTOR      = 0.25
local VIS_DWELL_MS    = 4000
local VIS_COOLDOWN_MS = 30000
local VIS_HOLD_S      = 1.2
local VIS_SMOOTH      = 1.5
local VIS_CHANCE      = 0.5

-- MCM knobs (1.0 neutral). One master volume for our sounds; no per-category volume.
local rarity             = 1
local vol_global         = 1
local opt_ambient_volume = 1
local visuals_on         = true

-- The sensor board: single source of truth, filled by the producers, read by SELECT/APPLY/GUI.
local board = {
    environment = ENV.OUTDOOR,
    time        = "day",
    stalkers = { online = false, enemy_near = "none", ally_near = "none", service_near = "none" },
    monsters = { online = false, enemy_near = "none" },
    anomalies = { near = false },
    dread    = 0,
    terms    = {},
    eligible = {},
    elig_set = {},
}

-- Runtime state: the loaded sound catalog and dread pools, the per-level map set, the shuffle-bags, the enclosure cache, and visual and base-observer state.
local _category_sounds      = {}
local _loaded    = false
local _map       = nil
local _map_level = nil
local _map_set   = {}
local _positions     = nil
local _sound_dread   = nil
local _dread_pools   = {}
local _cat_bag   = {}
local _snd_bag   = {}
local _gap_at    = 0
local _jitter    = 1
local _play_at   = 0
local _last_play = "-"
local _base_last = "-"
local _base_at   = 0
-- dev tab master silence: cuts the director's own emission + the base-ambient replay
local _muted     = false
local _rows      = {}
local _enclosure = { level = nil, cx = nil, cz = nil, val = ENV.OUTDOOR }
local _visual = { insane_since = nil, next_ok = 0, handle = nil }
local _base = { chan = {}, idx = 0, tot = 0, hour = nil }
local _cursor = 1

-- Forward declarations for helpers referenced before their definition line (kept local, never global).
local _build_hud, play_visual_pulse, try_visual_pulse

--- Comma-join short strings into lines each <= width chars (the wrapped HUD available list).
local function build_lines(items, width)
    local lines, buf, len = {}, {}, 0
    for i = 1, #items do
        local sep = (i < #items) and ", " or ""
        local plen = #items[i] + #sep
        if len > 0 and len + plen > width then lines[#lines + 1] = table_concat(buf); buf, len = {}, 0 end
        buf[#buf + 1] = items[i]
        buf[#buf + 1] = sep
        len = len + plen
    end
    if len > 0 then lines[#lines + 1] = table_concat(buf) end
    return lines
end

--- A raw rank -> "none"|"low"|"med"|"high" power token against a scale's med/high cut points.
local function get_power_tier(rank, med, high)
    if not rank or rank <= 0 then return "low" end
    if rank >= high then return "high" end
    if rank >= med then return "med" end
    return "low"
end

--- True if an online NPC fills a base-marking service role (trader/medic/mechanic).
local function _is_service(npc)
    if not (xsmart and xsmart.get_npc_roles) then return false end
    local roles = xsmart.get_npc_roles(npc)
    return (roles.trader or roles.medic or roles.mechanic) and true or false
end

-- LOAD

--- Sound count of a category (its flat row list from as_sound_config_gen).
local function _get_sound_count(cat) return cat and #cat or 0 end

--- True if a category has any sound.
local function _has_sounds(cat) return _get_sound_count(cat) > 0 end

--- Load the per-sound dread overrides from as_static_dread.ltx into _sound_dread, keyed by deployed name.
local function _load_dread()
    _sound_dread = {}
    for key, val in pairs(xltx.read_section(DREAD_FILE, SEC_DREAD)) do
        val = val and val:lower()
        if val == BUCKET.LOW or val == BUCKET.MED or val == BUCKET.HIGH then _sound_dread[key] = val end
    end
end

--- A sound row's override bucket (keyed by its deployed name = the path's last segment), or nil = every bucket.
local function _get_dread_override(row)
    local stem = tostring(row[1]):match("([^\\/]+)$")
    return stem and _sound_dread[stem]
end

--- Place one sound row into the dread pools: an overridden sound only in its bucket, a no-override sound in all three.
local function _add_pool_row(pools, row)
    local override = _get_dread_override(row)
    if not override then
        pools.low[#pools.low + 1]   = row
        pools.med[#pools.med + 1]   = row
        pools.high[#pools.high + 1] = row
        return
    end
    local pool = pools[override]
    if pool then pool[#pool + 1] = row end
end

--- Precompute each category's per-bucket sound pool once at load, so the shuffle-bag draws from a stable pool.
local function _build_dread_pools()
    _dread_pools = {}
    for name, cat in pairs(_category_sounds) do
        local pools = { low = {}, med = {}, high = {} }
        for i = 1, #cat do _add_pool_row(pools, cat[i]) end
        _dread_pools[name] = pools
    end
end

--- Load each category's flat sound list from as_sound_config_gen once, then build the dread overrides and pools.
local function _load_channels()
    if _loaded then return end
    _loaded = true
    if not as_sound_config_gen then
        as_debug.warn("as_director: as_sound_config_gen absent - no sounds to play (run build.py deploy)")
    end
    local cats = as_sound_config_gen and as_sound_config_gen.categories or {}
    for name in pairs(CATEGORY) do
        _category_sounds[name] = cats[name] or {}
        as_debug.debug("as_director: category %s = %d sounds", name, _get_sound_count(_category_sounds[name]))
    end
    _load_dread()
    _build_dread_pools()
end

--- Build the per-level eligible-category set from as_static_map.ltx ([default] + [level]), once per level.
local function _load_map(level_name)
    if _map_level == level_name then return end
    _map_level = level_name
    if not _map then _map = xltx.resolve_handle(MAP_FILE) end
    _map_set = {}
    local function add_section(section)
        for _, name in ipairs(xltx.read_list(_map, section, "categories")) do
            if CATEGORY[name] and _has_sounds(_category_sounds[name]) then _map_set[name] = true end
        end
    end
    add_section(SEC_DEFAULT)
    add_section(level_name)
    _cat_bag = {}
end

-- Coordinate overrides: a per-place base dread, flat add, and category selection, read once into a flat list.
local function _parse_position(ini, name)
    if not xltx.has(ini, name) then return nil end
    local pos = xltx.read_str(ini, name, "pos")
    local position_level = xltx.read_str(ini, name, "level")
    local cx, cz
    if pos then cx, cz = pos:match("(-?[%d.]+)%s*,%s*-?[%d.]+%s*,%s*(-?[%d.]+)") end
    if not (position_level and cx and cz) then return nil end
    local cats = {}
    for _, cat in ipairs(xltx.read_list(ini, name, "categories")) do cats[cat] = true end
    return {
        name = name, level = position_level, px = tonumber(cx), pz = tonumber(cz),
        radius = xltx.read_num(ini, name, "radius") or 30,
        dread = xltx.read_num(ini, name, "dread"),
        add = xltx.read_num(ini, name, "add") or 0,
        cats = next(cats) and cats or nil,
        only = xltx.read_str(ini, name, "select") == SELECT_ONLY,
    }
end

local function _load_positions()
    if _positions then return end
    _positions = {}
    local ini = xltx.resolve_handle(POSITION_FILE)
    for _, name in ipairs(xltx.read_list(ini, SEC_POSITIONS, "list")) do
        local position = _parse_position(ini, name)
        if position then _positions[#_positions + 1] = position end
    end
end

--- Find the active coordinate override where the actor stands, or nil, checking this level's positions.
local function _find_position(actor)
    _load_positions()
    local apos, here = actor:position(), level.name()
    for i = 1, #_positions do
        local position = _positions[i]
        if position.level == here and xmath.is_in_range(apos, position.px, position.pz, position.radius) then return position end
    end
    return nil
end

-- SCANS (producers -> the board)

--- Resolve the environment token at the actor: labs or underground by the engine flag, else indoor or outdoor by raycast.
local function _read_environment(actor)
    local pos = actor:position()
    local level_name = level.name()
    if GetEvent("underground") then return LAB_LEVELS[level_name] and ENV.LABS or ENV.UNDERGROUND end
    local cx, cz = math_floor(pos.x / 4), math_floor(pos.z / 4)
    if _enclosure.level ~= level_name or _enclosure.cx ~= cx or _enclosure.cz ~= cz then
        _enclosure.level, _enclosure.cx, _enclosure.cz = level_name, cx, cz
        _enclosure.val = (xcombat and xcombat.is_indoor and xcombat.is_indoor(pos)) and ENV.INDOOR or ENV.OUTDOOR
    end
    return _enclosure.val
end

--- Fold one online stalker id into the stalkers sensor (guard-clause; near-only past the distance test).
local function _add_stalker(id, actor_id, apos, out)
    if id == actor_id then return end
    local st = db.storage[id]
    local npc = st and st.object
    if not npc then return end
    out.online = true
    local dist_sqr = apos:distance_to_sqr(npc:position())
    if dist_sqr > NEAR_R2 then return end
    local rel  = xcreature.relation(npc, db.actor)
    local tier = get_power_tier(npc:character_rank(), STALKER_MED, STALKER_HIGH)
    if rel == xconst.RELATION.ENEMY then
        if POWER[tier] > POWER[out.enemy_near] then out.enemy_near = tier end
    else
        if POWER[tier] > POWER[out.ally_near] then out.ally_near = tier end
    end
    if _is_service(npc) then
        out.service_near = (rel == xconst.RELATION.ENEMY) and SERVICE.HOSTILE or SERVICE.ALLIED
    end
end

--- Scan the dedicated online-stalker array (db.OnlineStalkers) in one pass.
local function _collect_stalkers(actor)
    local out = { online = false, enemy_near = "none", ally_near = "none", service_near = "none" }
    local online = db.OnlineStalkers
    if not online then return out end
    local actor_id, apos = actor:id(), actor:position()
    for i = 1, #online do _add_stalker(online[i], actor_id, apos, out) end
    return out
end

--- Fold one online monster into the monsters sensor (the iterator yields monsters; near-only tiering).
local function _add_monster(id, obj, apos, out)
    if not obj then return end
    out.online = true
    if apos:distance_to_sqr(obj:position()) > NEAR_R2 then return end
    local se = xobject.get_se(id)
    if not se then return end
    local tier = get_power_tier(se:rank(), MONSTER_MED, MONSTER_HIGH)
    if POWER[tier] > POWER[out.enemy_near] then out.enemy_near = tier end
end

--- Scan online monsters via the xlibs monster iterator into the monsters sensor.
local function _collect_monsters(actor)
    local out = { online = false, enemy_near = "none" }
    if not (xcreature and xcreature.iterate_online_monsters) then return out end
    local apos = actor:position()
    for id, obj in xcreature.iterate_online_monsters() do _add_monster(id, obj, apos, out) end
    return out
end

--- Anomaly within range of the actor (proven scan over db.anomaly_by_name).
local function _read_anomalies(actor)
    return (xsmart and xsmart.is_anomaly_near and xsmart.is_anomaly_near(actor:position(), NEAR_R)) or false
end

--- Time band for the current hour.
local function _get_time_band(hour)
    if not hour then return "day" end
    if hour >= DAY_START_HOUR and hour < DAY_END_HOUR then return "day" end
    if hour >= DAY_END_HOUR and hour < DUSK_END_HOUR then return "dusk" end
    if hour >= DAWN_START_HOUR and hour < DAY_START_HOUR then return "dawn" end
    if hour >= 0 and hour < DEEP_NIGHT_END_HOUR then return "deep_night" end
    return "night"
end

-- SELECT (eligibility + two-level shuffle-bag)

--- True if a category is eligible now against the map list, the environment, and its live need gate.
local function is_eligible(name, position)
    local allowed = _map_set[name]
    if position and position.cats then
        if position.only then
            allowed = position.cats[name] and CATEGORY[name] and _has_sounds(_category_sounds[name])
        elseif position.cats[name] and CATEGORY[name] and _has_sounds(_category_sounds[name]) then
            allowed = true
        end
    end
    if not allowed then return false end
    local def = CATEGORY[name]
    local env = board.environment
    if env == ENV.OUTDOOR and not def.out then return false end
    if env == ENV.INDOOR and not def.ind then return false end
    if (env == ENV.UNDERGROUND or env == ENV.LABS) and not def.ug then return false end
    local need = def.need
    if need == NEED.MUTANT then return board.monsters.online end
    if need == NEED.HUMAN then return board.stalkers.online end
    if need == NEED.ANOMALY then return board.anomalies.near end
    return true
end

--- Category shuffle-bag: draw each eligible category once before any repeat, refilling from the eligible list when empty.
local function _select_category()
    local live = {}
    for i = 1, #_cat_bag do
        if board.elig_set[_cat_bag[i]] then live[#live + 1] = _cat_bag[i] end
    end
    if #live == 0 then
        for i = 1, #board.eligible do live[i] = board.eligible[i] end
    end
    if #live == 0 then _cat_bag = {}; return nil end
    local pick = math_random(#live)
    local name = live[pick]
    table_remove(live, pick)
    _cat_bag = live
    return name
end

--- The scene dread bucket the sound-bag draws from (low/med/high, via the DREAD_LIMIT cut points).
local function _get_dread_bucket(dread)
    if dread >= DREAD_LIMIT_MED then return BUCKET.HIGH end
    if dread >= DREAD_LIMIT_LOW then return BUCKET.MED end
    return BUCKET.LOW
end

--- Sound shuffle-bag for a category at the scene's dread bucket, drawing each pool sound once before any repeat.
local function _select_sound(name, scene_bucket)
    local pools = _dread_pools[name]
    local pool = pools and pools[scene_bucket]
    if not pool or #pool == 0 then return nil end
    if #pool == 1 then return pool[1] end
    local key = name .. "/" .. scene_bucket
    local bag = _snd_bag[key]
    if not bag or #bag == 0 then
        bag = {}
        for i = 1, #pool do bag[i] = i end
        _snd_bag[key] = bag
    end
    local pick = math_random(#bag)
    local idx = bag[pick]
    bag[pick] = bag[#bag]
    bag[#bag] = nil
    return pool[idx]
end

-- APPLY (dread + positioned play)

--- The threat dread term: the scariest near thing (man or monster, one power), or loneliness if none near.
local function _get_threat_term(stalkers, monsters)
    local worst = math_max(POWER[stalkers.enemy_near], POWER[monsters.enemy_near])
    if worst > 0 then return THREAT_ADD[worst] end
    if stalkers.ally_near == TIER_NONE then return LONELINESS end
    return 0
end

--- Sum the dread terms into the clamped 0..1 dread, applying the active position.
--- The position's dread replaces lore, its add stacks, and it overrides a safe hub's silence.
local function _resolve_dread(terms, position, allied)
    if position and position.dread then terms.lore = position.dread end
    if allied and not (position and position.dread) then return 0 end
    local add = (position and position.add) or 0
    local sum = terms.lore + terms.env + terms.time + terms.threat + terms.company + terms.anomaly + terms.service + add
    if sum < 0 then return 0 end
    if sum > 1 then return 1 end
    return sum
end

local function _compute_dread()
    local stalkers, monsters = board.stalkers, board.monsters
    local terms = board.terms
    terms.lore    = LORE_LEVEL[level.name()] or LORE_DEFAULT
    terms.env     = ENV_ADD[board.environment] or 0
    terms.time    = TIME_ADD[board.time] or 0
    terms.threat  = _get_threat_term(stalkers, monsters)
    terms.company = ALLY_CALM[stalkers.ally_near] or 0
    terms.anomaly = board.anomalies.near and ANOMALY_ADD or 0
    terms.service = (stalkers.service_near == SERVICE.HOSTILE) and SERVICE_HOSTILE or 0
    board.dread   = _resolve_dread(terms, board.position, stalkers.service_near == SERVICE.ALLIED)
end

--- Roll the base-game spawn distance for a channel band (sound_ambient.script:127-165), clamping an inverted band.
local function _compute_spawn_dist(ch_min, ch_max)
    local spawn_min = GetEvent("underground") and ch_min or ((ch_max + ch_min) / 2)
    if spawn_min > ch_max then spawn_min = ch_max end
    return math_random(spawn_min, ch_max) / 2
end

--- Place one spawn band the base-game way (sound_ambient.script:127-165): distance, random bearing, height, and the volume table.
--- Returns the distance, position, and raw table volume, and the caller applies the sliders.
local function get_placement(actor, ch_min, ch_max, height, indoor, fixed_dist)
    local underground = GetEvent("underground")
    local inside = GetEvent("current_safe_cover")
    local dist = fixed_dist or _compute_spawn_dist(ch_min, ch_max)
    local pos = actor:position()
    local angle = math_rad(math_random(0, 359))
    local vec = vector():set(pos.x + math_cos(angle) * dist, pos.y + height, pos.z + math_sin(angle) * dist)
    local vol
    if underground or inside then vol = indoor and 1 or 0.3
    else vol = indoor and 0 or 1 end
    return dist, vec, vol
end

--- Roll the base spawn distance, then pull it up to DREAD_PULL closer by dread; a fixed distance bypasses the pull.
local function _compute_pull_dist(ch_min, ch_max, dread)
    local dist = _compute_spawn_dist(ch_min, ch_max)
    if dread and dread > 0 then dist = dist * (1 - DREAD_PULL * dread) end
    return dist
end

-- derive (board -> eligible set, built on demand)

--- Rebuild the eligible category list and lookup set from the board, called at emission and by the HUD, never on the tick.
local function _build_eligible()
    local position = board.position
    local elig = {}
    for name in pairs(CATEGORY) do
        if is_eligible(name, position) then elig[#elig + 1] = name end
    end
    board.eligible = elig
    board.elig_set = {}
    for i = 1, #elig do board.elig_set[elig[i]] = true end
end

-- emission (jittered self-schedule)

--- Emit one one-shot once the dread-scaled gap has elapsed, tightening as dread rises.
--- The gap advances even while silent, so a resumed dread emits promptly and dread 0 stays silent.
local function try_emit(tg)
    try_visual_pulse(tg)
    if _muted then return end
    local dread = board.dread
    local dread_norm = (dread - DREAD_ON) / (1 - DREAD_ON)
    if dread_norm < 0 then dread_norm = 0 elseif dread_norm > 1 then dread_norm = 1 end
    dread_norm = dread_norm ^ SPACE_EASE
    local gap = (SPACE_CALM_MS + (SPACE_PEAK_MS - SPACE_CALM_MS) * dread_norm) * _jitter * math_max(rarity, 0.1)
    if tg - _gap_at < gap then return end
    _gap_at = tg
    _jitter = 1 + (math_random() * 2 - 1) * SPACE_JITTER
    if dread <= 0 then return end
    _build_eligible()
    local name = _select_category()
    if not name then return end
    local snd = _select_sound(name, _get_dread_bucket(dread))
    if snd then
        play_sound(snd[1], { min = snd[2], max = snd[3], height = snd[4],
                       ch_min = snd[5], ch_max = snd[6], indoor = snd[7], dread = dread })
        _last_play = snd[1]
        _play_at = tg
        as_debug.debug("[PICK] cat=%s snd=%s dread=%.2f", name, snd[1], dread)
    end
end

-- Base ambient observer: a faithful clone of the base update_ambient slot that replays through xsound.play and logs each base fire; last writer wins the slot.
local function _read_base_channel(ch, ini_snd)
    local raw = xltx.read_list(ini_snd, ch, "sounds")
    if not raw or #raw == 0 then return nil end
    return { name = ch, sounds = raw,
        max_dist = xltx.read_num(ini_snd, ch, "max_distance") or 100,
        min_dist = xltx.read_num(ini_snd, ch, "min_distance") or 1,
        height   = xltx.read_num(ini_snd, ch, "height") or 0,
        indoor   = xltx.read_bool(ini_snd, ch, "indoor") or false,
        periods  = { xltx.read_num(ini_snd, ch, "period0") or 10, xltx.read_num(ini_snd, ch, "period1") or 15,
                     xltx.read_num(ini_snd, ch, "period2") or 20, xltx.read_num(ini_snd, ch, "period3") or 25 } }
end

local function reset_base(level_name, ambient)
    _base.chan, _base.idx, _base.tot = {}, 0, 0
    if not (level_name and ambient and ambient ~= "") then return end
    local ini_lvl = xltx.resolve_handle("environment\\ambients\\" .. level_name .. ".ltx")
    if not ini_lvl then return end
    local channels = xltx.read_list(ini_lvl, ambient, "sound_channels_dynamic")
    if #channels == 0 then return end
    local cached, ini_snd = {}, xltx.resolve_handle(CHANNELS_FILE)
    for i = 1, #channels do
        local ch = channels[i]
        local entry = (not cached[ch]) and xltx.has(ini_snd, ch) and _read_base_channel(ch, ini_snd)
        cached[ch] = true
        if not entry then goto continue end
        _base.tot = _base.tot + 1
        _base.chan[_base.tot] = entry
        ::continue::
    end
end

local function play_base_channel(ch, tg)
    local actor = db.actor
    if not actor then return end
    local period = ch.periods[math_random(4)]
    ch.next = tg + period
    if _muted then return end
    local file = ch.sounds[math_random(#ch.sounds)]
    _base_last, _base_at = tostring(file), tg
    local dist, vec, vol = get_placement(actor, ch.min_dist, ch.max_dist, ch.height, ch.indoor)
    vol = vol * opt_ambient_volume
    xsound.play(file, { position = vec, volume = vol })
    if as_debug.is_on() then
        as_debug.debug("[BASE] lvl=%s ch=%s file=%s dist=%.1f vol=%.2f", level.name(), ch.name, tostring(file), dist, vol)
    end
end

local function update_base_ambient()
    ResetTimeEvent("sound_channels", "update_ambient", BASE_TICK_S)
    if not (level.present() and db.actor) then return false end
    local tg = time_global()
    local hour = level.get_time_hours()
    if hour ~= _base.hour then
        _base.hour, _base.idx = hour, 0
        local wm = level_weathers and level_weathers.get_weather_manager()
        reset_base(level.name(), wm and wm:get_curr_ambient())
    elseif _base.tot > 0 then
        _base.idx = _base.idx + 1
        if _base.idx > _base.tot then _base.idx = 1 end
        local ch = _base.chan[_base.idx]
        if not ch.next then ch.next = tg + math_random(1, ch.periods[math_random(4)] + 1)
        elseif ch.next <= tg then play_base_channel(ch, tg) end
    end
    return false
end

local function register_base_observer()
    _base.hour, _base.idx = nil, 0
    RemoveTimeEvent("sound_channels", "update_ambient")
    CreateTimeEvent("sound_channels", "update_ambient", 1, update_base_ambient)
end

-- director loop (one tick, round-robin one producer per tick)

-- Director loop: one producer runs per tick, so per-tick cost is the single heaviest scan; the board fills over all producers in about 0.6s.
local _last_pos_name = nil
local function update_position(actor)
    local position = _find_position(actor)
    local name = position and position.name
    if name ~= _last_pos_name then
        _last_pos_name = name
        as_debug.debug("[OVERRIDE] %s", name and ("in " .. name .. " dread=" .. tostring(position.dread)) or "cleared")
    end
    board.position = position
end

local _producers = {
    { "stalkers",    function(actor) board.stalkers = _collect_stalkers(actor) end },
    { "monsters",    function(actor) board.monsters = _collect_monsters(actor) end },
    { "environment", function(actor) board.environment = _read_environment(actor) end },
    { "anomalies",   function(actor) board.anomalies.near = _read_anomalies(actor) end },
    { "position",    update_position },
    { "time",        function()      if level.present() then board.time = _get_time_band(level.get_time_hours()) end end },
}

local function _on_tick()
    ResetTimeEvent("as_director", "tick", TICK_S)
    if not (level.present() and db.actor) then return false end
    local tg = time_global()
    local dbg = as_debug.is_on()
    local entry = _producers[_cursor]
    local tmr = xprofiler.new_if(dbg):start()
    entry[2](db.actor)
    tmr:stop()
    _cursor = _cursor % #_producers + 1
    _compute_dread()
    if dbg then _build_eligible(); as_debug.debug("[SCAN %s %.2fms] dread=%.2f elig=%d", entry[1], tmr:get_ms(), board.dread, #board.eligible) end
    try_emit(tg)
    return false
end

-- lifecycle

local function update_config()
    rarity             = as_mcm.get_config("rarity") or 1
    vol_global         = as_mcm.get_config("vol_global") or 1
    opt_ambient_volume = (ui_options and ui_options.get("sound/environment/ambient_volume")) or 1
    local wanted = as_mcm.get_config("visuals")
    visuals_on = (wanted == nil) or wanted
end

--- Load banks, arm the ticks. Runs on every actor_on_first_update, so a save load re-arms the timers.
--- Inert without xlibs (xsound). The veto still holds - it is the static DLTX overlay.
local function _on_first_update()
    update_config()
    if not xsound then as_debug.warn("as_director: xlibs (xsound) absent - director inert"); return end
    _load_channels()
    _load_map(level.name())
    _gap_at, _jitter, _cursor = 0, 1, 1
    _map_level, _cat_bag, _snd_bag = nil, {}, {}
    _visual.insane_since, _visual.next_ok, _visual.handle = nil, 0, nil
    register_base_observer()
    RemoveTimeEvent("as_director", "tick")
    CreateTimeEvent("as_director", "tick", TICK_S, _on_tick)
    as_debug.info("as_director: armed - sensor-board director on tick; base observer on update_ambient; source-band placement")
end

--- Fire one positioned one-shot at path, pulling the rolled spawn distance closer by dread and placing it via get_placement.
--- Returns the distance; the volume is the base table times the sliders and opts.min/max is the attenuation readout only.
function play_sound(path, opts)
    local actor = db.actor
    if not (actor and path and xsound) then return end
    local height = opts.height or 0
    local place_dist = opts.dist or _compute_pull_dist(opts.ch_min, opts.ch_max, opts.dread)
    local dist, vec, vol = get_placement(actor, opts.ch_min, opts.ch_max, height, opts.indoor, place_dist)
    vol = vol * opt_ambient_volume * vol_global
    xsound.play_at(path, { position = vec, volume = vol })
    local mn, mx = opts.min, opts.max
    local d3d = math_sqrt(dist * dist + height * height)
    local att = (mn and mx and mx > mn) and (mx - d3d) / (mx - mn) or 0
    if att < 0 then att = 0 elseif att > 1 then att = 1 end
    as_debug.debug("[PLAY] %s dist=%.1f band=%.0f-%.0f h=%.0f att=%.2f vol=%.2f dread=%.2f",
        path, dist, opts.ch_min or 0, opts.ch_max or 0, height, att, vol, opts.dread or 0)
    return dist
end

-- visual layer

--- Fire one subtle distortion pulse: create a cyclic effector, drive its factor up, release after a hold.
function play_visual_pulse()
    if not xpp then return end
    local ppe = VIS_PPE[math_random(#VIS_PPE)]
    if _visual.handle and xpp.is_active(_visual.handle) then xpp.release(_visual.handle) end
    local handle = xpp.create_effector(ppe, { cyclic = true, smoothing = VIS_SMOOTH })
    _visual.handle = handle
    if handle then
        xpp.set_target(handle, VIS_FACTOR, VIS_SMOOTH)
        CreateTimeEvent("as_director", "vis_release", VIS_HOLD_S, function()
            if xpp.is_active(handle) then xpp.release(handle) end
            if _visual.handle == handle then _visual.handle = nil end
            return true
        end)
    end
end

--- Peak-dread visual gate: require sustained peak (dwell), then once per cooldown roll to pulse.
function try_visual_pulse(tg)
    if not (visuals_on and xpp) or board.dread < INSANE_DREAD then
        _visual.insane_since = nil
        return
    end
    if not _visual.insane_since then _visual.insane_since = tg; return end
    if tg < _visual.next_ok or tg - _visual.insane_since < VIS_DWELL_MS then return end
    _visual.next_ok = tg + VIS_COOLDOWN_MS
    if math_random() < VIS_CHANCE then play_visual_pulse() end
end

--- Build the debug HUD rows (PLAYING / SELECT / SENSORS) from the board.
function _build_hud()
    _build_eligible()
    local playing = _play_at > 0 and (time_global() - _play_at) < PLAY_WINDOW_MS
    local base_playing = _base_at > 0 and (time_global() - _base_at) < PLAY_WINDOW_MS
    local dread = board.dread
    local grade = (dread >= INSANE_DREAD) and "g_insane" or (dread >= DREAD_ON) and "g_med" or "g_none"
    local stalkers, monsters = board.stalkers, board.monsters
    _rows = {
        { "PLAYING", "", "", "hdr" },
        { "spook", _last_play, "", playing and "play" or "stop" },
        { "base", _base_last, "", base_playing and "play" or "stop" },
        { "", "", "" },
        { "SELECT", "", "", "hdr" },
    }
    local avail = build_lines(board.eligible, TYPE_WRAP)
    if #avail == 0 then avail = { "-" } end
    for i = 1, #avail do _rows[#_rows + 1] = { i == 1 and "available" or "", avail[i], "" } end
    _rows[#_rows + 1] = { "dread", string_format("%.2f", dread), "", grade }
    _rows[#_rows + 1] = { "", "", "" }
    _rows[#_rows + 1] = { "APPLY", "", "", "hdr" }
    local terms = board.terms
    _rows[#_rows + 1] = { "lore",        string_format("%+.2f", terms.lore or 0), "" }
    _rows[#_rows + 1] = { "environment", string_format("%+.2f", terms.env or 0), "" }
    _rows[#_rows + 1] = { "time",        string_format("%+.2f", terms.time or 0), "" }
    _rows[#_rows + 1] = { "threat",      string_format("%+.2f", terms.threat or 0), "" }
    _rows[#_rows + 1] = { "company",     string_format("%+.2f", terms.company or 0), "" }
    _rows[#_rows + 1] = { "anomaly",     string_format("%+.2f", terms.anomaly or 0), "" }
    _rows[#_rows + 1] = { "service",     string_format("%+.2f", terms.service or 0), "" }
    _rows[#_rows + 1] = { "", "", "" }
    _rows[#_rows + 1] = { "OVERRIDE", "", "", "hdr" }
    local override = board.position
    _rows[#_rows + 1] = { "position", override and override.name or "none", "", override and "g_med" or "g_none" }
    _rows[#_rows + 1] = { "dread",  override and override.dread and string_format("%.2f", override.dread) or "-", "" }
    _rows[#_rows + 1] = { "add",    override and string_format("%+.2f", override.add) or "-", "" }
    _rows[#_rows + 1] = { "select", override and override.cats and (override.only and "only" or "add") or "-", "" }
    _rows[#_rows + 1] = { "", "", "" }
    _rows[#_rows + 1] = { "SENSORS", "", "", "hdr" }
    _rows[#_rows + 1] = { "environment", board.environment, "" }
    _rows[#_rows + 1] = { "time", board.time, "" }
    _rows[#_rows + 1] = { "stalkers.online", stalkers.online and "yes" or "no", "" }
    _rows[#_rows + 1] = { "stalkers.enemy_near", stalkers.enemy_near, "" }
    _rows[#_rows + 1] = { "stalkers.ally_near", stalkers.ally_near, "" }
    _rows[#_rows + 1] = { "stalkers.service_near", stalkers.service_near, "" }
    _rows[#_rows + 1] = { "monsters.online", monsters.online and "yes" or "no", "" }
    _rows[#_rows + 1] = { "monsters.enemy_near", monsters.enemy_near, "" }
    _rows[#_rows + 1] = { "anomalies.near", board.anomalies.near and "yes" or "no", "" }
end

--- Build and return the debug HUD rows fresh from the board, so nothing is built on the tick when the HUD is off.
function get_hud_rows()
    _build_hud()
    return _rows
end

--- The live sensor board (read-only): the Player tab's Inspector reads dread + environment for a quick readout.
function get_board()
    return board
end

--- Master silence for the review player: the director and base observer replay nothing while both schedules keep advancing.
function set_muted(value)
    _muted = value and true or false
end

function on_game_start()
    RegisterScriptCallback("actor_on_first_update",      _on_first_update)
    RegisterScriptCallback("on_option_change",           update_config)
    RegisterScriptCallback("mcm_option_restore_default", update_config)
end
