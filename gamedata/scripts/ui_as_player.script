--- ui_as_player: the AlifeSpooks review/curation tool - a keyboard-owning 2D modal that auditions sounds and logs notes.

local table_sort, string_format = table.sort, string.format
local RegisterScriptCallback = RegisterScriptCallback

local SND_ROOT   = "zs"
local PGDN_KEY   = 209

local KIND_DIRECTOR = "director"
local KIND_ATEAR    = "atear"
local KIND_DIST     = "dist"

-- Audition modes: director places a sound as the director would at a dread, atear is raw 2D, dist a fixed 3D range.
local MODES = {
    { label = "as heard now", kind = KIND_DIRECTOR },
    { label = "low dread",    kind = KIND_DIRECTOR, dread = 0.30 },
    { label = "med dread",    kind = KIND_DIRECTOR, dread = 0.55 },
    { label = "high dread",   kind = KIND_DIRECTOR, dread = 0.85 },
    { label = "at-ear (2D)",  kind = KIND_ATEAR },
    { label = "5m",   kind = KIND_DIST, dist = 5 },
    { label = "10m",  kind = KIND_DIST, dist = 10 },
    { label = "25m",  kind = KIND_DIST, dist = 25 },
    { label = "50m",  kind = KIND_DIST, dist = 50 },
    { label = "100m", kind = KIND_DIST, dist = 100 },
}

-- The director's dread distance-pull, mirrored here for the mode label only (as_director DREAD_PULL).
local DREAD_PULL = 0.20

local _cats     = nil
local _files    = {}
local _cat_i    = 1
local _at_root  = true
local _mode_i   = 1
local _cur      = nil
local _box      = nil
-- RemoveAll on the empty, not-yet-attached list (the first fill) CTDs in CUIScrollView::Clear.
local _built    = false

local function _get_category()  return _cats and _cats[_cat_i] end
local function _get_mode()  return MODES[_mode_i] end

local function _read_categories()
    _cats = xfs.read_folders("$game_sounds$", SND_ROOT .. "\\")
    table_sort(_cats)
end

--- Scan a category's oggs (flat: zs\<cat>\<name>.ogg, no dread subdir - dread lives in as_spooks_metadata).
local function _get_files(cat)
    if _files[cat] then return _files[cat] end
    local out = xfs.read_files("$game_sounds$", SND_ROOT .. "\\" .. cat .. "\\", ".ogg")
    table_sort(out)
    _files[cat] = out
    return out
end

--- The _cur record for a browsed sound (flat path zs\<cat>\<name>).
local function _build_record(cat, name)
    return { cat = cat, name = name, path = SND_ROOT .. "\\" .. cat .. "\\" .. name }
end

--- Find the config row whose path matches, within one category's flat sound list.
local function _find_row(rows, path)
    for k = 1, #(rows or {}) do
        if rows[k].path == path then return rows[k] end
    end
end

local function _show_player()
    if _box and _box:IsShown() then return end
    if not (db.actor and as_mcm and as_mcm.get_config and as_mcm.get_config("sound_player")) then return end
    _box = as_player_wnd()
    _box:ShowDialog(true)
    Register_UI("as_player_wnd", "ui_as_player", _box)
end

local function _on_key(key)
    if key == PGDN_KEY then _show_player() end
end

class "as_player_wnd" (CUIScriptWnd)

function as_player_wnd:__init() super()
    self:SetWndRect(Frect():set(0, 0, 1024, 768))
    self:SetAutoDelete(true)
    self:init_controls()
    self:init_callbacks()
    _built = false
    if not _cats then _read_categories() end
    self:build_list()
    self:render()
    if as_director and as_director.set_muted then as_director.set_muted(true) end
end

function as_player_wnd:__finalize()
    if as_director and as_director.set_muted then as_director.set_muted(false) end
end

function as_player_wnd:init_controls()
    local xml = CScriptXmlInit()
    xml:ParseFile("ui_as_player.xml")
    xml:InitStatic("background", self)
    xml:InitStatic("hdr_player", self)
    xml:InitStatic("line_player", self)
    xml:InitStatic("screen", self)
    xml:InitStatic("hdr_verdict", self)
    xml:InitStatic("hdr_snote", self)
    xml:InitStatic("hdr_probe", self)
    xml:InitFrame("list_frame", self)
    self.list = xml:InitListBox("list", self)
    self.list:ShowSelectedItem(true)
    self:Register(self.list, "list")
    self.lbl_path  = xml:InitStatic("lbl_path", self):TextControl()
    self.lbl_now   = xml:InitStatic("lbl_now", self):TextControl()
    self.lbl_pos   = xml:InitStatic("lbl_pos", self):TextControl()
    self.lbl_loud  = xml:InitStatic("lbl_loud", self):TextControl()
    self.status    = xml:InitStatic("status", self):TextControl()
    self.insp_read = xml:InitStatic("insp_read", self):TextControl()
    self.snote = xml:InitEditBox("snote", self); self:Register(self.snote, "snote")
    self.probe = xml:InitEditBox("probe", self); self:Register(self.probe, "probe")
    local function register_button(name) local btn = xml:Init3tButton(name, self); self:Register(btn, name) end
    register_button("btn_pos_down"); register_button("btn_pos_up"); register_button("btn_prior")
    register_button("btn_play"); register_button("btn_stop"); register_button("btn_next")
    register_button("btn_v1"); register_button("btn_v2"); register_button("btn_v3")
    register_button("btn_v4"); register_button("btn_v5")
    register_button("btn_note"); register_button("btn_rescan"); register_button("btn_probe")
end

function as_player_wnd:init_callbacks()
    self:AddCallback("list",        ui_events.LIST_ITEM_CLICKED, self.select_item, self)
    self:AddCallback("btn_pos_down", ui_events.BUTTON_CLICKED,    self.select_prev_mode, self)
    self:AddCallback("btn_pos_up",   ui_events.BUTTON_CLICKED,    self.select_next_mode, self)
    self:AddCallback("btn_prior",    ui_events.BUTTON_CLICKED,    self.select_prev_sound, self)
    self:AddCallback("btn_play",     ui_events.BUTTON_CLICKED,    self.play, self)
    self:AddCallback("btn_stop",     ui_events.BUTTON_CLICKED,    self.stop, self)
    self:AddCallback("btn_next",     ui_events.BUTTON_CLICKED,    self.select_next_sound, self)
    self:AddCallback("btn_v1", ui_events.BUTTON_CLICKED, function() self:add_note("inaudible") end, self)
    self:AddCallback("btn_v2", ui_events.BUTTON_CLICKED, function() self:add_note("faint") end, self)
    self:AddCallback("btn_v3", ui_events.BUTTON_CLICKED, function() self:add_note("loud") end, self)
    self:AddCallback("btn_v4", ui_events.BUTTON_CLICKED, function() self:add_note("unfit") end, self)
    self:AddCallback("btn_v5", ui_events.BUTTON_CLICKED, function() self:add_note("good") end, self)
    self:AddCallback("btn_note",  ui_events.BUTTON_CLICKED, function() self:add_note(nil) end, self)
    self:AddCallback("btn_rescan",  ui_events.BUTTON_CLICKED, self.reload, self)
    self:AddCallback("btn_probe",   ui_events.BUTTON_CLICKED, self.save_probe, self)
end

function as_player_wnd:build_list()
    if xslice then xslice.stop_queue("as_player_fill") end
    if _built then self.list:RemoveAll() end
    _built = true
    if _at_root then
        for i = 1, #(_cats or {}) do self.list:AddTextItem(_cats[i] .. "/") end
    else
        self:_build_category(_get_category())
    end
end

--- Fill one category's sounds: a ".." row then each sound with its duration, frame-spread so no build spikes.
function as_player_wnd:_build_category(cat)
    if not cat then return end
    self.list:AddTextItem("..")
    local files = _get_files(cat)
    local list = self.list
    if not xslice then
        for i = 1, #files do list:AddTextItem(files[i]) end
        return
    end
    xslice.start("as_player_fill", files, { step = 15, func = function(name)
        local ms = (xsound and xsound.length and xsound.length(_build_record(cat, name).path)) or 0
        list:AddTextItem(string_format("%s    %.1fs", name, ms / 1000))
        return true
    end })
end

--- The dread a director mode plays at: its fixed preset, or the LIVE scene dread for the "now" entry.
function as_player_wnd:_get_mode_dread(mode)
    if mode.dread then return mode.dread end
    local board = as_director and as_director.get_board and as_director.get_board()
    return board and board.dread or 0
end

--- The audition mode label. A director mode appends the dread it plays at and the resulting pull.
function as_player_wnd:_get_mode_label()
    local mode = _get_mode()
    if mode.kind ~= KIND_DIRECTOR then return mode.label end
    local dread = self:_get_mode_dread(mode)
    return string_format("%s (dread %.2f, ~%.0f%% closer)", mode.label, dread, DREAD_PULL * dread * 100)
end

function as_player_wnd:render()
    local cat = _get_category()
    if _at_root then
        self.lbl_path:SetText(string_format("sounds/    (%d categories)", _cats and #_cats or 0))
        self.status:SetText("click a category to browse it")
    else
        self.lbl_path:SetText(string_format("sounds/%s/    (%d)", cat or "?", cat and #_get_files(cat) or 0))
        self.status:SetText("click a sound to play    -    click a premade note, or type + add note")
    end
    self.lbl_now:SetText(_cur and ("loaded:  " .. _cur.cat .. "/" .. _cur.name)
        or "loaded:  (none - click a sound)")
    self.lbl_pos:SetText("mode:  " .. self:_get_mode_label())
    if self.lbl_loud then self.lbl_loud:SetText(self:format_loud()) end
    if self.insp_read then self.insp_read:SetText(self:_format_spot()) end
end

function as_player_wnd:_format_spot()
    local actor = db.actor
    if not actor then return "no actor" end
    local pos = actor:position()
    local board = as_director and as_director.get_board and as_director.get_board()
    return string_format("%s    dread %.2f    env %s    pos %.0f %.0f %.0f",
        level.name(), board and board.dread or 0, board and board.environment or "?", pos.x, pos.y, pos.z)
end

--- The loudness line: measured LUFS and base_volume from the profile, plus the delivered dB at the audition distance.
--- Reads xsound.get_meta + compute_delivered_loudness; a director mode reads at the blob mid-range, a fixed mode at its distance.
function as_player_wnd:format_loud()
    if not _cur then return "loud:   (none)" end
    local prof = xsound and xsound.get_meta and xsound.get_meta(_cur.path)
    if not prof then return "loud:   -- (no profile; run build.py deploy)" end
    local mode = _get_mode()
    local dist
    if mode.kind == KIND_DIST then
        dist = mode.dist
    elseif mode.kind == KIND_DIRECTOR and prof.mx then
        dist = prof.mx / 2.0
    end
    local eff = xsound.compute_delivered_loudness(prof, dist)
    if not eff then return string_format("loud:   bv %.2f | LUFS --", prof.bv or 1.0) end
    return string_format("loud:   %.1f LUFS | bv %.2f | est. %.0f dB", prof.lufs, prof.bv or 1.0, eff)
end

--- Director placement at the given dread: the sound placed exactly as the director would, including the pull.
function as_player_wnd:_play_director(dread)
    local cats = as_sound_metadata and as_sound_metadata.categories and as_sound_metadata.categories[_cur.cat]
    local row = _find_row(cats, _cur.path) or {}
    as_director.play_sound(_cur.path, { min = row.mn or 2, max = row.mx or 100, height = row.h or 0,
        ch_min = row.ch_min or 30, ch_max = row.ch_max or 100, indoor = row.indoor or false, dread = dread or 0 })
end

function as_player_wnd:_play_current()
    if not (_cur and xsound) then return end
    local mode = _get_mode()
    if mode.kind == KIND_ATEAR then
        xsound.play_at(_cur.path, { s2d = true, volume = 1.0 })
    elseif mode.kind == KIND_DIST then
        as_director.play_sound(_cur.path, { dist = mode.dist })
    else
        self:_play_director(self:_get_mode_dread(mode))
    end
end

function as_player_wnd:select_item()
    local idx = self.list:GetSelectedIndex()
    if not idx or idx < 0 then return end
    if _at_root then
        if not (_cats and _cats[idx + 1]) then return end
        _cat_i, _at_root = idx + 1, false
        self:build_list(); self:render()
        return
    end
    if idx == 0 then
        _at_root = true
        self:build_list(); self:render()
        return
    end
    local cat = _get_category()
    local name = cat and _get_files(cat)[idx]
    if not name then return end
    _cur = _build_record(cat, name)
    self:_play_current()
    self:render()
    self.status:SetText(string_format("playing:  %s\\%s", cat, name))
end

function as_player_wnd:play() self:_play_current() end

function as_player_wnd:stop()
    if xsound then xsound.stop_shots() end
    self.status:SetText("stopped")
end

--- Mode steppers cycle the audition mode ONLY (they never play - Play/click is the one trigger).
function as_player_wnd:select_prev_mode()
    _mode_i = _mode_i - 1
    if _mode_i < 1 then _mode_i = #MODES end
    self:render()
end
function as_player_wnd:select_next_mode()
    _mode_i = _mode_i % #MODES + 1
    self:render()
end

--- Step the selection to a neighbouring sound, move only (silent) - Prev/Next never play; Play/click do.
function as_player_wnd:_select_neighbor(delta)
    if _at_root then return end
    local cat = _get_category()
    local files = cat and _get_files(cat)
    if not (files and #files > 0) then return end
    local i = 1
    if _cur and _cur.cat == cat then
        for k = 1, #files do if files[k] == _cur.name then i = k; break end end
    end
    i = (i - 1 + delta) % #files + 1
    _cur = _build_record(cat, files[i])
    self.list:SetSelectedIndex(i)
    self:render()
end

function as_player_wnd:select_prev_sound() self:_select_neighbor(-1) end
function as_player_wnd:select_next_sound()  self:_select_neighbor(1) end

--- Write a sound note for the current sound; a premade button passes preset text, the add-note button the typed field.
--- A preset and a typed note combine; adding a note clears the field and never advances or plays.
function as_player_wnd:add_note(premade)
    if not _cur then return end
    local custom = self.snote:GetText()
    local text
    if premade and custom and custom ~= "" then text = premade .. " :: " .. custom
    elseif premade then text = premade
    else text = custom end
    if not text or text == "" then return end
    if as_test and as_test.note_sound then as_test.note_sound(_cur.path, text) end
    self.snote:SetText("")
    self.status:SetText(string_format("NOTE %s :: %s", _cur.name, text))
end

--- Save the PROBE NOTE: a [PROBE] block (free text + the full ordered sensor dump) to the notes file.
function as_player_wnd:save_probe()
    local text = self.probe:GetText()
    local ok = as_test and as_test.note_probe and as_test.note_probe(text)
    self.probe:SetText("")
    self.status:SetText(ok and "probe note saved -> alifespooks_notes.txt" or "probe note FAILED (no actor/level?)")
end

function as_player_wnd:reload()
    _cats, _files = nil, {}
    _read_categories()
    if _cat_i > #_cats then _cat_i = 1 end
    self:build_list(); self:render()
end

--- The window owns the keyboard only so the text fields capture typing; there are NO command shortcuts.
--- Esc closes the window when no edit box has focus.
function as_player_wnd:OnKeyboard(dik, action)
    local res = CUIScriptWnd.OnKeyboard(self, dik, action)
    if action == ui_events.WINDOW_KEY_PRESSED and not res and dik == DIK_keys.DIK_ESCAPE then
        self:hide(); return true
    end
    return res
end

function as_player_wnd:hide()
    if xslice then xslice.stop_queue("as_player_fill") end
    if xsound then xsound.stop_shots() end
    self:HideDialog()
    Unregister_UI("as_player_wnd")
end

function on_game_start()
    RegisterScriptCallback("on_key_press", _on_key)
end
